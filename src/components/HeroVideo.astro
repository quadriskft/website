---
// Valódi, felvett platós felépítmény videó. Lejátszás közben a látható alkatrészekhez
// a katalógus termékei ugranak fel (kép + név), kattintásra a termékoldalra visznek.
import { getProduct } from '../lib/catalog.js';

// [kezdés mp, vége mp, termék slug, felirat a termék neve fölött]
const CUES = [
  [0.4, 2.1, '231725-belga-h-szego-25-mm-elox', 'Oldalfal szegők'],
  [2.2, 4.6, '303005-alafutasgatlo-konzol-700-mm-uj', 'Aláfutásgátló'],
  [4.8, 7.5, '351190-alu-rakonca-magasito-elox-1900-mm', 'Rakoncák'],
  [7.6, 8.9, 'j205010-daken-lada-410x330x340-mm', 'Szerszámosláda'],
  [9.0, 10.1, 'j101030-negyed-ives-sarvedo-700x650', 'Sárvédők'],
  [10.1, 11.1, '152811-tir-zsaner-garnitura-horg', 'Zsanérok & zárak'],
];
const cues = CUES.map(([start, end, slug, label]) => {
  const p = getProduct(slug);
  return p ? { start, end, label, name: p.name, image: p.images?.[0], href: `/termek/${p.slug}` } : null;
}).filter(Boolean);
---
<div class="hv">
  <video class="hv-video" src="/video/quadris-platos.mp4" poster="/video/quadris-platos-poster.jpg" autoplay muted loop playsinline preload="auto" aria-label="Platós felépítmény a valóságban, felugró termékekkel"></video>
  <div class="hv-shade" aria-hidden="true"></div>
  {cues.map((c, i) => (
    <a class="hv-cue" href={c.href} data-start={c.start} data-end={c.end} style={`--i:${i}`}>
      {c.image && <img src={c.image} alt="" loading="lazy" />}
      <span>
        <small>{c.label}</small>
        <strong>{c.name}</strong>
      </span>
    </a>
  ))}
  <div class="hv-end" data-start="11.3" data-end="14.4">
    <img src="/brand/quadris-logo-feher.svg" alt="Quadris" />
    <p>Minden alkatrész a felépítményhez – egy helyről.</p>
  </div>
  <button class="hv-toggle" type="button" aria-label="Videó megállítása">
    <svg class="i-pause" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
    <svg class="i-play" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
  </button>
</div>

<script>
  document.querySelectorAll('.hv').forEach((root) => {
    const video = root.querySelector('video');
    const items = [...root.querySelectorAll('[data-start]')].map((el) => ({ el, a: Number(el.dataset.start), b: Number(el.dataset.end) }));
    const toggle = root.querySelector('.hv-toggle');
    const tick = () => {
      const t = video.currentTime;
      for (const it of items) it.el.classList.toggle('show', t >= it.a && t < it.b);
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
    toggle.addEventListener('click', () => {
      if (video.paused) video.play();
      else video.pause();
    });
    video.addEventListener('play', () => root.classList.remove('paused'));
    video.addEventListener('pause', () => root.classList.add('paused'));
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) video.pause();
  });
</script>

<style>
  .hv {
    position: relative; aspect-ratio: 9 / 16; width: 100%; max-height: min(78vh, 760px); margin-left: auto;
    border-radius: 28px; overflow: hidden; background: #0b1f3a;
    box-shadow: 0 40px 80px -40px rgba(11, 31, 58, 0.55), 0 0 0 1px rgba(11, 31, 58, 0.06);
  }
  .hv-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hv-shade { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(11, 31, 58, 0.55)); pointer-events: none; }
  .hv-cue {
    position: absolute; left: 16px; right: 16px; bottom: 18px; display: flex; align-items: center; gap: 12px;
    padding: 10px 14px 10px 10px; border-radius: 18px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(8px);
    color: var(--text); text-decoration: none !important; box-shadow: 0 16px 30px -16px rgba(0, 0, 0, 0.5);
    opacity: 0; transform: translateY(14px) scale(0.98); transition: opacity 0.35s ease, transform 0.35s ease; pointer-events: none;
  }
  .hv-cue.show { opacity: 1; transform: none; pointer-events: auto; }
  .hv-cue img { width: 64px; height: 64px; object-fit: contain; border-radius: 12px; background: #fff; border: 1px solid var(--line); flex: none; }
  .hv-cue span { display: flex; flex-direction: column; min-width: 0; }
  .hv-cue small { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
  .hv-cue strong { font-size: 0.95rem; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .hv-end {
    position: absolute; inset: auto 0 0 0; padding: 26px 22px 28px; text-align: center; color: #fff;
    background: linear-gradient(180deg, transparent, rgba(11, 31, 58, 0.85) 40%);
    opacity: 0; transition: opacity 0.5s ease;
  }
  .hv-end.show { opacity: 1; }
  .hv-end img { height: 84px; width: auto; margin: 0 auto 8px; }
  .hv-end p { margin: 0; font-weight: 600; }
  .hv-toggle {
    position: absolute; top: 14px; right: 14px; width: 38px; height: 38px; border-radius: 50%; border: 0; cursor: pointer;
    background: rgba(11, 31, 58, 0.5); color: #fff; display: grid; place-items: center; backdrop-filter: blur(6px);
  }
  .hv-toggle .i-play { display: none; }
  .hv.paused .hv-toggle .i-play { display: block; }
  .hv.paused .hv-toggle .i-pause { display: none; }
</style>
