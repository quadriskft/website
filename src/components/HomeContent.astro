---
import Icon from './Icon.astro';
import { groups, stats, roundedCount, groupImage, GROUP_META } from '../lib/catalog.js';

// A főoldal tartalma. hero: 'split' (szöveg + videó egymás mellett) vagy 'video' (teljes szélességű, sötétített videó, rajta a szöveg)
const { hero = 'split' } = Astro.props;

// Rövid, egysoros összefoglaló a főoldali termékcsoport-kártyákra
const SHORT = {
  'acel-es-alu-rakoncak-es-szegok': 'Első, köztes és hátsó rakoncák.',
  'acel-profilok': 'Hossztartók, keretek, oldalfalak.',
  'aluminium-alvaz-profilok': 'Tartók, keretek, aláfutásgátlók.',
  'aluminium-lemezek': 'Sima, mintás és festett lemezek.',
  'aluminium-padlo-profilok': 'Padló- és rámpaprofilok.',
  'billencs-alkatreszek': 'Munkahengerek, bölcsők, vezérlés.',
  'csuszasmentes-retegelt-padlo': 'Rétegelt padló- és fallemezek.',
  'dobozos-felepitmeny-alkatreszek': 'Zsanérok, zárak, tömítések.',
  'elhuzhato-roloponyvas-rendszer': 'Elhúzható tető- és oldalponyvák.',
  'gumiszonyegek': 'Istálló- és rámpaszőnyegek.',
  'hatso-ajtok-es-athajto-rampak': 'Hátsó ajtók és rámpák.',
  'ipari-felgyartmanyok': 'Zártszelvények, csövek, rudak.',
  'italszallito-kit': 'Készlet italszállítókhoz.',
  'kedergumik': 'Élvédő, tömítő, kéderprofilok.',
  'platos-alkatreszek-es-kiegeszitok': 'Konzolok, zsanérok, zárak.',
  'ponyvarendszer-kiegeszitok': 'Ponyvacsövek, tartók, feszítők.',
  'ponyvas-oldalfal-profilok-es-szegok': 'Oldalfal-profilok és szegők.',
  'rakomanyrogzites': 'Sínek, rudak, hevederek.',
  'sarvedok-szerszamosladak': 'Sárvédők, ládák, tartályok.',
  'specialis-felepitmeny-alkatreszek': 'Speciális zárak és szerelvények.',
  'szellozes-tetoablakok-vilagitas': 'Szellőzők, tetőablakok, lámpák.',
  'uvegszalas-polieszter': 'GFK lemezek és panelek.',
  'zart-dobozos-es-hutos-profilok': 'Dobozos és hűtős profilok.',
};

---
  {hero === 'video' ? (
  <section class="vhero">
    <video class="vhero-video" src="/video/quadris-iveco-hero.mp4" poster="/video/quadris-iveco-poster.jpg" autoplay muted loop playsinline preload="auto" data-hero-video
      width="960" height="960" aria-hidden="true"></video>
    <div class="vhero-shade" aria-hidden="true"></div>
    <div class="container vhero-inner">
      <div class="vhero-copy" lang="hu">
        <span class="eyebrow">Alkatrész-beszállító felépítménygyártóknak</span>
        <h1>Minden alkatrész a&nbsp;felépítményhez <span class="vh-accent">– egy helyről.</span></h1>
        <p class="lead">
          Alváz- és padlóprofilok, ponyvarendszerek, zárak, zsanérok, sárvédők és rakományrögzítés
          jármű- és lószállító felépítmény gyártóknak. Állítsa össze a listáját, és elkészítjük az ajánlatát.
        </p>
      </div>
    </div>
  </section>
  ) : (
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
      <span class="eyebrow">Alkatrész-beszállító felépítménygyártóknak</span>
      <h1>Minden alkatrész a felépítményhez – <span class="gradient-text">egy helyről.</span></h1>
      <p class="lead">
        Alváz- és padlóprofilok, ponyvarendszerek, zárak, zsanérok, sárvédők és rakományrögzítés
        jármű- és lószállító felépítmény gyártóknak. Állítsa össze a listáját, és elkészítjük az ajánlatát.
      </p>
      </div>
      <div class="hero-video metal-frame">
        <video src="/video/quadris-iveco-hero.mp4" poster="/video/quadris-iveco-poster.jpg" autoplay muted loop playsinline preload="auto" data-hero-video
          width="960" height="960" aria-label="Quadris raktár: alumínium és acél profilok, beálló platós tehergépkocsi"></video>
      </div>
    </div>
  </section>
  )}

  <section class="segments-section">
    <div class="container segments">
      <a href="/termekek" class="card segment">
                <div>
          <h2>Járműfelépítmény-gyártóknak</h2>
          <p class="muted">Platós, ponyvás, dobozos, hűtős és billencs felépítmények teljes alkatrész-kínálata – profiloktól a zárakig.</p>
          <span class="link-arrow">Teljes katalógus <Icon name="ArrowRight" size={16} /></span>
        </div>
      </a>
      <a href="/loszallito-felepitmenyek" class="card segment horse">
                <div>
          <h2>Lószállító felépítmény gyártóknak</h2>
          <p class="muted">Istálló- és rámpaszőnyegek, rámpaprofilok, csúszásmentes padlók, zárak és zsanérok – válogatva a lószállítók igényeire.</p>
          <span class="link-arrow">Lószállító kínálat <Icon name="ArrowRight" size={16} /></span>
        </div>
      </a>
    </div>
  </section>


  <section class="section groups-section band" id="termekcsoportok">
    <div class="band-sheen" aria-hidden="true"></div>
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Termékkatalógus</span>
        </div>
        <a href="/termekek" class="btn btn-ghost">Összes termék <Icon name="ArrowRight" /></a>
      </div>
      <div class="grid grid-groups">
        {groups.map((g) => (
          <a href={`/termekek/${g.slug}`} class="card group-card">
            <div class="group-media">
              {groupImage(g.slug) ? <img src={groupImage(g.slug)} alt="" loading="lazy" width="800" height="560" />
                : <span class="media-empty"><Icon name={GROUP_META[g.slug]?.icon ?? 'Package'} size={44} /></span>}
            </div>
            <h3>{g.name}</h3>
            <p class="muted">{SHORT[g.slug] ?? ''}</p>
            <span class="group-count">{g.count} termék <Icon name="ArrowRight" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section steps-section">
    <div class="container">
      <span class="eyebrow">Így működik</span>
      <h2>Ajánlat három lépésben</h2>
      <ol class="steps">
        <li class="card">
          <span class="step-no">01</span>
          <Icon name="Search" size={22} />
          <h3>Válogasson</h3>
          <p class="muted">Keressen név vagy cikkszám alapján, vagy böngésszen a termékcsoportok között.</p>
        </li>
        <li class="card">
          <span class="step-no">02</span>
          <Icon name="ClipboardList" size={22} />
          <h3>Tegye az ajánlatkérőbe</h3>
          <p class="muted">Adja meg a mennyiségeket. Ha valamit nem talál, egyedi tételként is felveheti.</p>
        </li>
        <li class="card">
          <span class="step-no">03</span>
          <Icon name="Send" size={22} />
          <h3>Küldje el</h3>
          <p class="muted">Egy kattintással elküldi a listát, kollégáink pedig személyre szabott ajánlattal jelentkeznek.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section why-section band">
    <div class="container why">
      <div>
        <span class="eyebrow">Miért a Quadris?</span>
        <h2>Egy partner a teljes felépítményhez</h2>
        <p class="lead">Nem kell tucatnyi gyártóval külön tárgyalnia: összegyűjtjük, egyeztetjük és egyben szállítjuk, amire a gyártósorának szüksége van.</p>
      </div>
      <ul class="benefits">
        <li><Icon name="Boxes" size={22} /><div><h3>Széles választék</h3><p class="muted">{roundedCount(stats.products)} termék {roundedCount(stats.suppliers, 25)} gyártótól, egyetlen kapcsolattartóval.</p></div></li>
        <li><Icon name="Handshake" size={22} /><div><h3>Szakmai tanácsadás</h3><p class="muted">Segítünk kiválasztani a megfelelő profilt, zárat vagy rendszert az adott felépítményhez.</p></div></li>
        <li><Icon name="Timer" size={22} /><div><h3>Gyors ajánlat</h3><p class="muted">Online összeállított lista, gyors és átlátható árajánlat.</p></div></li>
        <li><Icon name="Sparkles" size={22} /><div><h3>Egyedi igények</h3><p class="muted">Nem szerepel a katalógusban? Írja meg, és beszerezzük.</p></div></li>
      </ul>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <div class="cta-band">
        <div>
          <h2>Nem találja, amit keres?</h2>
          <p class="muted">Vegye fel egyedi tételként az ajánlatkérőbe – írja le, mire van szüksége, és megkeressük.</p>
        </div>
        <a href="/ajanlatkeres#egyedi" class="btn btn-primary">Egyedi tétel kérése <Icon name="ArrowRight" /></a>
      </div>
    </div>
  </section>



<script>
  // mozgáscsökkentésnél a videó áll, a poszterkép látszik
  const hv = document.querySelector('[data-hero-video]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (hv && reduced) { hv.removeAttribute('autoplay'); hv.pause(); }
</script>

<style>
  .hero { position: relative; overflow: hidden; padding: 32px 0 28px; }
  .hero > .container { position: relative; z-index: 1; }
  .hero::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--metal); }
  /* váltakozó sávok: világos hűvösszürke háttér, fent-lent vékony fémes él */
  .band { position: relative; overflow: hidden; background: linear-gradient(180deg, #f3f5f7 0%, #eceff2 100%); }
  .band::before, .band::after { content: ''; position: absolute; left: 0; right: 0; height: 2px; background: var(--metal); z-index: 1; }
  .band::before { top: 0; }
  .band::after { bottom: 0; }
  .band > .container { position: relative; z-index: 1; }
  /* fémes fényvisszaverődés a termékkategóriák mögött, 12 mp-enként */
  .band-sheen {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(105deg, rgba(255, 255, 255, 0) 38%, rgba(255, 255, 255, 0.9) 48%, rgba(214, 221, 229, 0.6) 52%, rgba(255, 255, 255, 0) 62%) no-repeat;
    background-size: 260% 100%; background-position: 110% 0;
    animation: sheen 12s ease-in-out infinite;
  }
  .hero-bg {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(900px 420px at 50% 0%, #ffffff 0%, rgba(255, 255, 255, 0) 70%),
      linear-gradient(180deg, #f7f8fa 0%, #eceff3 100%);
  }
  /* fémes fényvisszaverődés: lágy átlós fénysáv, lassan végigfut, aztán pihen */
  .hero-bg::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(105deg, rgba(255, 255, 255, 0) 38%, rgba(255, 255, 255, 0.85) 48%, rgba(222, 228, 235, 0.55) 52%, rgba(255, 255, 255, 0) 62%) no-repeat;
    background-size: 260% 100%; background-position: 110% 0;
    animation: sheen 16s ease-in-out infinite;
  }
  @keyframes sheen { 0% { background-position: 110% 0; } 55%, 100% { background-position: -10% 0; } }
  .hero-inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); gap: 48px; align-items: center; max-width: 1180px; }
  .hero-copy h1 { margin: 10px 0 14px; color: var(--navy); font-size: clamp(1.9rem, 3.4vw, 2.7rem); }
  .hero-copy .lead { font-size: 1.02rem; }
  .hero-search {
    display: flex; align-items: center; gap: 10px; margin: 20px 0 10px; padding: 5px 5px 5px 16px; width: 100%; max-width: 520px;
    border-radius: 999px;
  }
  .hero-search:focus-within { box-shadow: 0 0 0 4px rgba(10, 108, 255, 0.14); }
  .hero-search > :global(svg) { color: var(--muted); flex: none; }
  .hero-search input { flex: 1; min-width: 0; border: 0; background: transparent; height: 44px; font-size: 1rem; outline: none; }
  .hero-popular { display: flex; flex-wrap: wrap; gap: 8px 12px; font-size: 0.88rem; }
  .hero-popular a { color: var(--text-2); border-bottom: 1px dashed var(--line-strong); text-decoration: none; }
  .hero-popular a:hover { color: var(--accent); border-color: var(--accent); }
  .hero-video { width: 100%; max-width: 500px; justify-self: end; padding: 0; border-radius: 24px; overflow: hidden; }
  .hero-video video { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 55%; border-radius: 22px; background: #e9ecef; }

  .segments-section { padding: 28px 0; }
  .segments { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .segment { display: flex !important; align-items: center; gap: 16px; padding: 16px 20px; overflow: hidden; }
  .segment h2 { font-size: 1.08rem; margin: 0 0 2px; }
  .segment p { font-size: 0.86rem; line-height: 1.45; margin: 0 0 4px; }
  .segment .link-arrow { font-size: 0.86rem; }
  .link-arrow { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); font-weight: 600; }

  .groups-section { padding: 28px 0 40px; }
  .section-head { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 20px; flex-wrap: wrap; }
  .section-head h2 { margin: 10px 0 0; }
  .grid-groups { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 18px; }
  .group-card { padding: 0 16px 14px; display: flex !important; flex-direction: column; overflow: hidden; }
  .group-media { position: relative; margin: 0 -16px 12px; aspect-ratio: 10 / 7; background: #fff; border-bottom: 1px solid var(--line); overflow: hidden; }
  .group-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .group-card:hover .group-media img { transform: scale(1.05); }
  .media-empty { display: grid; place-items: center; width: 100%; height: 100%; color: var(--line-strong); background: linear-gradient(135deg, #fbfcfd, #eef1f4); }
  .group-card h3 { font-size: 0.98rem; margin-bottom: 4px; }
  .group-card p { font-size: 0.84rem; line-height: 1.45; margin: 0 0 10px; flex: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .group-count { display: inline-flex; align-items: center; gap: 6px; font-size: 0.86rem; font-weight: 600; color: var(--accent); }

  .steps-section { padding: 30px 0; }
  .steps-section h2 { font-size: clamp(1.3rem, 2.2vw, 1.6rem); margin: 6px 0 0; }
  .why-section { padding: 44px 0; }
  .cta-section { padding: 0 0 8px; }

  .steps { list-style: none; padding: 0; margin: 16px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .steps li { display: grid; grid-template-columns: auto 1fr; gap: 2px 12px; align-items: start; padding: 14px 18px; }
  .steps li > :global(svg) { grid-row: span 2; color: var(--accent); margin-top: 2px; }
  .steps h3 { font-size: 1rem; margin: 0; padding-right: 36px; }
  .steps p { grid-column: 2; font-size: 0.86rem; line-height: 1.45; margin: 0; }
  .step-no { position: absolute; right: 14px; top: 10px; font-family: var(--font-head); font-size: 1.3rem; font-weight: 700; color: rgba(10, 108, 255, 0.18); }

  .why { display: grid; grid-template-columns: 1fr 1.1fr; gap: 56px; align-items: start; }
  .why h2 { margin-top: 12px; }
  .benefits { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .benefits li { display: flex; gap: 14px; }
  .benefits li > :global(svg) { flex: none; color: var(--accent); margin-top: 2px; }
  .benefits h3 { margin-bottom: 4px; }
  .benefits p { font-size: 0.93rem; margin: 0; }

  .cta-band {
    display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;
    padding: 18px 28px; border-radius: 18px; color: #fff;
    background: radial-gradient(600px 240px at 100% 0%, rgba(90, 162, 255, 0.5), transparent 70%), linear-gradient(135deg, #0a4fc4, #2b86ff);
  }
  .cta-band h2 { font-size: 1.3rem; margin-bottom: 2px; color: #fff; }
  .cta-band p { font-size: 0.92rem; }
  .cta-band p { margin: 0; color: #d7e6ff; }
  .cta-band .btn-primary { background: #fff; color: var(--accent-2); }

  @media (max-width: 1180px) { .grid-groups { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 960px) {
    .grid-groups { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .hero-inner { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .hero-video { max-width: 640px; }
    .segments, .why { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr; }
    .why { gap: 32px; }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 12px; }
    .grid-groups { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .hero-video video { aspect-ratio: 1 / 1; }
    .segment { padding: 14px 16px; }
    .benefits { grid-template-columns: 1fr; }
    .cta-band { padding: 28px 22px; }
    .hero-search .btn { padding: 10px 16px; }
  }

  /* Teljes szélességű, sötétített videós hero (teszt) – a sötét fejléccel egybeolvad */
  .vhero { position: relative; overflow: hidden; min-height: min(calc(100vh - var(--header-h)), 760px); display: flex; align-items: center; background: #1c1d1f; color: #fff; }
  .vhero::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--metal); z-index: 2; }
  .vhero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 28%; }
  .vhero-shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, #1c1d1f 0%, rgba(28, 29, 31, 0.55) 18%, rgba(10, 11, 12, 0.25) 55%, rgba(10, 11, 12, 0.7) 100%),
      linear-gradient(90deg, rgba(10, 11, 12, 0.82) 0%, rgba(10, 11, 12, 0.55) 45%, rgba(10, 11, 12, 0.15) 75%, rgba(10, 11, 12, 0.05) 100%);
  }
  .vhero-inner { position: relative; z-index: 1; padding-top: 48px; padding-bottom: 56px; align-self: stretch; display: flex; align-items: center; }
  /* tömör, sorkizárt szövegblokk */
  .vhero-copy { width: 100%; max-width: 520px; }
  .vhero-copy .lead { text-align: left; font-size: 1.3rem; line-height: 1.45; margin: 0; }

  .vhero .eyebrow { color: #8fbcff; }
  .vhero .eyebrow::before { background: #8fbcff; }
  .vhero h1 { margin: 10px 0 14px; color: #fff; font-size: clamp(1.9rem, 3.2vw, 2.6rem); text-align: left; text-shadow: 0 2px 20px rgba(0, 0, 0, 0.35); }
  /* kiemelt zárósor: új sorban, egyszínű világoskék, alatta kék csík */
  .vhero h1 .vh-accent {
    position: relative; display: table; margin-top: 6px; padding-bottom: 8px;
    color: #8fbcff;
  }
  .vhero h1 .vh-accent::after { content: ''; position: absolute; left: 0; bottom: 0; width: 64%; height: 4px; border-radius: 4px; background: linear-gradient(90deg, #2b86ff, rgba(43, 134, 255, 0)); }
  .vhero .lead { color: #d9dee4; }
  .vhero-search { max-width: 560px; background: rgba(255, 255, 255, 0.96); border: 1px solid rgba(255, 255, 255, 0.6); box-shadow: 0 16px 40px -18px rgba(0, 0, 0, 0.7); }
  .vhero .hero-popular { color: #b9c1ca; }
  .vhero .hero-popular a { color: #e6eaee; border-color: rgba(255, 255, 255, 0.35); }
  .vhero .hero-popular a:hover { color: #fff; border-color: #fff; }
  @media (max-width: 640px) {
    .vhero { min-height: 560px; }
    .vhero-inner { padding-top: 32px; padding-bottom: 36px; }
  }
</style>
