---
import Icon from './Icon.astro';
import { groups, stats, roundedCount, groupImage } from '../lib/catalog.js';

// A főoldal tartalma: teljes szélességű videó-hero a fejléc alatt, majd a bemutatkozó és katalógus szekciók.

// Rövid, egysoros összefoglaló a főoldali termékcsoport-kártyákra
const SHORT = {
  'acel-es-alu-rakoncak-es-szegok': 'Első, köztes és hátsó rakoncák.',
  'acel-profilok': 'Hossztartók, keretek, oldalfalak.',
  'aluminium-alvaz-profilok': 'Tartók, keretek, aláfutásgátlók.',
  'aluminium-lemezek': 'Sima, mintás és festett lemezek.',
  'aluminium-padlo-profilok': 'Padló- és rámpaprofilok.',
  'billencs-alkatreszek': 'Munkahengerek, bölcsők, vezérlés.',
  'csuszasmentes-retegelt-padlo': 'Rétegelt padló- és fallemezek.',
  'dobozos-felepitmeny-alkatreszek': 'Zsanérok, zárak, tömítések.',
  'elhuzhato-roloponyvas-rendszer': 'Elhúzható tető- és oldalponyvák.',
  'gumiszonyegek': 'Istálló- és rámpaszőnyegek.',
  'hatso-ajtok-es-athajto-rampak': 'Hátsó ajtók és rámpák.',
  'ipari-felgyartmanyok': 'Zártszelvények, csövek, rudak.',
  'italszallito-kit': 'Készlet italszállítókhoz.',
  'kedergumik': 'Élvédő, tömítő, kéderprofilok.',
  'platos-alkatreszek-es-kiegeszitok': 'Konzolok, zsanérok, zárak.',
  'ponyvarendszer-kiegeszitok': 'Ponyvacsövek, tartók, feszítők.',
  'ponyvas-oldalfal-profilok-es-szegok': 'Oldalfal-profilok és szegők.',
  'rakomanyrogzites': 'Sínek, rudak, hevederek.',
  'sarvedok-szerszamosladak': 'Sárvédők, ládák, tartályok.',
  'specialis-felepitmeny-alkatreszek': 'Speciális zárak és szerelvények.',
  'szellozes-tetoablakok-vilagitas': 'Szellőzők, tetőablakok, lámpák.',
  'uvegszalas-polieszter': 'GFK lemezek és panelek.',
  'zart-dobozos-es-hutos-profilok': 'Dobozos és hűtős profilok.',
};

---
  <div class="hero-video">
    <video class="hv" muted loop playsinline preload="metadata"
      poster="/video/quadris-ponyvas-poster.jpg" width="1920" height="1080" aria-hidden="true" data-hero-video
      data-src-webm="/video/quadris-ponyvas-1080.webm" data-src-mp4="/video/quadris-ponyvas-1080.mp4"
      data-src-mobile="/video/quadris-ponyvas-720.mp4"></video>
    <div class="hero-top-shade" aria-hidden="true"></div>
    <a class="hero-scroll" href="#bemutatkozas" aria-label="Görgessen a tartalomhoz">
      <Icon name="ChevronDown" size={22} />
    </a>
  </div>

  <section class="intro" id="bemutatkozas">
    <div class="container intro-inner">
      <h1>Minden alkatrész a&nbsp;felépítményhez –&nbsp;egy&nbsp;partnertől.</h1>
      <p class="lead">Alváz- és padlóprofilok, ponyvarendszerek, zárak, zsanérok, sárvédők és rakományrögzítés jármű- és lószállító felépítmények gyártóinak.</p>
      <div class="intro-actions">
        <a href="/termekek" class="btn btn-primary">Termékkatalógus <Icon name="ArrowRight" size={16} /></a>
        <a href="/ajanlatkeres" class="btn btn-ghost">Ajánlatkérés online <Icon name="ArrowRight" size={16} /></a>
      </div>
    </div>
  </section>

  <section class="section groups-section band" id="termekcsoportok">
    <div class="band-sheen" aria-hidden="true"></div>
    <div class="container">
      <div class="section-head">
        <h2 class="display">Termékkategóriák</h2>
        <a href="/termekek" class="btn btn-ghost">Összes termék <Icon name="ArrowRight" size={16} /></a>
      </div>
      <div class="grid grid-groups">
        {groups.map((g, i) => (
          <a href={`/termekek/${g.slug}`} class="card group-card">
            <div class="group-media">
              {groupImage(g.slug) ? <img src={groupImage(g.slug)} alt="" loading={i < 6 ? 'eager' : 'lazy'} width="800" height="560" />
                : <span class="media-empty" aria-hidden="true"></span>}
            </div>
            <h3>{g.name}</h3>
            {SHORT[g.slug] && <p class="muted">{SHORT[g.slug]}</p>}
            <span class="group-count">{g.count} termék <Icon name="ArrowRight" size={14} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section steps-section">
    <div class="container">
      <h2 class="display">Ajánlat három lépésben</h2>
      <ol class="steps">
        <li>
          <h3><span class="step-no" aria-hidden="true">1</span>Válogasson</h3>
          <p class="muted">Keressen név vagy cikkszám alapján, vagy böngésszen a termékcsoportok között.</p>
        </li>
        <li>
          <h3><span class="step-no" aria-hidden="true">2</span>Tegye az ajánlatkérőbe</h3>
          <p class="muted">Adja meg a mennyiségeket. Ha valamit nem talál, egyedi tételként is felveheti.</p>
        </li>
        <li>
          <h3><span class="step-no" aria-hidden="true">3</span>Küldje el</h3>
          <p class="muted">Egy kattintással elküldi a listát, kollégáink pedig személyre szabott ajánlattal jelentkeznek.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section why-section band">
    <div class="container why">
      <div class="why-copy">
        <span class="eyebrow">Miért a Quadris?</span>
        <h2>Egy partner a teljes felépítményhez</h2>
        <p class="lead">Nem kell tucatnyi gyártóval külön tárgyalnia: összegyűjtjük, egyeztetjük és egyben szállítjuk, amire a gyártósorának szüksége van.</p>
      </div>
      <ul class="benefits">
        <li><h3>Széles választék</h3><p class="muted">{roundedCount(stats.products)} termék {roundedCount(stats.suppliers, 25)} gyártótól, egyetlen kapcsolattartóval.</p></li>
        <li><h3>Szakmai tanácsadás</h3><p class="muted">Segítünk kiválasztani a megfelelő profilt, zárat vagy rendszert az adott felépítményhez.</p></li>
        <li><h3>Gyors ajánlat</h3><p class="muted">Online összeállított lista, gyors és átlátható árajánlat.</p></li>
        <li><h3>Egyedi igények</h3><p class="muted">Nem szerepel a katalógusban? Írja meg, és beszerezzük.</p></li>
      </ul>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-inner">
      <div>
        <h2>Nem találja, amit keres?</h2>
        <p>Vegye fel egyedi tételként az ajánlatkérőbe: írja le, mire van szüksége, és megkeressük.</p>
      </div>
      <a href="/ajanlatkeres#egyedi" class="btn btn-light">Egyedi tétel kérése <Icon name="ArrowRight" size={16} /></a>
    </div>
  </section>

<script>
  // Hero videó: a markupban nincs forrás és autoplay (preload="metadata"), így a böngésző nem kezd
  // letöltést a script előtt. A forrást JS választja (a <source media> csak Safariban működik
  // videónál); mozgáscsökkentésnél csak a poszter marad, 0 byte videó.
  const hv = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (hv && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const wide = matchMedia('(min-width: 900px)').matches;
    const canWebm = hv.canPlayType('video/webm; codecs="vp9"') !== '';
    const src = wide ? (canWebm ? hv.dataset.srcWebm : hv.dataset.srcMp4) : hv.dataset.srcMobile;
    if (src) {
      hv.src = src;
      hv.autoplay = true;
      hv.load();
      hv.play().catch(() => {});
    }
  }

  // Hero „görgessen le” jel: amint a látogató görget, eltűnik, hogy ne ütközzön
  // a jobb alsó „vissza a tetejére” gombbal (két ellentétes nyíl ugyanabban a sarokban).
  const heroScroll = document.querySelector<HTMLElement>('.hero-scroll');
  if (heroScroll) {
    const syncHint = () => heroScroll.classList.toggle('is-hidden', window.scrollY > 8);
    window.addEventListener('scroll', syncHint, { passive: true });
    syncHint();
  }
</script>

<style>
  /* ---- Videó-hero: a fejléc alá fut, teljes szélesség, 16:9 ---- */
  .hero-video { position: relative; width: 100%; overflow: hidden; background: #2b3036 url(/video/quadris-ponyvas-poster.jpg) center / cover no-repeat; }
  .hero-video .hv {
    display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; max-height: 100svh;
    object-fit: cover; object-position: center; background: transparent;
  }
  .hero-top-shade {
    position: absolute; top: 0; left: 0; right: 0; height: 120px; pointer-events: none;
    background: linear-gradient(180deg, rgba(11, 31, 58, 0.45) 0%, rgba(11, 31, 58, 0) 100%);
  }
  .hero-scroll {
    position: absolute; right: 24px; bottom: 20px; width: 40px; height: 40px;
    display: grid; place-items: center; color: #fff; border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.45); background: rgba(11, 31, 58, 0.25);
    backdrop-filter: blur(6px); transition: background 0.2s, border-color 0.2s, opacity 0.25s ease, visibility 0.25s;
    animation: nudge 2.4s ease-in-out infinite;
  }
  .hero-scroll.is-hidden { opacity: 0; visibility: hidden; pointer-events: none; animation: none; }
  .hero-scroll:hover, .hero-scroll:focus-visible { background: rgba(11, 31, 58, 0.5); border-color: #fff; }
  .hero-scroll:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  @keyframes nudge { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(4px); } }

  /* ---- Bevezető: középre zárt cím és gombok, alatta hat kiemelt termékcsoport ---- */
  .intro { background: var(--bg); padding: 56px 0 52px; }
  .intro-inner { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; }
  .intro h1 { margin: 0; max-width: 900px; font-size: clamp(2.2rem, 4.4vw, 4rem); line-height: 1.04; letter-spacing: -0.03em; color: var(--ink); text-wrap: balance; }
  .intro .lead { margin: 0; max-width: 720px; font-size: 1.2rem; }
  .intro-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 6px; }
  .link-arrow { display: inline-flex; align-items: center; gap: 6px; color: var(--link); font-weight: 600; font-size: 0.88rem; }

  /* ---- Váltakozó sávok: világos hűvösszürke háttér, fent-lent vékony fémes él ---- */
  .band { position: relative; overflow: hidden; background: var(--bg); }
  .band::before, .band::after { content: ''; position: absolute; left: 0; right: 0; height: 2px; background: var(--metal); z-index: 1; }
  .band::before { top: 0; }
  .band::after { bottom: 0; }
  .band > .container { position: relative; z-index: 1; }
  /* fémes fényvisszaverődés a termékkategóriák mögött, 12 mp-enként */
  .band-sheen {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(105deg, rgba(255, 255, 255, 0) 38%, rgba(255, 255, 255, 0.28) 48%, rgba(214, 229, 242, 0.18) 52%, rgba(255, 255, 255, 0) 62%) no-repeat;
    background-size: 260% 100%; background-position: 110% 0;
    animation: sheen 12s ease-in-out infinite;
  }
  @keyframes sheen { 0% { background-position: 110% 0; } 55%, 100% { background-position: -10% 0; } }

  /* ---- Termékcsoportok ---- */
  .groups-section { padding: 56px 0 64px; }
  .section-head { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; margin-bottom: 32px; }
  .section-head h2 { margin: 0; }
  /* nagy, középre zárt szekciócím – a bevezető címével azonos stílus */
  .display { max-width: 900px; font-family: var(--font-head); font-weight: 800; font-size: clamp(2.2rem, 4.4vw, 4rem); line-height: 1.04; letter-spacing: -0.03em; color: var(--ink); text-wrap: balance; }
  .grid-groups { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 18px; }
  .group-card { padding: 0 16px 14px; display: flex !important; flex-direction: column; overflow: hidden; }
  .group-media { position: relative; margin: 0 -16px 12px; aspect-ratio: 10 / 7; background: #fff; border-bottom: 1px solid var(--line); overflow: hidden; }
  .group-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .group-card:hover .group-media img { transform: scale(1.05); }
  .media-empty { display: block; width: 100%; height: 100%; background: linear-gradient(135deg, #fbfcfd, #eef1f4); }
  .group-card h3 {
    font-size: 0.95rem; font-weight: 600; color: var(--ink); line-height: 1.3; margin: 0 0 4px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .group-card p { font-size: 0.82rem; line-height: 1.45; margin: 0 0 10px; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .group-count { display: inline-flex; align-items: center; gap: 5px; margin-top: auto; font-size: 0.8rem; font-weight: 600; color: var(--link); }

  /* ---- Így működik ---- */
  .steps-section { padding: 64px 0; }
  .steps-section h2 { margin: 0; text-align: center; margin-inline: auto; }
  .steps { list-style: none; padding: 0; margin: 32px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .steps li { border-top: 1px solid var(--line-strong); padding-top: 18px; }
  .step-no { display: inline-block; min-width: 1.4em; margin-right: 6px; font-weight: 800; color: var(--link); }
  .steps h3 { font-size: 1.05rem; margin: 0 0 6px; color: var(--ink); }
  .steps p { font-size: 0.93rem; line-height: 1.5; margin: 0; }

  /* ---- Miért a Quadris ---- */
  .why-section { padding: 64px 0; }
  .why { display: grid; grid-template-columns: 1fr 1.1fr; gap: 56px; align-items: start; }
  .why h2 { margin: 10px 0 14px; }
  .why .lead { margin: 0; }
  .benefits { list-style: none; padding: 0; margin: 0; }
  .benefits li { padding: 18px 0; border-top: 1px solid var(--line-strong); }
  .benefits li:last-child { border-bottom: 1px solid var(--line-strong); }
  .benefits h3 { margin: 0 0 4px; font-size: 1.05rem; color: var(--ink); }
  .benefits p { font-size: 0.93rem; margin: 0; }

  /* ---- CTA sáv ---- */
  .cta-section { background: var(--navy); color: #fff; padding: 56px 0; }
  .cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .cta-inner h2 { color: #fff; margin: 0 0 6px; font-size: clamp(1.4rem, 2.4vw, 1.9rem); }
  .cta-inner p { margin: 0; color: rgba(255, 255, 255, 0.72); font-size: 0.98rem; max-width: 620px; }

  /* ---- Reszponzív ---- */
  @media (max-width: 1180px) { .grid-groups { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 960px) {
    .grid-groups { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .why { grid-template-columns: 1fr; }
    .why { gap: 32px; }
    .steps { grid-template-columns: 1fr; gap: 20px; }
    .intro { padding: 40px 0 32px; }
  }
  @media (max-width: 640px) {
    .hero-scroll { display: none; }
    .hero-top-shade { display: none; }
    .grid-groups { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .intro-actions { flex-direction: column; width: 100%; }
    .intro-actions .btn, .section-head .btn, .cta-inner .btn { width: 100%; justify-content: center; }
    .section-head .btn { margin-top: 4px; }
    .group-card h3 { font-size: 0.9rem; -webkit-line-clamp: 3; }
    .group-card p { white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .cta-section { padding: 44px 0; }
  }
</style>
