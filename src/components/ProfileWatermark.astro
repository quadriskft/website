---
// Halvány, vonalas profil-keresztmetszetek díszítő háttérnek (alumínium padlóprofil, C-sín, rakonca,
// oldalfal-profil, szögprofil, cső) – méretvonalakkal, műszaki rajz hatással.
const { class: cls = '', variant = 'a' } = Astro.props;
// padlóprofil bordázata
const ribs = Array.from({ length: 19 }, (_, i) => `M${8 + i * 10} 0v-3h4v3`).join('');
---
<svg class:list={['profile-wm', cls]} viewBox="0 0 640 420" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round">
  {variant === 'a' ? (
    <>
      {/* alumínium padlóprofil (üreges, bordázott, nútos-csapos) */}
      <g transform="translate(40 60)">
        <path d="M0 4h200v28H0z" />
        <path d={ribs} transform="translate(0 4)" />
        <path d="M200 12h9v12h-9M0 12h-7v12h7" />
        <path d="M5 9h43v18H5zM54 9h43v18H54zM103 9h43v18h-43zM152 9h43v18h-43z" />
        <path d="M0 -14v-8M200 -14v-8M0 -18h200" stroke-width="0.9" />
        <text x="100" y="-24" font-size="11" text-anchor="middle" fill="currentColor" stroke="none">200</text>
      </g>
      {/* C-sín */}
      <g transform="translate(320 40)">
        <path d="M0 0h70v10H12v50h58v10H0z" />
        <path d="M84 0h8M84 70h8M88 0v70" stroke-width="0.9" />
        <text x="97" y="39" font-size="11" fill="currentColor" stroke="none">70</text>
      </g>
      {/* rakonca (zártszelvény horonnyal) */}
      <g transform="translate(470 30)">
        <rect x="0" y="0" width="60" height="90" rx="6" />
        <rect x="5" y="5" width="50" height="80" rx="3" />
        <path d="M22 0v-6h16v6M26 -6v-8h8v8" />
        <path d="M5 45h50" stroke-dasharray="4 4" stroke-width="0.9" />
      </g>
      {/* oldalfal-profil (kampós) */}
      <g transform="translate(60 180)">
        <path d="M0 0h14v120h-14zM14 10h30v-10h8v24h-8v-6H14M14 100h26l12 12v8h-8v-4l-8-8H14" />
        <path d="M-14 0h-8M-14 120h-8M-18 0v120" stroke-width="0.9" />
      </g>
      {/* szögprofil és cső */}
      <g transform="translate(200 220)">
        <path d="M0 0v90h90v-8H8V0z" />
        <circle cx="200" cy="45" r="44" />
        <circle cx="200" cy="45" r="38" />
        <path d="M200 -10v110M145 45h110" stroke-dasharray="6 4" stroke-width="0.8" />
      </g>
      {/* lapos rámpaprofil */}
      <g transform="translate(470 250)">
        <path d="M0 20L130 0v12L0 34z" />
        <path d="M10 22l110-17M20 26l100-15" stroke-width="0.9" />
      </g>
    </>
  ) : (
    <>
      {/* aláfutásgátló profil (kamrás) */}
      <g transform="translate(40 40)">
        <path d="M0 0h160v70H0z" />
        <path d="M6 6h46v58H6zM58 6h44v58H58zM108 6h46v58h-46z" />
        <path d="M0 84v8M160 84v8M0 88h160" stroke-width="0.9" />
      </g>
      {/* U-profil */}
      <g transform="translate(260 30)">
        <path d="M0 0v80h80V0h-8v72H8V0z" />
      </g>
      {/* ponyvacső / spitzprofil */}
      <g transform="translate(400 50)">
        <circle cx="40" cy="40" r="36" />
        <path d="M40 76v40h-6v-40M40 76v40h6v-40" />
        <circle cx="40" cy="40" r="30" />
      </g>
      {/* hossztartó (I-szelvény) */}
      <g transform="translate(60 180)">
        <path d="M0 0h110v12H61v96h49v12H0v-12h49V12H0z" />
        <path d="M124 0h8M124 120h8M128 0v120" stroke-width="0.9" />
      </g>
      {/* oldalfal-szegő */}
      <g transform="translate(240 200)">
        <path d="M0 0h90l12 12v70H90V16l-4-4H12v70H0z" />
        <path d="M12 60h78" stroke-dasharray="5 4" stroke-width="0.9" />
      </g>
      {/* zártszelvény */}
      <g transform="translate(420 200)">
        <rect x="0" y="0" width="120" height="80" rx="5" />
        <rect x="6" y="6" width="108" height="68" rx="2" />
        <path d="M-10 40h140M60 -10v100" stroke-dasharray="6 4" stroke-width="0.8" />
      </g>
    </>
  )}
</svg>

<style>
  .profile-wm { position: absolute; pointer-events: none; color: #7c8794; opacity: 0.2; z-index: 0; }
</style>
