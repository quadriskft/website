---
import Icon from './Icon.astro';
import ProductVisual from './ProductVisual.astro';
import { publicProduct, codeShown, familyOf } from '../lib/catalog.js';

const { product, hideCode = false } = Astro.props;
// Natúr alumínium lemezek: a kártyán a terméken belül választható táblaméretek (pl. 1000x2000), a méret oldalára mutatva
const fam = product.family ? familyOf(product.slug) : null;
const sizes = [];
if (fam?.id.startsWith('alu-natur-') && fam.rows) {
  for (const m of fam.members) {
    const [w, l] = fam.rows[m.slug] ?? [];
    const label = w && l ? `${parseInt(w)}x${parseInt(l)}` : null;
    if (label && !sizes.some((x) => x.label === label)) sizes.push({ label, slug: m.slug });
  }
}
---
<article class="card hoverable product-card" data-name={`${product.code} ${product.name}`.toLowerCase()}>
  <a href={`/termek/${product.slug}`} class="product-link">
    <ProductVisual product={product} />
    {product.stock && <span class="stock-badge">Raktárról rendelhető</span>}
    <h3>{product.name}</h3>
  </a>
  {sizes.length > 0 && (
    <ul class="card-sizes" aria-label="Választható méretek">
      {sizes.map((x) => <li><a href={`/termek/${x.slug}`}>{x.label}</a></li>)}
    </ul>
  )}
  <div class="product-foot">
    <span class="muted code">{!hideCode && codeShown(product) ? `${product.codeLabel ?? 'Cikkszám'}: ${product.code}` : ' '}</span>
    <button type="button" class="add-btn" data-add-to-quote={JSON.stringify(publicProduct(product))} aria-label={`${product.name} – ajánlatkérőbe`}>
      <Icon name="Plus" size={16} class="i-add" />
      <Icon name="Check" size={16} class="i-added" />
      <span class="label">Ajánlatkérőbe</span>
    </button>
  </div>
</article>

<style>
  .card-sizes { list-style: none; margin: 0 0 8px; padding: 0 4px; display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 6px; }
  .card-sizes a { display: block; padding: 2px 8px; border: 1px solid var(--line-strong); border-radius: 999px; font-size: 0.74rem; line-height: 1.5; color: var(--text-2); text-decoration: none !important; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .card-sizes a:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
  .product-card { display: flex; flex-direction: column; padding: 12px; }
  .product-link { color: inherit; text-decoration: none !important; display: block; flex: 1; }
  h3 { font-size: 0.97rem; font-weight: 600; margin: 12px 4px 6px; line-height: 1.35; color: var(--navy); }
  .product-link:hover h3 { color: var(--accent); }
  .stock-badge { display: inline-flex; align-items: center; gap: 4px; margin: 10px 4px 0; padding: 3px 9px; border-radius: var(--radius-btn);
    background: rgba(18, 163, 107, 0.1); color: var(--ok); font-size: 0.72rem; font-weight: 700; }
  .product-foot { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 4px 4px 2px; flex-wrap: wrap; }
  .product-foot .code:empty, .product-foot .code { display: none; }
  .code { font-size: 0.8rem; }
  .add-btn {
    display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; border-radius: var(--radius-btn);
    border: 1px solid var(--line-strong); background: #fff; color: var(--navy);
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer; transition: all 0.2s ease;
  }
  .add-btn:hover { border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }
  .add-btn :global(.i-added) { display: none; }
  .add-btn.in-quote { border-color: rgba(18, 163, 107, 0.5); background: rgba(18, 163, 107, 0.08); color: var(--ok); }
  .add-btn.in-quote :global(.i-add) { display: none; }
  .add-btn.in-quote :global(.i-added) { display: inline; }
  @media (max-width: 720px) {
    .product-card { padding: 8px; }
    h3 { font-size: 0.9rem; margin: 10px 2px 4px; }
    .add-btn { width: 100%; justify-content: center; }
  }
</style>
