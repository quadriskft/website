---
// Összeszerelődő platós felépítmény – izometrikus "robbantott ábra" animáció, kódból rajzolva.
// A jármű alapja (fülke, alváz, kerekek) beúszik, majd a felépítmény alkatrészei a helyükre
// repülnek, és felvillan a termékcsoport neve. 15 másodperces, végtelenített animáció.
const LOOP = 15; // mp
const C = Math.cos(Math.PI / 6);
const S = Math.sin(Math.PI / 6);
const U = 62; // px / méter
const iso = (x, y, z) => [(x - y) * C * U, (x + y) * S * U - z * U];
const f = (n) => n.toFixed(1);
const P = (pts) => 'M' + pts.map((p) => iso(...p).map(f).join(',')).join('L') + 'Z';

// Színek (a felületek színátmenetesek a térhatásért)
const AL = { top: 'url(#g-al-top)', side: 'url(#g-al-side)', end: 'url(#g-al-end)', line: '#8095ad' };
const STEEL = { top: '#5d6b80', side: 'url(#g-steel-side)', end: '#2c3747', line: '#1f2937' };
const DARK = { top: '#3a4452', side: 'url(#g-dark-side)', end: '#1c232c', line: '#141a21' };
const BLUE = { top: '#6aaeff', side: 'url(#g-blue-side)', end: '#0a54c4', line: '#0a3f94' };
const RED = { top: '#ff8a80', side: '#e5484d', end: '#b3261e', line: '#8c1d18' };

// Doboz: a három látható lap (felső, +y oldal, +x vég)
function box(x0, x1, y0, y1, z0, z1, c) {
  return [
    { d: P([[x0, y1, z0], [x1, y1, z0], [x1, y1, z1], [x0, y1, z1]]), fill: c.side, stroke: c.line },
    { d: P([[x1, y0, z0], [x1, y1, z0], [x1, y1, z1], [x1, y0, z1]]), fill: c.end, stroke: c.line },
    { d: P([[x0, y0, z1], [x1, y0, z1], [x1, y1, z1], [x0, y1, z1]]), fill: c.top, stroke: c.line },
  ];
}

// Kerék: valódi henger (futófelület-sáv + oldalfal), fémes felni, csavarok, agy
function wheel(cx, y, r, far = false) {
  const depth = 0.24;
  const circ = (yy, rr, z0 = 0.36, x0 = cx) => {
    const pts = [];
    for (let i = 0; i < 40; i++) {
      const a = (i / 40) * Math.PI * 2;
      pts.push([x0 + Math.cos(a) * rr, yy, z0 + Math.sin(a) * rr]);
    }
    return P(pts);
  };
  const out = [];
  for (let k = 0; k <= 8; k++) out.push({ d: circ(y - depth + (k * depth) / 8, r), fill: k < 8 ? '#141a21' : '#1b2129', stroke: 'none' });
  if (far) return out;
  out.push({ d: circ(y, r), fill: 'url(#g-tire)', stroke: '#0b0f14' });
  out.push({ d: circ(y + 0.002, r * 0.64), fill: 'url(#g-rim)', stroke: '#6f7c8b' });
  out.push({ d: circ(y + 0.003, r * 0.47), fill: 'none', stroke: '#8e9aa8' });
  for (let i = 0; i < 6; i++) {
    const a = (i / 6) * Math.PI * 2;
    out.push({ d: circ(y + 0.004, r * 0.05, 0.36 + Math.sin(a) * r * 0.31, cx + Math.cos(a) * r * 0.31), fill: '#4d5764', stroke: 'none' });
  }
  out.push({ d: circ(y + 0.005, r * 0.17), fill: 'url(#g-hub)', stroke: '#5a6571' });
  return out;
}

const W = 2.1; // szélesség
const BX0 = 0, BX1 = 4.55; // plató hossza
const FZ = 1.02; // padló szint

// Fülke oldalprofil (x, z), elöl jobbra
const cabProfile = [[4.72, 0.62], [4.72, 2.52], [6.08, 2.52], [6.3, 2.36], [6.58, 1.52], [6.92, 1.32], [6.98, 0.62]];
function cab() {
  const y0 = 0.08, y1 = W - 0.08;
  const shapes = [];
  const n = cabProfile.length;
  // élek felülete (csak a nézővel szembenézők)
  for (let i = 0; i < n; i++) {
    const [ax, az] = cabProfile[i];
    const [bx, bz] = cabProfile[(i + 1) % n];
    const nx = -(bz - az), nz = bx - ax; // kifelé mutató normális (óramutató szerinti körüljárás)
    if (nx * 1 + nz * 1 <= 0.001) continue;
    const glass = i === 3 || i === 2;
    shapes.push({ d: P([[ax, y0, az], [bx, y0, bz], [bx, y1, bz], [ax, y1, az]]), fill: glass ? (i === 3 ? 'url(#g-glass)' : '#eef2f7') : 'url(#g-cab-top)', stroke: '#8d9bab' });
  }
  shapes.push({ d: P(cabProfile.map(([x, z]) => [x, y1, z])), fill: 'url(#g-cab-side)', stroke: '#8d9bab' });
  // oldalablak, ajtó, lökhárító, fényszóró
  shapes.push({ d: P([[5.02, y1, 1.62], [5.02, y1, 2.36], [6.02, y1, 2.36], [6.24, y1, 2.2], [6.44, y1, 1.62]]), fill: 'url(#g-glass)', stroke: '#1d2838' });
  shapes.push({ d: P([[4.95, y1, 0.66], [4.95, y1, 1.55], [6.1, y1, 1.55], [6.1, y1, 0.66]]), fill: 'none', stroke: '#b3bfcc' });
  shapes.push({ d: P([[6.62, y1, 0.62], [6.98, y1, 0.62], [6.98, y1, 0.92], [6.64, y1, 0.92]]), fill: '#2a323d', stroke: '#141a21' });
  shapes.push({ d: P([[6.98, 0.3, 0.62], [6.98, W - 0.3, 0.62], [6.98, W - 0.3, 0.92], [6.98, 0.3, 0.92]]), fill: '#2a323d', stroke: '#141a21' });
  shapes.push({ d: P([[6.95, W - 0.42, 1.08], [6.95, W - 0.14, 1.08], [6.95, W - 0.14, 1.26], [6.95, W - 0.42, 1.26]]), fill: '#dff0ff', stroke: '#7a8ea6' });
  shapes.push({ d: P([[6.0, y1 + 0.02, 1.7], [6.0, y1 + 0.22, 1.7], [6.0, y1 + 0.22, 2.05], [6.0, y1 + 0.02, 2.05]]), fill: '#1f2733', stroke: '#0e131a' });
  // alsó műanyag burkolat, kerékív az első kerék fölött, kilincs, hűtőrács
  shapes.push({ d: P([[4.72, y1, 0.62], [6.98, y1, 0.62], [6.98, y1, 0.8], [4.72, y1, 0.8]]), fill: '#2a323d', stroke: 'none' });
  const arch = [];
  for (let i = 0; i <= 16; i++) { const a = Math.PI * (i / 16); arch.push([5.85 + Math.cos(a) * 0.5, y1 + 0.001, 0.36 + Math.sin(a) * 0.5]); }
  for (let i = 16; i >= 0; i--) { const a = Math.PI * (i / 16); arch.push([5.85 + Math.cos(a) * 0.42, y1 + 0.001, 0.36 + Math.sin(a) * 0.42]); }
  shapes.push({ d: P(arch), fill: '#232a33', stroke: 'none' });
  shapes.push({ d: P([[5.3, y1 + 0.005, 1.38], [5.52, y1 + 0.005, 1.38], [5.52, y1 + 0.005, 1.43], [5.3, y1 + 0.005, 1.43]]), fill: '#3a4450', stroke: 'none' });
  for (let k = 0; k < 4; k++) {
    const z = 0.98 + k * 0.07;
    shapes.push({ d: P([[6.97, 0.45, z], [6.97, W - 0.55, z], [6.97, W - 0.55, z + 0.035], [6.97, 0.45, z + 0.035]]), fill: '#2a323d', stroke: 'none' });
  }
  return shapes;
}

// Alkatrészek: [azonosító, felirat, felirat pozíció (3D), robbantási eltolás (3D), kezdés mp, alakzatok]
const parts = [];
const add = (id, label, anchor, off, start, shapes, dur = 0.9) => parts.push({ id, label, anchor, off, start, dur, shapes });

// 0) alapjármű: hátsó kerekek (túloldal), alváz, fülke, kerekek
const base = [
  ...wheel(2.35, 0.36, 0.36, true), ...wheel(5.85, 0.36, 0.36, true),
  ...box(0.35, 6.5, 0.42, 0.58, 0.58, 0.76, STEEL), ...box(0.35, 6.5, W - 0.58, W - 0.42, 0.58, 0.76, STEEL),
  ...cab(),
  ...wheel(2.35, W - 0.1, 0.36), ...wheel(5.85, W - 0.1, 0.36),
];
add('base', null, null, [9, 0, 0], 0, base, 1.3);

// 1) alumínium alváz hossztartók
add('rails', 'Alváz profilok', [2.6, W, 0.84], [0, 0, 2.6], 1.5, [
  ...box(BX0 + 0.1, BX1 - 0.05, 0.36, 0.56, 0.78, 0.9, AL), ...box(BX0 + 0.1, BX1 - 0.05, W - 0.56, W - 0.36, 0.78, 0.9, AL),
]);
// 2) kereszttartók
const cross = [];
for (let i = 0; i < 7; i++) {
  const x = BX0 + 0.2 + i * 0.7;
  cross.push(...box(x, x + 0.08, 0.1, W - 0.1, 0.9, 0.98, AL));
}
add('cross', 'Kereszttartók', [0.6, W - 0.1, 0.96], [0, 0, 2.8], 2.5, cross);
// 3) padló
const floor = box(BX0, BX1, 0, W, 0.98, FZ, { top: '#8a6a4a', side: '#6e5238', end: '#5c442e', line: '#4a3622' });
add('floor', 'Padló & rétegelt lemez', [1.2, W / 2, FZ], [0, 0, 3.2], 3.6, floor);
// 4) oldalfalak (bal = közeli, jobb = túlsó)
const sideH = 0.42;
add('sideFar', null, null, [0, -2.6, 0], 4.7, box(BX0, BX1, 0, 0.05, FZ, FZ + sideH, AL));
add('sideNear', 'Oldalfalak & szegők', [2.3, W, FZ + sideH], [0, 2.8, 0], 4.9, [
  ...box(BX0, BX1, W - 0.05, W, FZ, FZ + sideH, AL),
  { d: P([[BX0, W, FZ + 0.21], [BX1, W, FZ + 0.21]]), fill: 'none', stroke: '#9fb0c4' },
]);
// 5) hátfal
add('rear', null, null, [-2.6, 0, 0], 5.8, box(BX0 - 0.05, BX0, 0, W, FZ, FZ + sideH, AL));
// 6) létrás fejfal (a fülke mögött)
const head = [];
const hx = BX1 - 0.08;
head.push(...box(hx, hx + 0.06, 0.02, 0.1, FZ, 2.55, AL), ...box(hx, hx + 0.06, W - 0.1, W - 0.02, FZ, 2.55, AL));
head.push(...box(hx, hx + 0.06, 0.02, W - 0.02, 2.47, 2.55, AL));
for (let i = 1; i < 9; i++) {
  const y = 0.1 + i * ((W - 0.2) / 9);
  head.push({ d: P([[hx + 0.06, y, FZ + sideH], [hx + 0.06, y, 2.47]]), fill: 'none', stroke: '#8fa3bb' });
}
for (let k = 1; k < 5; k++) {
  const z = FZ + sideH + k * ((2.47 - FZ - sideH) / 5);
  head.push({ d: P([[hx + 0.06, 0.1, z], [hx + 0.06, W - 0.1, z]]), fill: 'none', stroke: '#8fa3bb' });
}
head.push(...box(hx, hx + 0.06, 0.02, W - 0.02, FZ, FZ + sideH, AL));
add('head', 'Létrás fejfal', [hx, W - 0.1, 2.2], [0, 0, 3], 6.6, head);
// 7) rakoncák (oszlopok) és zárak
const stake = [];
for (const x of [BX0 + 0.02, BX1 / 2, BX1 - 0.16]) stake.push(...box(x, x + 0.1, W - 0.02, W + 0.02, FZ, FZ + sideH + 0.02, BLUE));
for (const x of [BX1 / 4, (3 * BX1) / 4]) stake.push(...box(x, x + 0.14, W, W + 0.03, FZ + 0.25, FZ + 0.33, STEEL));
add('stakes', 'Rakoncák & zárak', [BX1 / 2, W + 0.02, FZ + sideH], [0, 0, 2.4], 7.6, stake);
// 8) oldalsó aláfutásgátló + fellépő
add('guard', 'Aláfutásgátló', [1.4, W + 0.05, 0.5], [0, 2.6, 0], 8.6, [
  ...box(0.7, 2.0, W - 0.02, W + 0.05, 0.44, 0.56, AL),
  ...box(0.95, 1.0, W - 0.3, W - 0.02, 0.5, 0.78, STEEL), ...box(1.75, 1.8, W - 0.3, W - 0.02, 0.5, 0.78, STEEL),
]);
// 10) sárvédő (hátsó kerék felett)
const mud = [];
{
  const cx = 2.35, cz = 0.36, r1 = 0.46, r2 = 0.52, y = W - 0.02;
  const arc = (r) => Array.from({ length: 13 }, (_, i) => { const a = Math.PI * (i / 12); return [cx + Math.cos(a) * r, y, cz + Math.sin(a) * r]; });
  const outer = arc(r2), inner = arc(r1).reverse();
  for (let i = 0; i < 12; i++) {
    const [ax, , az] = outer[i], [bx, , bz] = outer[i + 1];
    mud.push({ d: P([[ax, y - 0.26, az], [bx, y - 0.26, bz], [bx, y, bz], [ax, y, az]]), fill: '#2d3642', stroke: '#1a2029' });
  }
  mud.push({ d: P([...outer, ...inner]), fill: '#39424f', stroke: '#1a2029' });
}
add('mud', 'Sárvédők', [2.35, W, 0.9], [0, 2.4, 0.6], 10.2, mud);
// 11) szerszámosláda
add('tool', 'Szerszámosláda', [3.6, W - 0.05, 0.9], [0, 2.8, 0], 10.9, [
  ...box(3.25, 3.95, W - 0.5, W - 0.06, 0.5, 0.94, DARK),
  ...box(3.33, 3.5, W - 0.06, W - 0.04, 0.78, 0.86, STEEL), ...box(3.7, 3.87, W - 0.06, W - 0.04, 0.78, 0.86, STEEL),
]);

// Rajzolási sorrend: túloldal előbb
const order = ['base', 'rails', 'cross', 'sideFar', 'floor', 'rear', 'mud', 'tool', 'guard', 'head', 'sideNear', 'stakes'];
const drawn = order.map((id) => parts.find((p) => p.id === id));

// viewBox: az összeszerelt jármű + hely a feliratoknak (a berepülő részek a kereten kívülről érkeznek)
const pts = [];
for (const x of [-0.2, 7.0]) for (const y of [-0.1, W + 0.1]) for (const z of [0, 2.6]) pts.push(iso(x, y, z));
const minX = Math.min(...pts.map((p) => p[0])) - 120;
const maxX = Math.max(...pts.map((p) => p[0])) + 60;
const minY = Math.min(...pts.map((p) => p[1])) - 70;
const maxY = Math.max(...pts.map((p) => p[1])) + 50;
const vb = `${f(minX)} ${f(minY)} ${f(maxX - minX)} ${f(maxY - minY)}`;

// Keyframe-ek generálása
const pct = (t) => ((t / LOOP) * 100).toFixed(2) + '%';
const END = 13.9; // innentől kifakul
let css = '';
for (const p of parts) {
  const [dx, dy] = iso(...p.off);
  const s = p.start, e = p.start + p.dur;
  css += `@keyframes qa-${p.id}{0%,${pct(s)}{transform:translate(${f(dx)}px,${f(dy)}px);opacity:0;animation-timing-function:cubic-bezier(.2,.8,.2,1)}` +
    `${pct(Math.min(s + 0.12, e))}{opacity:1}${pct(e)},${pct(END)}{transform:translate(0,0);opacity:1}${pct(LOOP - 0.3)},100%{transform:translate(0,0);opacity:0}}\n`;
  css += `.qa-${p.id}{animation:qa-${p.id} ${LOOP}s linear infinite}\n`;
  if (p.label) {
    const ls = e - 0.1, le = Math.min(e + 2.6, END);
    css += `@keyframes qal-${p.id}{0%,${pct(ls)}{opacity:0;transform:translateY(8px)}${pct(ls + 0.3)},${pct(le)}{opacity:1;transform:none}${pct(le + 0.4)},100%{opacity:0;transform:none}}\n`;
    css += `.qal-${p.id}{animation:qal-${p.id} ${LOOP}s linear infinite}\n`;
  }
}
// "Kész" felirat a végén
css += `@keyframes qa-done{0%,${pct(12.2)}{opacity:0;transform:translateY(10px)}${pct(12.6)},${pct(END)}{opacity:1;transform:none}${pct(LOOP - 0.3)},100%{opacity:0}}.qa-done{animation:qa-done ${LOOP}s linear infinite}`;

const labels = parts.filter((p) => p.label).map((p) => {
  const [ax, ay] = iso(...p.anchor);
  return { id: p.id, label: p.label, ax, ay };
});
// feliratok elhelyezése: a rész fölött/mellett, egymástól távol
const labelPos = {
  rails: [70, 95], cross: [-60, -95], floor: [-10, -115], sideNear: [-70, 95], head: [120, -55],
  stakes: [10, -125], guard: [-110, 70], mud: [-30, 110], tool: [120, 75],
};
const doneX = (minX + maxX) / 2;
---
<svg class="hero-assembly" viewBox={vb} xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Alkatrészekből összeálló platós felépítmény animációja">
  <defs>
    <linearGradient id="g-al-top" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffffff" /><stop offset="1" stop-color="#e3eaf3" /></linearGradient>
    <linearGradient id="g-al-side" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f3f7fb" /><stop offset="0.45" stop-color="#d9e2ed" /><stop offset="0.5" stop-color="#c7d3e1" /><stop offset="1" stop-color="#b5c4d6" /></linearGradient>
    <linearGradient id="g-al-end" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#cdd8e5" /><stop offset="1" stop-color="#9fb0c5" /></linearGradient>
    <linearGradient id="g-steel-side" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#55647a" /><stop offset="1" stop-color="#2d3847" /></linearGradient>
    <linearGradient id="g-dark-side" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3b4553" /><stop offset="1" stop-color="#1a2029" /></linearGradient>
    <linearGradient id="g-blue-side" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a95ff" /><stop offset="1" stop-color="#0a4fc0" /></linearGradient>
    <linearGradient id="g-cab-side" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffffff" /><stop offset="0.7" stop-color="#f1f4f8" /><stop offset="1" stop-color="#dfe5ec" /></linearGradient>
    <linearGradient id="g-cab-top" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#f4f7fa" /><stop offset="1" stop-color="#d9e0e8" /></linearGradient>
    <linearGradient id="g-glass" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#4a6486" /><stop offset="0.35" stop-color="#7fa0c4" /><stop offset="0.42" stop-color="#2a3a52" /><stop offset="1" stop-color="#18222f" /></linearGradient>
    <radialGradient id="g-tire" cx="0.35" cy="0.3" r="0.8"><stop offset="0" stop-color="#4a525d" /><stop offset="0.75" stop-color="#1c2128" /><stop offset="1" stop-color="#0c1015" /></radialGradient>
    <radialGradient id="g-rim" cx="0.35" cy="0.3" r="0.85"><stop offset="0" stop-color="#ffffff" /><stop offset="0.55" stop-color="#cbd3dc" /><stop offset="1" stop-color="#7a8795" /></radialGradient>
    <radialGradient id="g-hub" cx="0.35" cy="0.3" r="0.8"><stop offset="0" stop-color="#f4f6f9" /><stop offset="1" stop-color="#7d8998" /></radialGradient>
    <radialGradient id="qa-shadow" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#0b1f3a" stop-opacity="0.22" />
      <stop offset="1" stop-color="#0b1f3a" stop-opacity="0" />
    </radialGradient>
  </defs>
  <style set:html={css} />
  <ellipse cx={iso(3.4, W / 2, 0)[0]} cy={iso(3.4, W / 2, 0)[1] + 8} rx="330" ry="90" fill="url(#qa-shadow)" />
  <g stroke-width="1" stroke-linejoin="round">
    {drawn.map((p) => (
      <g class={`qa-part qa-${p.id}`}>
        {p.shapes.map((s) => <path d={s.d} fill={s.fill} stroke={s.stroke} />)}
      </g>
    ))}
  </g>
  <g class="qa-labels" font-family="Inter Variable, Inter, sans-serif" font-size="16" font-weight="600">
    {labels.map((l) => {
      const [ox, oy] = labelPos[l.id] ?? [0, -80];
      const tx = l.ax + ox, ty = l.ay + oy;
      const w = l.label.length * 8.1 + 26;
      return (
        <g class={`qal-${l.id}`}>
          <path d={`M${f(l.ax)},${f(l.ay)}L${f(tx)},${f(ty)}`} stroke="#0a6cff" stroke-width="1.4" fill="none" />
          <circle cx={f(l.ax)} cy={f(l.ay)} r="4" fill="#0a6cff" />
          <rect x={f(tx - w / 2)} y={f(ty - 15)} width={f(w)} height="30" rx="15" fill="#ffffff" stroke="#0a6cff" stroke-width="1.4" />
          <text x={f(tx)} y={f(ty + 5)} text-anchor="middle" fill="#0b1f3a">{l.label}</text>
        </g>
      );
    })}
  </g>
  <g class="qa-done" font-family="Sora Variable, Inter, sans-serif">
    <rect x={f(doneX - 135)} y={f(minY + 8)} width="270" height="46" rx="23" fill="#0a6cff" />
    <text x={f(doneX)} y={f(minY + 37)} text-anchor="middle" fill="#fff" font-size="18" font-weight="700">Minden alkatrész egy helyről</text>
  </g>
</svg>

<style>
  .hero-assembly { width: 100%; height: auto; overflow: visible; display: block; }
  @media (prefers-reduced-motion: reduce) {
    .hero-assembly :global(*) { animation: none !important; opacity: 1 !important; transform: none !important; }
    .hero-assembly :global(.qa-labels), .hero-assembly :global(.qa-done) { display: none; }
  }
</style>
