---
// Jost (a Quadris kérésére): csak a latin és latin-ext subset (a magyar ő/ű a latin-ext-ben van); a csomag fő CSS-e
// a cirill @font-face-t és woff2-t is beemelné a buildbe
import interLatin from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import interLatinExt from '@fontsource-variable/jost/files/jost-latin-ext-wght-normal.woff2?url';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { groups } from '../lib/catalog.js';
import { SITE, abs, absPage } from '../lib/site.js';

const { headerTheme = 'light', crumbs = null, back = null, title, image = '/brand/og-ponyvas.jpg', type = 'website', jsonLd = [], noindex = false, description = 'Alkatrészek jármű- és lószállító felépítmény gyártóknak: alváz- és padlóprofilok, ponyvarendszerek, zárak, zsanérok, sárvédők, rakományrögzítés. Kérjen ajánlatot online!' } = Astro.props;
// 'transparent': a főoldal videója fölé fekvő átlátszó fejléc ('dark' a korábbi név, azonos viselkedés)
const transparentHeader = headerTheme === 'transparent' || headerTheme === 'dark';
const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} – ${SITE.tagline}`;
const path = Astro.url.pathname;
const isActive = (prefix) => path === prefix || path.startsWith(prefix + '/');
const fontFace = (url, range) => `@font-face{font-family:'Jost Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${url}) format('woff2-variations');unicode-range:${range}}`;
// tartalék: Arial a Jost metrikáira igazítva (size-adjust stb.), így a betűcsere alig látszik, a menü nem ugrik
const fallbackFace = `@font-face{font-family:'Jost Fallback';src:local('Arial'),local('Helvetica Neue'),local('Liberation Sans');size-adjust:93.85%;ascent-override:114%;descent-override:40%;line-gap-override:0%}`;
const fontCss = fallbackFace +
  fontFace(interLatinExt, 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF') +
  fontFace(interLatin, 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD');
---
<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {(!SITE.indexable || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={absPage(path)} />
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interLatinExt} crossorigin />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absPage(path)} />
    <meta property="og:image" content={abs(image)} />
    {image === SITE.ogImage.path && <meta property="og:image:width" content={String(SITE.ogImage.width)} />}
    {image === SITE.ogImage.path && <meta property="og:image:height" content={String(SITE.ogImage.height)} />}
    {image === SITE.ogImage.path && <meta property="og:image:alt" content={SITE.ogImage.alt} />}
    <meta name="twitter:image" content={abs(image)} />
    <meta property="og:locale" content="hu_HU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <style is:inline set:html={fontCss}></style>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {transparentHeader && <link rel="preload" as="image" href="/video/quadris-ponyvas-poster.jpg" fetchpriority="high" />}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      '@id': abs('/#org'),
      name: SITE.name,
      legalName: SITE.legalName,
      url: abs('/'),
      logo: abs('/brand/quadris-ikon-512.png'),
      email: SITE.email,
      telephone: SITE.phone,
      taxID: SITE.taxNumber,
      foundingDate: String(SITE.foundingYear),
      address: { '@type': 'PostalAddress', streetAddress: SITE.seat.street, postalCode: SITE.seat.postalCode, addressLocality: SITE.seat.city, addressCountry: 'HU' },
    })} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...d })} />)}
  </head>
  <body id="top" class:list={[{ 'has-hero': transparentHeader }]}>
    <a class="skip-link" href="#main">Ugrás a tartalomra</a>
    <header class:list={['site-header', { transparent: transparentHeader }]}>
      <div class="container header-inner">
        <a class="logo" href="/" aria-label={`${SITE.name} – főoldal`}><span class="wordmark">QUADRIS</span></a>

        <nav class="main-nav" id="main-nav" aria-label="Fő menü">
          <a href="/rolunk" class:list={['nav-link', { active: isActive('/rolunk') }]}>Rólunk</a>
          <div class="nav-item has-mega">
            <a href="/termekek" class:list={['nav-link', { active: isActive('/termekek') || isActive('/termek') }]} aria-haspopup="true" aria-expanded="false" aria-controls="mega-termekek" data-mega-trigger>Termékek <Icon name="ChevronDown" size={16} /></a>
            <div class="mega" id="mega-termekek">
              <div class="mega-head">
                <span class="eyebrow">Termékcsoportok</span>
                <a href="/termekek" class="mega-all">Teljes katalógus →</a>
              </div>
              <div class="mega-grid">
                {groups.map((g) => (
                  <a href={`/termekek/${g.slug}`} class="mega-link">{g.name}</a>
                ))}
              </div>
            </div>
          </div>
          <a href="/kapcsolat" class:list={['nav-link', { active: isActive('/kapcsolat') }]}>Kapcsolat</a>
        </nav>

        <div class="header-actions">
          <form class="header-search" action="/kereses" method="get" role="search" autocomplete="off">
            <Icon name="Search" size={18} class="search-icon" />
            <input type="search" name="q" placeholder="Keressen terméknévre vagy cikkszámra…" aria-label="Termékkeresés" aria-autocomplete="list" aria-controls="search-suggest" />
            <div class="suggest" id="search-suggest" role="listbox" hidden></div>
          </form>
          <a href="/ajanlatkeres" class="btn btn-primary quote-btn" aria-label="Ajánlatkérő lista">
            <Icon name="ClipboardList" size={18} />
            <span class="quote-label">Ajánlatkérő</span>
            <span class="quote-count" data-quote-count hidden>0</span>
          </a>
          <button class="menu-toggle" type="button" aria-controls="main-nav" aria-expanded="false" aria-label="Menü">
            <Icon name="Menu" size={22} class="i-open" />
            <Icon name="X" size={22} class="i-close" />
          </button>
        </div>
      </div>
    </header>

    {crumbs && (
      <div class="crumbbar">
        <div class="container crumbbar-inner">
          {back && (
            <a class="back-btn" href={back.href} data-back title={`Vissza: ${back.label}`} aria-label={`Vissza: ${back.label}`}>
              <Icon name="ArrowLeft" size={18} /><span>Vissza</span>
            </a>
          )}
          <nav class="crumb-trail" aria-label="Morzsamenü">
            {crumbs.map(([name, url], i) => (
              <>
                {i > 0 && <span class="sep" aria-hidden="true">›</span>}
                <a href={url} class:list={{ current: i === crumbs.length - 1 }} data-crumb={i === crumbs.length - 1 ? 'last' : undefined} aria-current={i === crumbs.length - 1 ? 'page' : undefined}>{name}</a>
              </>
            ))}
            <span class="sep" aria-hidden="true" data-sub-sep hidden>›</span>
            <a class="current" data-sub-crumb hidden></a>
          </nav>
        </div>
      </div>
    )}
    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-main">
        <div class="footer-brand">
          <a href="/" class="footer-logo" aria-label={`${SITE.name} – főoldal`}><span class="wordmark">QUADRIS</span></a>
          <p class="footer-tagline">{SITE.tagline}</p>
          {SITE.address && <p class="footer-address">{SITE.address}</p>}
        </div>
        <div class="footer-col">
          <h4 class="footer-title">Elérhetőség</h4>
          <ul class="footer-list">
            {SITE.phone && <li><a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a></li>}
            {SITE.email && <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>}
            {SITE.openingHours && <li class="footer-muted">{SITE.openingHours}</li>}
            <li><a href="/kapcsolat">Üzenetküldés</a></li>
            <li><a href="/ajanlatkeres">Ajánlatkérő lista</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4 class="footer-title">Információk</h4>
          <ul class="footer-list">
            <li><a href="/termekek">Termékkatalógus</a></li>
            <li><a href="/rolunk">Rólunk</a></li>
            <li><a href="/impresszum">Impresszum</a></li>
            <li><a href="/adatkezeles">Adatkezelési tájékoztató</a></li>
            <li><a href="/adatkezeles#sutik">Sütik</a></li>
          </ul>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} {SITE.name} Minden jog fenntartva.</span>
        <span><span class="nowrap">Cégjegyzékszám: {SITE.companyRegNo}</span> · <span class="nowrap">Adószám: {SITE.taxNumber}</span></span>
      </div>
    </footer>

    <div class="toast" role="status" aria-live="polite" data-toast>
      <Icon name="CircleCheck" />
      <span data-toast-text></span>
      <a href="/ajanlatkeres" class="btn btn-ghost btn-sm">Megnézem</a>
    </div>
    <a href="#top" class="to-top" data-to-top aria-label="Vissza az oldal tetejére" title="Az oldal tetejére"><Icon name="ArrowUp" size={22} /></a>

    <script>
      import { quote } from '../scripts/quote.js';
      import { loadIndex, search } from '../scripts/search.js';

      // --- Ajánlatkérő számláló és gombok ---
      const countEls = document.querySelectorAll('[data-quote-count]');
      const syncButtons = () => {
        const items = quote.items();
        const slugs = new Set(items.map((i) => i.slug));
        countEls.forEach((el) => {
          el.textContent = String(items.length);
          el.hidden = items.length === 0;
        });
        document.querySelectorAll('[data-add-to-quote]').forEach((btn) => {
          const { slug } = JSON.parse(btn.dataset.addToQuote);
          const inQuote = slugs.has(slug);
          btn.classList.toggle('in-quote', inQuote);
          const label = btn.querySelector('.label');
          if (label) label.textContent = inQuote ? 'Hozzáadva' : 'Ajánlatkérőbe';
        });
      };
      syncButtons();
      window.addEventListener('quote:change', syncButtons);
      window.addEventListener('pageshow', syncButtons);

      const toast = document.querySelector('[data-toast]');
      let toastTimer;
      const showToast = (text) => {
        toast.querySelector('[data-toast-text]').textContent = text;
        toast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.remove('show'), 3500);
      };
      window.addEventListener('quote:toast', (e) => showToast(e.detail));

      document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-add-to-quote]');
        if (!btn) return;
        e.preventDefault();
        const base = JSON.parse(btn.dataset.addToQuote);
        if ((base.profile || base.variants) && !btn.dataset.qtyFrom) {
          location.href = `/termek/${base.slug}#${base.variants ? 'rendeles' : 'meretre'}`;
          return;
        }
        // a vevő által megadandó méret (pl. kért szélesség): méretenként külön tétel (a termékoldalra mutató
        // „page” mezővel), így több szélesség is felvehető, mindegyik a saját darabszámával
        const noteInput = btn.dataset.noteFrom ? document.querySelector(btn.dataset.noteFrom) : null;
        let product = JSON.parse(btn.dataset.addToQuote);
        if (noteInput) {
          const v = noteInput.value.trim();
          if (!v || (noteInput.type === 'number' && !(Number(v) > 0))) {
            noteInput.focus();
            noteInput.closest('[data-note-field]')?.classList.add('invalid');
            return;
          }
          noteInput.closest('[data-note-field]')?.classList.remove('invalid');
          const label = `${noteInput.dataset.notePrefix ?? ''}${v}${noteInput.dataset.noteSuffix ?? ''}`;
          product = { ...product, slug: `${product.slug}~${v}`, page: product.slug, name: `${product.name}, ${label}` };
        } else if (quote.has(product.slug)) {
          location.href = '/ajanlatkeres';
          return;
        }
        const qtyInput = btn.dataset.qtyFrom ? document.querySelector(btn.dataset.qtyFrom) : null;
        quote.add(product, qtyInput ? Number(qtyInput.value) : 1);
        showToast(`Hozzáadva az ajánlatkérőhöz: ${product.name}`);
      });

      // --- Fejléc: görgetési állapot (átlátszó → fehér üveg), mobil menü, mega menü ---
      const header = document.querySelector('.site-header');
      const toggle = document.querySelector('.menu-toggle');
      const setMenu = (open) => {
        header.classList.toggle('menu-open', open);
        toggle.setAttribute('aria-expanded', String(open));
      };
      toggle.addEventListener('click', () => setMenu(!header.classList.contains('menu-open')));
      // kattintás a fejlécen (panelen) kívül: zár
      document.addEventListener('click', (e) => {
        if (header.classList.contains('menu-open') && !header.contains(e.target)) setMenu(false);
      });
      // asztali méretre váltva a nyitott mobil menü állapota ne ragadjon be (átlátszó hero-fejléc)
      const mobileMq = matchMedia('(max-width: 960px)');
      mobileMq.addEventListener('change', () => { if (!mobileMq.matches) setMenu(false); });
      const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      const megaItem = document.querySelector('.has-mega');
      const megaTrigger = megaItem.querySelector('[data-mega-trigger]');
      // mobilon a mega statikusan, mindig kibontva látszik a menüpanelben → aria-expanded="true"
      const syncMega = () => megaTrigger.setAttribute('aria-expanded', String(mobileMq.matches || megaItem.classList.contains('mega-open') || megaItem.matches(':hover, :focus-within')));
      ['mouseenter', 'mouseleave', 'focusin', 'focusout'].forEach((ev) => megaItem.addEventListener(ev, () => requestAnimationFrame(syncMega)));
      mobileMq.addEventListener('change', syncMega);
      syncMega();
      // a „Termékek” felirat nem a teljes katalógusra visz, hanem a csoportok lenyíló listáját nyitja
      // (a teljes katalógus a listában a „Teljes katalógus →” linken érhető el)
      megaTrigger.addEventListener('click', (e) => {
        e.preventDefault();
        if (mobileMq.matches) return;
        megaItem.classList.toggle('mega-open');
        requestAnimationFrame(syncMega);
      });
      document.addEventListener('click', (e) => {
        if (!megaItem.contains(e.target)) { megaItem.classList.remove('mega-open'); requestAnimationFrame(syncMega); }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        if (header.classList.contains('menu-open')) {
          setMenu(false);
          toggle.focus();
        } else if (!mobileMq.matches && (megaItem.matches(':focus-within') || megaItem.classList.contains('mega-open'))) {
          // asztali mega: Escape-re a fókusz a triggerre kerül, majd elhagyja, így a :focus-within menü bezárul
          megaItem.classList.remove('mega-open');
          megaTrigger.focus();
          megaTrigger.blur();
          requestAnimationFrame(syncMega);
        }
      });

      // --- Azonnali kereső a fejlécben ---
      const form = document.querySelector('.header-search');
      const input = form.querySelector('input');
      // keskeny kijelzőn a hosszú helyőrző nem fér ki
      const longPh = input.placeholder;
      const phMq = matchMedia('(max-width: 560px)');
      const syncPh = () => { input.placeholder = phMq.matches ? 'Keresés…' : longPh; };
      syncPh();
      phMq.addEventListener('change', syncPh);
      const box = form.querySelector('.suggest');
      const escapeHtml = (s) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
      let active = -1;

      const render = async () => {
        const q = input.value.trim();
        if (q.length < 2) {
          box.hidden = true;
          return;
        }
        let index;
        try {
          index = await loadIndex();
        } catch {
          return;
        }
        if (input.value.trim() !== q) return;
        const hits = search(index, q, 8);
        active = -1;
        box.innerHTML = hits.length
          ? hits.map((p) => `<a role="option" href="/termek/${p.slug}"><span class="s-name">${escapeHtml(p.name)}</span><span class="s-meta">${p.code ? escapeHtml(p.code) + ' · ' : ''}${escapeHtml(p.groupName)}</span></a>`).join('') +
            `<a class="s-all" href="/kereses?q=${encodeURIComponent(q)}">Összes találat megtekintése →</a>`
          : `<div class="s-empty">Nincs találat. <a href="/ajanlatkeres#egyedi">Kérje egyedi tételként →</a></div>`;
        box.hidden = false;
      };
      input.addEventListener('input', render);
      input.addEventListener('focus', () => { loadIndex().catch(() => {}); render(); });
      input.addEventListener('keydown', (e) => {
        const links = [...box.querySelectorAll('a')];
        if (box.hidden || !links.length) return;
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          active = (active + (e.key === 'ArrowDown' ? 1 : -1) + links.length) % links.length;
          links.forEach((l, i) => l.classList.toggle('active', i === active));
        } else if (e.key === 'Enter' && active >= 0) {
          e.preventDefault();
          location.href = links[active].href;
        } else if (e.key === 'Escape') {
          box.hidden = true;
        }
      });
      document.addEventListener('click', (e) => {
        if (!form.contains(e.target)) box.hidden = true;
      });

      // --- „Fel” nyíl: kis görgetés után jelenik meg; ha van hero (főoldal), csak annak teljes elhagyása után ---
      const toTop = document.querySelector('[data-to-top]');
      const hero = document.querySelector('.hero-video');
      const topThreshold = () => (hero ? Math.max(400, hero.getBoundingClientRect().height - 24) : 400);
      const syncTop = () => toTop.classList.toggle('show', window.scrollY > topThreshold());
      window.addEventListener('scroll', syncTop, { passive: true });
      syncTop();
      toTop.addEventListener('click', (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
        history.replaceState(null, '', location.pathname + location.search);
      });
    </script>
  </body>
</html>

<style>
  .skip-link { position: absolute; left: -999px; top: 8px; z-index: 200; background: var(--navy); color: #fff; padding: 8px 14px; border-radius: var(--radius-btn); }
  .skip-link:focus { left: 8px; }

  /* Morzsamenü-sáv: a fejléc alatt, görgetéskor is látható */
  .crumbbar {
    position: sticky; top: var(--header-h); z-index: 40;
    background: rgba(255, 255, 255, 0.92); backdrop-filter: saturate(140%) blur(12px); -webkit-backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .crumbbar-inner { display: flex; align-items: center; gap: 14px; min-height: 48px; }
  .back-btn {
    flex: none; display: inline-flex; align-items: center; gap: 6px; height: 34px; padding: 0 14px 0 10px;
    border: 1px solid var(--line-strong); border-radius: var(--radius-btn); background: #fff; color: var(--navy);
    font-size: 0.88rem; font-weight: 600; text-decoration: none;
  }
  .back-btn:hover { border-color: var(--accent); color: var(--accent); }
  .crumb-trail { display: flex; align-items: center; gap: 8px; min-width: 0; overflow: hidden; white-space: nowrap; font-size: 0.9rem; }
  .crumb-trail a { color: var(--muted); text-decoration: none; overflow: hidden; text-overflow: ellipsis; }
  .crumb-trail a:hover { color: var(--accent); }
  .crumb-trail a.current { color: var(--navy); font-weight: 600; }
  .crumb-trail .sep { color: var(--line-strong); flex: none; }
  @media (max-width: 640px) {
    .back-btn span { display: none; }
    .back-btn { padding: 0 9px; }
    .crumb-trail { font-size: 0.84rem; gap: 6px; }
    /* keskeny kijelzőn csak a szülő és az aktuális szint látszik (a vissza-gomb megvan), hogy ne csonkolódjon minden elem ellipszissel */
    .crumb-trail a:not(:nth-last-child(-n+5)), .crumb-trail .sep:not(:nth-last-child(-n+5)) { display: none; }
  }

  /* „Fel” nyíl */
  .to-top {
    position: fixed; right: 20px; bottom: 20px; z-index: 90; width: 48px; height: 48px; border-radius: 50%;
    display: grid; place-items: center; background: var(--accent); color: #fff; box-shadow: 0 10px 24px -10px rgba(14, 79, 85, 0.7);
    opacity: 0; pointer-events: none; transform: translateY(12px); transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .to-top.show { opacity: 1; pointer-events: auto; transform: none; }
  .to-top:hover { background: var(--accent-2); }
  :global(.toast.show) ~ .to-top { bottom: 92px; }

  /* ---------- Fejléc: fixed üvegsáv két állapottal ----------
     alap (fehér üveg): belső oldalak, és a főoldal görgetve / nyitott mobil menüvel
     átlátszó: a főoldal teteje (.transparent), a videó fölött fehér szöveggel        */
  .site-header {
    --hd-bg: rgba(246, 243, 236, 0.86);
