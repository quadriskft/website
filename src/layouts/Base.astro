---
import '@fontsource-variable/inter';
import '@fontsource-variable/sora';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { groups, GROUP_META } from '../lib/catalog.js';
import { SITE } from '../lib/site.js';

const { title, description = 'Alkatrészek jármű- és lószállító felépítmény gyártóknak: alváz- és padlóprofilok, ponyvarendszerek, zárak, zsanérok, sárvédők, rakományrögzítés. Kérjen ajánlatot online!' } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} – ${SITE.tagline}`;
const path = Astro.url.pathname;
const isActive = (prefix) => path === prefix || path.startsWith(prefix + '/');
---
<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!SITE.indexable && <meta name="robots" content="noindex, nofollow" />}
    {SITE.url && <link rel="canonical" href={new URL(path, SITE.url)} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="hu_HU" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: SITE.name,
      legalName: SITE.legalName,
      email: SITE.email,
      telephone: SITE.phone,
      taxID: SITE.taxNumber,
      address: { '@type': 'PostalAddress', streetAddress: 'Tengely utca 8.', postalCode: '2220', addressLocality: 'Vecsés', addressCountry: 'HU' },
      ...(SITE.url && { url: SITE.url, logo: new URL('/brand/quadris-logo.svg', SITE.url).href }),
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">Ugrás a tartalomra</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href="/" aria-label={`${SITE.name} – főoldal`}>
          <img src="/brand/quadris-felirat.svg" alt={SITE.name} width="220" height="64" />
        </a>

        <nav class="main-nav" id="main-nav" aria-label="Fő menü">
          <div class="nav-item has-mega">
            <a href="/termekek" class:list={['nav-link', { active: isActive('/termekek') || isActive('/termek') }]}>Termékek <Icon name="ChevronDown" size={16} /></a>
            <div class="mega">
              <div class="mega-grid">
                {groups.map((g) => (
                  <a href={`/termekek/${g.slug}`} class="mega-link">
                    <Icon name={GROUP_META[g.slug]?.icon} size={18} />
                    <span>{g.name}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
          <a href="/loszallito-felepitmenyek" class:list={['nav-link', { active: isActive('/loszallito-felepitmenyek') }]}>Lószállító gyártóknak</a>
          <a href="/kapcsolat" class:list={['nav-link', { active: isActive('/kapcsolat') }]}>Kapcsolat</a>
        </nav>

        <div class="header-actions">
          <form class="header-search" action="/kereses" method="get" role="search" autocomplete="off">
            <Icon name="Search" size={18} class="search-icon" />
            <input type="search" name="q" placeholder="Keresés: név vagy cikkszám" aria-label="Termékkeresés" aria-autocomplete="list" aria-controls="search-suggest" />
            <div class="suggest" id="search-suggest" role="listbox" hidden></div>
          </form>
          <a href="/ajanlatkeres" class="quote-btn" aria-label="Ajánlatkérő lista">
            <Icon name="ClipboardList" size={20} />
            <span class="quote-label">Ajánlatkérő</span>
            <span class="quote-count" data-quote-count hidden>0</span>
          </a>
          <button class="menu-toggle" type="button" aria-controls="main-nav" aria-expanded="false" aria-label="Menü">
            <Icon name="Menu" size={22} class="i-open" />
            <Icon name="X" size={22} class="i-close" />
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <img src="/brand/quadris-logo-feher.svg" alt={SITE.name} width="220" height="56" loading="lazy" />
          <p class="muted">Alkatrészek, profilok és kiegészítők jármű- és lószállító felépítmény gyártóknak – egy helyről, szakértő támogatással.</p>
          <a href="/ajanlatkeres" class="btn btn-primary btn-sm"><Icon name="Send" /> Ajánlatot kérek</a>
        </div>
        <div>
          <h4>Termékcsoportok</h4>
          <ul class="footer-links cols">
            {groups.map((g) => <li><a href={`/termekek/${g.slug}`}>{g.name}</a></li>)}
          </ul>
        </div>
        <div>
          <h4>Kapcsolat</h4>
          <ul class="footer-links">
            <li><strong>{SITE.name}</strong></li>
            {SITE.address && <li>{SITE.address}</li>}
            {SITE.phone && <li><a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a></li>}
            {SITE.email && <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>}
            {SITE.openingHours && <li class="muted">{SITE.openingHours}</li>}
            <li><a href="/kapcsolat">Üzenetküldés</a></li>
            <li><a href="/loszallito-felepitmenyek">Lószállító felépítmény gyártóknak</a></li>
          </ul>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} {SITE.name} Minden jog fenntartva.</span>
        <span>Cégjegyzékszám: {SITE.companyRegNo} · Adószám: {SITE.taxNumber}</span>
      </div>
    </footer>

    <div class="toast" role="status" aria-live="polite" data-toast>
      <Icon name="CircleCheck" />
      <span data-toast-text></span>
      <a href="/ajanlatkeres" class="btn btn-ghost btn-sm">Megnézem</a>
    </div>

    <script>
      import { quote } from '../scripts/quote.js';
      import { loadIndex, search } from '../scripts/search.js';

      // --- Ajánlatkérő számláló és gombok ---
      const countEls = document.querySelectorAll('[data-quote-count]');
      const syncButtons = () => {
        const items = quote.items();
        const slugs = new Set(items.map((i) => i.slug));
        countEls.forEach((el) => {
          el.textContent = String(items.length);
          el.hidden = items.length === 0;
        });
        document.querySelectorAll('[data-add-to-quote]').forEach((btn) => {
          const { slug } = JSON.parse(btn.dataset.addToQuote);
          const inQuote = slugs.has(slug);
          btn.classList.toggle('in-quote', inQuote);
          const label = btn.querySelector('.label');
          if (label) label.textContent = inQuote ? 'Hozzáadva' : 'Ajánlatkérőbe';
        });
      };
      syncButtons();
      window.addEventListener('quote:change', syncButtons);
      window.addEventListener('pageshow', syncButtons);

      const toast = document.querySelector('[data-toast]');
      let toastTimer;
      const showToast = (text) => {
        toast.querySelector('[data-toast-text]').textContent = text;
        toast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.remove('show'), 3500);
      };
      window.addEventListener('quote:toast', (e) => showToast(e.detail));

      document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-add-to-quote]');
        if (!btn) return;
        e.preventDefault();
        const product = JSON.parse(btn.dataset.addToQuote);
        if (quote.has(product.slug)) {
          location.href = '/ajanlatkeres';
          return;
        }
        const qtyInput = btn.dataset.qtyFrom ? document.querySelector(btn.dataset.qtyFrom) : null;
        quote.add(product, qtyInput ? Number(qtyInput.value) : 1);
        showToast(`Hozzáadva az ajánlatkérőhöz: ${product.name}`);
      });

      // --- Mobil menü ---
      const header = document.querySelector('.site-header');
      const toggle = document.querySelector('.menu-toggle');
      toggle.addEventListener('click', () => {
        const open = header.classList.toggle('menu-open');
        toggle.setAttribute('aria-expanded', String(open));
      });
      const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // --- Azonnali kereső a fejlécben ---
      const form = document.querySelector('.header-search');
      const input = form.querySelector('input');
      const box = form.querySelector('.suggest');
      const escapeHtml = (s) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
      let active = -1;

      const render = async () => {
        const q = input.value.trim();
        if (q.length < 2) {
          box.hidden = true;
          return;
        }
        let index;
        try {
          index = await loadIndex();
        } catch {
          return;
        }
        if (input.value.trim() !== q) return;
        const hits = search(index, q, 8);
        active = -1;
        box.innerHTML = hits.length
          ? hits.map((p) => `<a role="option" href="/termek/${p.slug}"><span class="s-name">${escapeHtml(p.name)}</span><span class="s-meta">${p.code ? escapeHtml(p.code) + ' · ' : ''}${escapeHtml(p.groupName)}</span></a>`).join('') +
            `<a class="s-all" href="/kereses?q=${encodeURIComponent(q)}">Összes találat megtekintése →</a>`
          : `<div class="s-empty">Nincs találat. <a href="/ajanlatkeres#egyedi">Kérje egyedi tételként →</a></div>`;
        box.hidden = false;
      };
      input.addEventListener('input', render);
      input.addEventListener('focus', () => { loadIndex().catch(() => {}); render(); });
      input.addEventListener('keydown', (e) => {
        const links = [...box.querySelectorAll('a')];
        if (box.hidden || !links.length) return;
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          active = (active + (e.key === 'ArrowDown' ? 1 : -1) + links.length) % links.length;
          links.forEach((l, i) => l.classList.toggle('active', i === active));
        } else if (e.key === 'Enter' && active >= 0) {
          e.preventDefault();
          location.href = links[active].href;
        } else if (e.key === 'Escape') {
          box.hidden = true;
        }
      });
      document.addEventListener('click', (e) => {
        if (!form.contains(e.target)) box.hidden = true;
      });
    </script>
  </body>
</html>

<style>
  .skip-link { position: absolute; left: -999px; top: 8px; z-index: 200; background: var(--accent); color: #000; padding: 8px 14px; border-radius: 8px; }
  .skip-link:focus { left: 8px; }

  .site-header {
    position: sticky; top: 0; z-index: 50; height: var(--header-h);
    background: rgba(255, 255, 255, 0.86); backdrop-filter: saturate(160%) blur(16px); -webkit-backdrop-filter: saturate(160%) blur(16px);
    border-bottom: 1px solid var(--line); transition: box-shadow 0.2s ease, background 0.2s ease;
  }
  .site-header.scrolled { background: rgba(255, 255, 255, 0.96); box-shadow: 0 6px 20px -14px rgba(11, 31, 58, 0.4); }
  .header-inner { height: 100%; display: flex; align-items: center; gap: 28px; }
  .logo { flex: none; display: flex; }
  .logo img { height: 58px; width: auto; }

  .main-nav { display: flex; align-items: center; gap: 4px; }
  .nav-link {
    display: inline-flex; align-items: center; gap: 4px; padding: 8px 14px; border-radius: 999px;
    color: var(--text-2); font-weight: 500; font-size: 0.95rem; text-decoration: none !important; white-space: nowrap;
  }
  .nav-link:hover, .nav-link.active { color: var(--text); background: var(--surface-3); }
  .nav-link.active { color: var(--accent); }
  .nav-item { position: relative; }
  .mega {
    position: absolute; top: calc(100% + 10px); left: -120px; width: min(760px, 90vw);
    background: #fff; border: 1px solid var(--line);
    border-radius: var(--radius); box-shadow: var(--shadow); padding: 14px;
    opacity: 0; visibility: hidden; transform: translateY(6px); transition: all 0.18s ease;
  }
  .mega::before { content: ''; position: absolute; left: 0; right: 0; top: -14px; height: 14px; }
  .has-mega:hover .mega, .has-mega:focus-within .mega { opacity: 1; visibility: visible; transform: none; }
  .mega-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; }
  .mega-link { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 10px; color: var(--text-2); font-size: 0.92rem; text-decoration: none !important; }
  .mega-link:hover { background: var(--accent-soft); color: var(--text); }
  .mega-link :global(svg) { color: var(--accent); flex: none; }

  .header-actions { margin-left: auto; display: flex; align-items: center; gap: 12px; }
  .header-search { position: relative; width: clamp(200px, 24vw, 340px); }
  .header-search :global(.search-icon) { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--muted); pointer-events: none; }
  .header-search input {
    width: 100%; height: 44px; padding: 0 14px 0 40px; border-radius: 999px; border: 1px solid var(--line-strong);
    background: var(--surface-2); color: var(--text); font-size: 0.92rem;
  }
  .header-search input:focus { outline: none; border-color: var(--accent); background: #fff; box-shadow: 0 0 0 4px rgba(10, 108, 255, 0.1); }
  .suggest {
    position: absolute; top: calc(100% + 8px); left: 0; width: max(100%, 420px); max-width: calc(100vw - 32px);
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: var(--shadow); padding: 6px; z-index: 60;
  }
  .suggest :global(a) { display: flex; flex-direction: column; padding: 9px 12px; border-radius: 10px; color: var(--text); text-decoration: none; }
  .suggest :global(a:hover), .suggest :global(a.active) { background: var(--accent-soft); }
  .suggest :global(.s-name) { font-size: 0.92rem; font-weight: 500; }
  .suggest :global(.s-meta) { font-size: 0.78rem; color: var(--muted); }
  .suggest :global(.s-all) { color: var(--accent); font-size: 0.88rem; font-weight: 600; border-top: 1px solid var(--line); border-radius: 0 0 10px 10px; margin-top: 4px; }
  .suggest :global(.s-empty) { padding: 12px; font-size: 0.9rem; color: var(--muted); }

  .quote-btn {
    position: relative; display: inline-flex; align-items: center; gap: 8px; height: 42px; padding: 0 16px;
    border-radius: 999px; background: var(--gradient); color: #fff; font-weight: 650; font-size: 0.92rem;
    text-decoration: none !important; box-shadow: 0 10px 22px -12px rgba(10, 108, 255, 0.9); white-space: nowrap;
  }
  .quote-count {
    min-width: 22px; height: 22px; padding: 0 6px; border-radius: 999px; background: #fff; color: var(--accent);
    font-size: 0.78rem; font-weight: 700; display: inline-grid; place-items: center;
  }
  .quote-count[hidden] { display: none; }
  .menu-toggle { display: none; width: 44px; height: 44px; border-radius: 12px; border: 1px solid var(--line-strong); background: #fff; color: var(--text); cursor: pointer; place-items: center; }
  .menu-toggle :global(.i-close) { display: none; }
  .menu-open .menu-toggle :global(.i-open) { display: none; }
  .menu-open .menu-toggle :global(.i-close) { display: block; }

  @media (max-width: 1100px) {
    .quote-label { display: none; }
    .header-inner { gap: 16px; }
  }
  @media (max-width: 960px) {
    :root { --header-h: 64px; }
    .logo img { height: 42px; }
    .menu-toggle { display: grid; }
    .main-nav {
      position: fixed; inset: var(--header-h) 0 auto 0; max-height: calc(100vh - var(--header-h)); overflow-y: auto;
      flex-direction: column; align-items: stretch; gap: 2px; padding: 12px 16px 20px;
      background: #fff; border-bottom: 1px solid var(--line); box-shadow: var(--shadow);
      transform: translateY(-8px); opacity: 0; visibility: hidden; transition: all 0.2s ease;
    }
    .menu-open .main-nav { transform: none; opacity: 1; visibility: visible; }
    .nav-link { padding: 12px 14px; font-size: 1rem; }
    .mega { position: static; width: auto; opacity: 1; visibility: visible; transform: none; background: transparent; border: 0; box-shadow: none; padding: 0 0 8px 8px; }
    .mega-grid { grid-template-columns: 1fr; }
    .header-search { width: auto; flex: 1; min-width: 0; }
    .header-actions { flex: 1; justify-content: flex-end; }
    .suggest { position: fixed; left: 16px; right: 16px; width: auto; top: calc(var(--header-h) - 4px); }
  }
  @media (max-width: 560px) {
    .logo img { height: 34px; }
    .header-actions { gap: 8px; }
    .quote-btn { padding: 0 12px; }
  }

  .site-footer { background: var(--navy); color: #c7d4e6; margin-top: 56px; }
  .footer-grid { display: grid; grid-template-columns: 1.1fr 1.6fr 0.9fr; gap: 40px; padding-top: 56px; padding-bottom: 40px; }
  .footer-brand img { height: 84px; width: auto; margin-bottom: 18px; }
  .footer-brand p { max-width: 340px; font-size: 0.93rem; }
  .site-footer h4 { font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: #8fa6c4; margin-bottom: 14px; }
  .site-footer .muted { color: #9fb2cb; }
  .site-footer strong { color: #fff; }
  .footer-links { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 0.92rem; }
  .footer-links.cols { grid-template-columns: repeat(2, 1fr); column-gap: 24px; }
  .footer-links a { color: #d6e1f0; }
  .footer-links a:hover { color: #fff; }
  .footer-bottom { border-top: 1px solid rgba(255, 255, 255, 0.12); padding-top: 18px; padding-bottom: 24px; font-size: 0.85rem; color: #8fa6c4; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; }
  @media (max-width: 860px) {
    .footer-grid { grid-template-columns: 1fr; gap: 28px; }
    .footer-links.cols { grid-template-columns: 1fr 1fr; }
  }
</style>
