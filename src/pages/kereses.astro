---
import Base from '../layouts/Base.astro';
import { products, mainImage } from '../lib/catalog.js';

// A kereséshez szükséges adatok beágyazva, így nem kell szerver.
const index = products.map((p) => ({
  slug: p.slug,
  name: p.name,
  sku: p.sku,
  manufacturer: p.manufacturer,
  image: mainImage(p),
}));
---
<Base title="Keresés">
  <h1>Keresés</h1>
  <p id="search-summary" class="muted"></p>
  <ul id="search-results" class="product-grid"></ul>

  <script id="search-index" type="application/json" set:html={JSON.stringify(index)}></script>
  <script>
    const normalize = (s) => (s ?? '').toString().toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    const index = JSON.parse(document.getElementById('search-index').textContent);
    const q = new URLSearchParams(location.search).get('q')?.trim() ?? '';
    const input = document.querySelector('.search input');
    if (input) input.value = q;

    const summary = document.getElementById('search-summary');
    const list = document.getElementById('search-results');
    const terms = normalize(q).split(/\s+/).filter(Boolean);

    if (terms.length === 0) {
      summary.textContent = 'Írj be egy terméknevet, gyártót vagy cikkszámot.';
    } else {
      const hits = index.filter((p) => {
        const text = normalize(`${p.name} ${p.sku} ${p.manufacturer}`);
        return terms.every((t) => text.includes(t));
      });
      summary.textContent = `${hits.length} találat erre: „${q}”`;
      for (const p of hits) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.className = 'card';
        a.href = `/termek/${p.slug}`;
        const img = document.createElement('img');
        img.src = p.image;
        img.alt = p.name;
        img.loading = 'lazy';
        img.style.cssText = 'aspect-ratio:4/3;object-fit:contain;width:100%;background:var(--color-bg-soft);border-radius:4px';
        const h3 = document.createElement('h3');
        h3.textContent = p.name;
        const meta = document.createElement('p');
        meta.className = 'muted';
        meta.style.margin = '0';
        meta.textContent = `${p.manufacturer} · Cikkszám: ${p.sku}`;
        a.append(img, h3, meta);
        li.append(a);
        list.append(li);
      }
    }
  </script>
</Base>
