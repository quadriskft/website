---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../lib/site.js';
---
<Base title="Ajánlatkérés" description="Állítsa össze az ajánlatkérő listáját, és küldje el egy kattintással a Quadris Kft.-nek.">
  <section class="page-head quote-head">
    <div class="container">
      <h1>Ajánlatkérő lista</h1>
      <p class="lead">Ellenőrizze a tételeket, adja meg az elérhetőségét, és küldje el – hamarosan ajánlattal jelentkezünk.</p>
    </div>
  </section>

  <div class="container quote-layout" id="quote-app">
    <div class="items-col">
      <div class="card items-card">
        <div class="items-head">
          <h2>Tételek <span class="muted" data-count></span></h2>
          <button type="button" class="link-btn" data-clear hidden><Icon name="Trash2" size={16} /> Lista ürítése</button>
        </div>
        <ul class="items" data-items></ul>
        <div class="empty-state" data-empty>
          <Icon name="ClipboardList" size={28} />
          <p><strong>Az ajánlatkérő lista üres.</strong></p>
          <p class="muted">Az „Ajánlatkérőbe” gombbal adhat hozzá termékeket a katalógusból.</p>
          <a href="/termekek" class="btn btn-primary btn-sm">Termékkatalógus <Icon name="ArrowRight" /></a>
        </div>
      </div>

      <form class="card custom-card" id="egyedi" data-custom>
        <h2><Icon name="Sparkles" size={18} /> Egyedi tétel hozzáadása</h2>
        <p class="muted">Nem találja? Írja le (méret, anyag, gyártó, cikkszám) – beszerezzük.</p>
        <div class="custom-row">
          <div class="field grow">
            <label for="custom-name">Megnevezés / leírás</label>
            <input id="custom-name" name="name" required maxlength="300" placeholder="pl. 25 mm-es ponyvás oldalfal profil, 6 m" />
          </div>
          <div class="field qty-field">
            <label for="custom-qty">Mennyiség</label>
            <input id="custom-qty" name="qty" type="number" min="1" value="1" inputmode="numeric" />
          </div>
          <button class="btn btn-ghost" type="submit"><Icon name="Plus" /> Hozzáadás</button>
        </div>
      </form>
    </div>

    <form class="card form-card" data-form novalidate>
      <h2>Elérhetőség</h2>
      <div class="form-grid">
        <div class="field"><label for="f-name">Név *</label><input id="f-name" name="name" required autocomplete="name" maxlength="120" /></div>
        <div class="field"><label for="f-company">Cégnév *</label><input id="f-company" name="company" required autocomplete="organization" maxlength="160" /></div>
        <div class="field"><label for="f-email">E-mail *</label><input id="f-email" name="email" type="email" required autocomplete="email" maxlength="160" /></div>
        <div class="field"><label for="f-phone">Telefon *</label><input id="f-phone" name="phone" type="tel" required autocomplete="tel" maxlength="40" /></div>
        <div class="field full"><label for="f-msg">Megjegyzés</label><textarea id="f-msg" name="message" maxlength="3000" placeholder="Határidő, szállítási cím / igény, egyéb kérés…"></textarea></div>
        <div class="hp" aria-hidden="true"><label>Weboldal<input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <label class="consent full"><input type="checkbox" name="consent" required /> <span>Hozzájárulok, hogy a {SITE.name} az ajánlatkérés teljesítése céljából kezelje a megadott adataimat. Részletek az <a href="/adatkezeles" target="_blank">adatkezelési tájékoztatóban</a>.</span></label>
      </div>
      <p class="form-error" data-error role="alert" hidden></p>
      <button class="btn btn-primary submit" type="submit" data-submit><Icon name="Send" /> <span data-submit-label>Ajánlatkérés elküldése</span></button>
      <div class="alt-actions">
        <button type="button" class="link-btn" data-print><Icon name="Printer" size={16} /> Lista nyomtatása / PDF</button>
        <button type="button" class="link-btn" data-copy-list><Icon name="Copy" size={16} /> Lista másolása</button>
      </div>
    </form>

    <div class="card success" data-success hidden>
      <Icon name="CircleCheck" size={48} />
      <h2>Köszönjük, megkaptuk az ajánlatkérését!</h2>
      <p class="muted">Kollégáink feldolgozzák a listát, és hamarosan jelentkeznek az ajánlattal a megadott e-mail címen.</p>
      <a href="/termekek" class="btn btn-ghost">Vissza a katalógushoz</a>
    </div>
  </div>
</Base>

<script define:vars={{ contactEmail: SITE.email }}>
  window.__QUADRIS_EMAIL = contactEmail;
</script>

<script>
  import { quote, clampQty, clampLen, normalizeCuts, cutsText } from '../scripts/quote.js';

  const $ = (sel) => document.querySelector(sel);
  const list = $('[data-items]');
  const emptyState = $('[data-empty]');
  const countEl = $('[data-count]');
  const clearBtn = $('[data-clear]');
  const form = $('[data-form]');
  const errorEl = $('[data-error]');
  const submitBtn = $('[data-submit]');
  const submitLabel = $('[data-submit-label]');
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);

  const icon = {
    minus: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/></svg>',
    plus: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5v14"/></svg>',
    trash: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>',
    box: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><path d="m3.3 7 8.7 5 8.7-5"/></svg>',
    spark: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3l1.9 5.8L20 11l-6.1 2.2L12 19l-1.9-5.8L4 11l6.1-2.2z"/></svg>',
  };

  const cutRow = (len = '', pcs = 1) => `<div class="cut-row">
      <input class="input" type="number" min="1" max="30000" inputmode="numeric" placeholder="pl. 6000" aria-label="Hossz (mm)" data-cut-len value="${esc(len)}">
      <input class="input" type="number" min="1" max="99999" inputmode="numeric" aria-label="Darab" data-cut-pcs value="${esc(pcs)}">
      <button type="button" class="cut-del" data-cut-del aria-label="Méret törlése">${icon.trash}</button>
    </div>`;
  const readCuts = (li) => [...li.querySelectorAll('.cut-row')].map((r) => ({ len: r.querySelector('[data-cut-len]').value, pcs: r.querySelector('[data-cut-pcs]').value }));

  const render = () => {
    const items = quote.items();
    countEl.textContent = items.length ? `(${items.length})` : '';
    emptyState.hidden = items.length > 0;
    clearBtn.hidden = items.length === 0;
    list.innerHTML = items
      .map(
        (i) => `<li class="item" data-slug="${esc(i.slug)}">
        <div class="thumb${i.image ? ' has-img' : ''}">${i.image ? `<img src="${esc(i.image)}" alt="">` : i.custom ? icon.spark : icon.box}</div>
        <div class="item-main">
          ${i.custom ? `<span class="item-name">${esc(i.name)}</span><span class="tag">Egyedi tétel</span>` : `<a class="item-name" href="/termek/${esc(i.slug)}">${esc(i.name)}</a>`}
          ${i.code ? `<span class="muted item-code">Cikkszám: ${esc(i.code)}</span>` : ''}
          ${i.cuts?.length ? `<div class="cuts" data-cuts>
            <div class="cuts-head"><span>Hossz [mm]</span><span>Darab</span><span></span></div>
            ${i.cuts.map((c) => cutRow(c.len, c.pcs)).join('')}
            <button type="button" class="cuts-add" data-cut-add>${icon.plus} Másik méret</button>
          </div>` : ''}
          <input class="note input" data-note placeholder="Megjegyzés a tételhez (pl. hossz, szín)…" value="${esc(i.note)}" maxlength="300">
        </div>
        <div class="item-side">
          ${i.cuts?.length ? `<div class="qty-total"><span><strong>${i.qty}</strong> db</span><small>${(i.cuts.reduce((n, c) => n + c.len * c.pcs, 0) / 1000).toLocaleString('hu-HU', { maximumFractionDigits: 2 })} fm</small></div>` : `<div class="qty">
            <button type="button" data-step="-1" aria-label="Kevesebb">${icon.minus}</button>
            <input type="number" min="1" value="${i.qty}" data-qty inputmode="numeric" aria-label="Mennyiség">
            <button type="button" data-step="1" aria-label="Több">${icon.plus}</button>
          </div>`}
          <button type="button" class="remove" data-remove aria-label="Tétel törlése">${icon.trash}</button>
        </div>
      </li>`,
      )
      .join('');
  };

  render();
  window.addEventListener('quote:change', (e) => {
    // gépelés közben ne rajzoljuk újra (fókusz megtartása)
    if (!list.contains(document.activeElement)) render();
    else countEl.textContent = quote.count() ? `(${quote.count()})` : '';
  });

  list.addEventListener('click', (e) => {
    const li = e.target.closest('.item');
    if (!li) return;
    const slug = li.dataset.slug;
    const step = e.target.closest('[data-step]');
    if (step) {
      const input = li.querySelector('[data-qty]');
      input.value = String(clampQty(Number(input.value) + Number(step.dataset.step)));
      quote.update(slug, { qty: Number(input.value) });
    }
    if (e.target.closest('[data-remove]')) {
      quote.remove(slug);
      render();
    }
    if (e.target.closest('[data-cut-add]')) {
      e.target.closest('[data-cut-add]').insertAdjacentHTML('beforebegin', cutRow('', 1));
      li.querySelectorAll('[data-cut-len]').item(li.querySelectorAll('[data-cut-len]').length - 1).focus();
    }
    if (e.target.closest('[data-cut-del]')) {
      if (li.querySelectorAll('.cut-row').length > 1) {
        e.target.closest('.cut-row').remove();
        quote.update(slug, { cuts: readCuts(li) });
        render();
      }
    }
  });
  list.addEventListener('change', (e) => {
    const li = e.target.closest('.item');
    if (!li) return;
    if (e.target.matches('[data-qty]')) {
      e.target.value = String(clampQty(e.target.value));
      quote.update(li.dataset.slug, { qty: Number(e.target.value) });
    }
    if (e.target.matches('[data-note]')) quote.update(li.dataset.slug, { note: e.target.value.slice(0, 300) });
    if (e.target.matches('[data-cut-len], [data-cut-pcs]')) {
      if (e.target.matches('[data-cut-pcs]')) e.target.value = String(clampQty(e.target.value));
      if (e.target.matches('[data-cut-len]') && e.target.value) e.target.value = String(clampLen(e.target.value) || '');
      const cuts = normalizeCuts(readCuts(li));
      if (cuts.length) {
        quote.update(li.dataset.slug, { cuts });
        const tot = li.querySelector('.qty-total');
        if (tot) tot.innerHTML = `<span><strong>${quote.items().find((i) => i.slug === li.dataset.slug)?.qty ?? ''}</strong> db</span><small>${(cuts.reduce((n, c) => n + c.len * c.pcs, 0) / 1000).toLocaleString('hu-HU', { maximumFractionDigits: 2 })} fm</small>`;
      }
    }
  });
  clearBtn.addEventListener('click', () => {
    if (confirm('Biztosan üríti az ajánlatkérő listát?')) {
      quote.clear();
      render();
    }
  });

  // Egyedi tétel
  const customForm = $('[data-custom]');
  const customName = $('#custom-name');
  const customQty = $('#custom-qty');
  const preset = new URLSearchParams(location.search).get('egyedi');
  if (preset) customName.value = preset;
  customForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = customName.value.trim();
    if (!name) return customName.focus();
    quote.addCustom(name, Number(customQty.value));
    customForm.reset();
    render();
    window.dispatchEvent(new CustomEvent('quote:toast', { detail: 'Egyedi tétel hozzáadva az ajánlatkérőhöz' }));
  });

  // Szöveges lista (másoláshoz, e-mailhez)
  const listText = () =>
    quote
      .items()
      .map((i, n) => `${n + 1}. ${i.code ? `[${i.code}] ` : ''}${i.name}${i.custom ? ' (egyedi tétel)' : ''} – ${i.qty} db${i.cuts?.length ? ` (${cutsText(i.cuts)})` : ''}${i.note ? ` – ${i.note}` : ''}`)
      .join('\n');

  $('[data-copy-list]').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(listText());
      window.dispatchEvent(new CustomEvent('quote:toast', { detail: 'A lista a vágólapra másolva' }));
    } catch {}
  });
  $('[data-print]').addEventListener('click', () => window.print());

  const showError = (msg) => {
    errorEl.innerHTML = msg;
    errorEl.hidden = false;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.hidden = true;
    const items = quote.items();
    if (!items.length) return showError('Az ajánlatkérő lista üres – adjon hozzá legalább egy tételt.');
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const data = Object.fromEntries(new FormData(form));
    const payload = {
      customer: { name: data.name, company: data.company, email: data.email, phone: data.phone },
      message: data.message,
      website: data.website,
      items: items.map((i) => ({ code: i.code, name: i.name, qty: i.qty, note: i.note, cuts: i.cuts ?? [], custom: !!i.custom, url: i.custom ? '' : `${location.origin}/termek/${i.slug}` })),
    };
    submitBtn.disabled = true;
    submitLabel.textContent = 'Küldés…';
    try {
      const res = await fetch('/api/ajanlatkeres', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (!res.ok) {
        const info = await res.json().catch(() => ({}));
        throw new Error([res.status, info.error, info.message].filter(Boolean).join(' – '));
      }
      quote.clear();
      form.hidden = true;
      document.querySelector('.items-col').hidden = true;
      $('[data-success]').hidden = false;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch (err) {
      const code = `<br><small>Hibakód: ${esc(err.message || 'hálózati hiba')}</small>`;
      const email = window.__QUADRIS_EMAIL;
      if (email) {
        const body = `Ajánlatkérés\n\nNév: ${data.name}\nCég: ${data.company}\nE-mail: ${data.email}\nTelefon: ${data.phone}\n\nTételek:\n${listText()}\n\nMegjegyzés:\n${data.message}`;
        const href = `mailto:${email}?subject=${encodeURIComponent(`Ajánlatkérés – ${data.company}`)}&body=${encodeURIComponent(body)}`;
        showError(`Az online küldés most nem sikerült. <a href="${esc(href)}">Küldje el e-mailben egy kattintással →</a>${code}`);
      } else {
        showError(`Az online küldés most nem sikerült. Kérjük, próbálja újra később, vagy másolja ki a listát és küldje el nekünk e-mailben.${code}`);
      }
    } finally {
      submitBtn.disabled = false;
      submitLabel.textContent = 'Ajánlatkérés elküldése';
    }
  });
</script>

<style>
  .quote-head { padding: 12px 0 10px; }
  .quote-head h1 { font-size: clamp(1.4rem, 2.4vw, 1.8rem); margin: 0 0 4px; }
  .quote-head .lead { font-size: 0.92rem; margin: 0; max-width: none; }
  .quote-layout { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(320px, 1fr); gap: 18px; align-items: start; padding-top: 14px; padding-bottom: 0; }
  .items-col { display: grid; gap: 14px; }
  .items-card, .custom-card, .form-card { padding: 16px 20px; }
  .items-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .items-head h2, .custom-card h2, .form-card h2 { font-size: 1.08rem; margin: 0; }
  .custom-card h2 { display: flex; align-items: center; gap: 8px; margin-bottom: 2px; }
  .custom-card > p { font-size: 0.88rem; margin: 0 0 8px; }
  .custom-card h2 :global(svg) { color: var(--accent); }
  .link-btn { display: inline-flex; align-items: center; gap: 6px; border: 0; background: none; color: var(--muted); cursor: pointer; font-size: 0.88rem; padding: 4px; }
  .link-btn:hover { color: var(--accent); }
  .items { list-style: none; padding: 0; margin: 16px 0 0; }
  .items :global(.item) { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto; gap: 16px; align-items: start; padding: 16px 0; border-top: 1px solid var(--line); }
  .items :global(.thumb) { width: 64px; height: 56px; border-radius: 10px; display: grid; place-items: center; color: #7ea3d6; background: linear-gradient(160deg, #f6f9fe, #eaf1fb); border: 1px solid var(--line); }
  .items :global(.thumb.has-img) { background: var(--tile); }
  .items :global(.thumb img) { max-width: 90%; max-height: 90%; object-fit: contain; }
  .items :global(.item-main) { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .items :global(.item-name) { font-weight: 600; color: var(--text); }
  .items :global(a.item-name:hover) { color: var(--accent); }
  .items :global(.item-code) { font-size: 0.84rem; }
  .items :global(.tag) { align-self: flex-start; font-size: 0.72rem; padding: 2px 8px; border-radius: 6px; background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  .items :global(.note) { margin-top: 8px; padding: 8px 12px; font-size: 0.88rem; }
  .items :global(.cuts) { margin-top: 10px; display: grid; gap: 6px; max-width: 360px; }
  .items :global(.cuts-head), .items :global(.cut-row) { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) 34px; gap: 8px; align-items: center; }
  .items :global(.cuts-head) { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
  .items :global(.cut-row .input) { padding: 7px 10px; font-size: 0.9rem; width: 100%; }
  .items :global(.cut-del) { width: 34px; height: 34px; border: 1px solid var(--line); border-radius: 9px; background: transparent; color: var(--muted); display: grid; place-items: center; cursor: pointer; }
  .items :global(.cut-del:hover) { color: #d63a3a; border-color: #d63a3a; }
  .items :global(.cuts-add) { justify-self: start; display: inline-flex; align-items: center; gap: 6px; border: 1px dashed var(--accent); color: var(--accent); background: var(--accent-soft); border-radius: 9px; padding: 5px 10px; font-size: 0.85rem; font-weight: 600; cursor: pointer; }
  .items :global(.qty-total) { display: flex; flex-direction: column; align-items: flex-end; font-size: 0.95rem; line-height: 1.3; white-space: nowrap; }
  .items :global(.qty-total small) { color: var(--muted); font-size: 0.8rem; }
  .items :global(.item-side) { display: flex; align-items: center; gap: 8px; }
  .items :global(.remove) { width: 40px; height: 40px; border-radius: 10px; border: 1px solid var(--line); background: transparent; color: var(--muted); cursor: pointer; display: grid; place-items: center; }
  .items :global(.remove:hover) { color: var(--danger); border-color: var(--danger); }
  .empty-state { text-align: center; padding: 2px 10px 0; display: grid; justify-items: center; gap: 0; font-size: 0.92rem; }
  .empty-state p { margin: 0 0 6px; }
  .empty-state > :global(svg) { color: var(--accent); margin-bottom: 4px; }
  .empty-state[hidden] { display: none; }
  .custom-row { display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; }
  .grow { flex: 1; min-width: 220px; }
  .qty-field { width: 110px; }
  .form-card { position: sticky; top: calc(var(--header-h) + 16px); }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 12px; margin: 8px 0 10px; }
  .form-card :global(.field) { gap: 3px; }
  .form-card :global(.field label) { font-size: 0.82rem; }
  .form-card :global(.field input), .form-card :global(.field textarea), .custom-card :global(.field input) { padding: 6px 11px; }
  .form-card :global(.field textarea) { min-height: 50px; }
  .custom-card :global(.field label) { font-size: 0.82rem; }
  .custom-card :global(.btn) { padding: 9px 16px; }
  .full { grid-column: 1 / -1; }
  .hp { position: absolute; left: -9999px; }
  .consent { display: flex; gap: 8px; align-items: flex-start; font-size: 0.78rem; line-height: 1.45; color: var(--text-2); }
  .consent input { margin-top: 3px; accent-color: var(--accent); width: 16px; height: 16px; flex: none; }
  .form-error { color: #b42318; background: #fef3f2; border: 1px solid #fecdca; padding: 12px 14px; border-radius: 10px; font-size: 0.92rem; }
  .form-error :global(a) { color: #b42318; font-weight: 700; text-decoration: underline; }
  .submit { width: 100%; padding: 12px; font-size: 0.97rem; }
  .alt-actions { display: flex; justify-content: center; gap: 16px; margin-top: 6px; flex-wrap: wrap; }
  .success { grid-column: 1 / -1; padding: 56px 24px; text-align: center; display: grid; justify-items: center; gap: 6px; }
  .success > :global(svg) { color: var(--ok); margin-bottom: 8px; }
  .success[hidden], [hidden] { display: none !important; }
  @media (max-width: 1000px) {
    .quote-layout { grid-template-columns: 1fr; }
    .form-card { position: static; }
  }
  @media (max-width: 560px) {
    .form-grid { grid-template-columns: 1fr; }
    .items :global(.item) { grid-template-columns: 48px minmax(0, 1fr); }
    .items :global(.thumb) { width: 48px; height: 44px; }
