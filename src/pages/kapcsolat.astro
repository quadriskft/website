---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../lib/site.js';
---
<Base crumbs={[['Főoldal', '/'], ['Kapcsolat', '/kapcsolat']]} back={{ href: '/', label: 'Főoldal' }} title="Kapcsolat" description={`Lépjen kapcsolatba a ${SITE.name} csapatával: kérdések, ajánlatkérés, egyedi igények.`}>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Kapcsolat</span>
      <h1>Beszéljünk a felépítményéről</h1>
      <p class="lead">Kérdése van egy termékkel kapcsolatban, vagy egyedi igénye van? Írjon nekünk, és hamarosan válaszolunk.</p>
    </div>
  </section>

  <div class="container contact">
    <aside class="contact-info">
      <div class="card info-card">
        <h2>{SITE.name}</h2>
        <ul>
          {SITE.address && (
            <li><span class="k">Cím</span><span>{SITE.address}<br /><a href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${SITE.name}, ${SITE.address}`)}`} target="_blank" rel="noopener">Útvonaltervezés →</a></span></li>
          )}
          {SITE.phone && <li><span class="k">Telefon</span><a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a></li>}
          {SITE.email && <li><span class="k">E-mail</span><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>}
          {SITE.openingHours && <li><span class="k">Nyitvatartás</span><span>{SITE.openingHours}</span></li>}
        </ul>
      </div>
      <a href="/ajanlatkeres" class="card quote-card">
        <div>
          <h3>Árajánlatot szeretne?</h3>
          <p class="muted">Gyűjtse össze a termékeket az ajánlatkérőben, és küldje el egyben.</p>
        </div>
        <Icon name="ArrowRight" />
      </a>
    </aside>

    <form class="card contact-form" data-contact novalidate>
      <h2>Üzenet küldése</h2>
      <div class="form-grid">
        <div class="field"><label for="c-name">Név *</label><input id="c-name" name="name" required autocomplete="name" maxlength="120" /></div>
        <div class="field"><label for="c-company">Cégnév</label><input id="c-company" name="company" autocomplete="organization" maxlength="160" /></div>
        <div class="field"><label for="c-email">E-mail *</label><input id="c-email" name="email" type="email" required autocomplete="email" maxlength="160" /></div>
        <div class="field"><label for="c-phone">Telefon</label><input id="c-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" /></div>
        <div class="field full"><label for="c-msg">Üzenet *</label><textarea id="c-msg" name="message" required maxlength="3000"></textarea></div>
        <div class="hp" aria-hidden="true"><label>Weboldal<input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <label class="consent full"><input type="checkbox" name="consent" required /> <span>Hozzájárulok, hogy a {SITE.name} a megkeresésem megválaszolása céljából kezelje a megadott adataimat. Részletek az <a href="/adatkezeles" target="_blank">adatkezelési tájékoztatóban</a>.</span></label>
      </div>
      <p class="form-error" role="alert" hidden></p>
      <p class="form-ok" role="status" hidden><Icon name="CircleCheck" /> Köszönjük! Üzenetét megkaptuk, hamarosan válaszolunk.</p>
      <button class="btn btn-primary" type="submit">Üzenet küldése</button>
    </form>
  </div>
</Base>

<script>
  const form = document.querySelector('[data-contact]');
  const err = form.querySelector('.form-error');
  const ok = form.querySelector('.form-ok');
  const btn = form.querySelector('button[type=submit]');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.hidden = true;
    if (!form.checkValidity()) return form.reportValidity();
    const d = Object.fromEntries(new FormData(form));
    btn.disabled = true;
    try {
      const res = await fetch('/api/ajanlatkeres', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ customer: { name: d.name, company: d.company, email: d.email, phone: d.phone }, message: d.message, website: d.website, items: [] }),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      ok.hidden = false;
    } catch {
      err.textContent = 'Az üzenet küldése most nem sikerült. Kérjük, próbálja újra később.';
      err.hidden = false;
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .contact { display: grid; grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1.4fr); gap: 24px; padding-top: 32px; padding-bottom: 40px; align-items: start; }
  .contact-info { display: grid; gap: 20px; }
  .info-card { padding: 26px; }
  .info-card h2 { font-size: 1.25rem; font-weight: 700; }
  .info-card ul { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 14px; }
  .info-card li { display: grid; grid-template-columns: 136px minmax(0, 1fr); column-gap: 16px; align-items: flex-start; color: var(--text-2); padding-top: 14px; border-top: 1px solid var(--line); }
  .info-card li:first-child { padding-top: 0; border-top: 0; }
  .info-card .k { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); padding-top: 4px; }
  .quote-card { display: flex !important; align-items: center; justify-content: space-between; gap: 16px; padding: 22px; }
  .quote-card > :global(svg) { color: var(--link); flex: none; }
  .quote-card h3 { margin-bottom: 2px; }
  .quote-card p { margin: 0; font-size: 0.9rem; }
  .contact-form { padding: 28px; }
  .contact-form h2 { font-size: 1.25rem; font-weight: 700; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 18px 0; }
  .full { grid-column: 1 / -1; }
  .hp { position: absolute; left: -9999px; }
  .consent { display: flex; gap: 10px; align-items: flex-start; font-size: 0.86rem; color: var(--text-2); }
  .consent input { margin-top: 3px; accent-color: var(--accent); width: 16px; height: 16px; flex: none; }
  .form-error { color: #b42318; background: #fef3f2; border: 1px solid #fecdca; padding: 12px 14px; border-radius: var(--radius-sm); }
  .form-ok { display: flex; gap: 10px; align-items: center; color: #067647; background: #ecfdf3; border: 1px solid #abefc6; padding: 12px 14px; border-radius: var(--radius-sm); }
  [hidden] { display: none !important; }
  @media (max-width: 860px) {
    .contact { grid-template-columns: 1fr; }
    .form-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 420px) {
    .info-card li { grid-template-columns: 1fr; row-gap: 2px; }
    .info-card .k { padding-top: 0; }
  }
</style>
