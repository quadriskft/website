---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { groups, GROUP_META, stats, groupImage } from '../../lib/catalog.js';
---
<Base title="Termékkatalógus" description={`${stats.products} termék ${stats.groups} termékcsoportban jármű- és lószállító felépítmény gyártóknak.`}>
  <section class="page-head">
    <div class="container">
      <nav class="breadcrumb" aria-label="Morzsamenü"><a href="/">Főoldal</a> / <span>Termékek</span></nav>
      <span class="eyebrow">Termékkatalógus</span>
      <h1>Termékcsoportok</h1>
      <p class="lead">{stats.products} termék {stats.groups} csoportban. Válasszon csoportot, vagy keressen a fejlécben név, illetve cikkszám alapján.</p>
    </div>
  </section>
  <section class="section-sm">
    <div class="container catalog-list">
      {groups.map((g) => (
        <article class="card catalog-group">
          <a href={`/termekek/${g.slug}`} class="cg-media" tabindex="-1" aria-hidden="true">
            <img src={groupImage(g.slug)} alt="" loading="lazy" width="800" height="560" />
          </a>
          <a href={`/termekek/${g.slug}`} class="cg-head">
            <span class="cg-icon"><Icon name={GROUP_META[g.slug]?.icon} size={22} /></span>
            <span>
              <h2>{g.name}</h2>
              <span class="muted">{g.count} termék</span>
            </span>
          </a>
          <ul class="cg-cats">
            {g.categories.map((c) => (
              <li><a href={`/termekek/${g.slug}#${c.slug}`}>{c.name} <span class="muted">{c.count}</span></a></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .catalog-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 20px; }
  .catalog-group { padding: 0 22px 22px; overflow: hidden; }
  .cg-media { display: block; margin: 0 -22px 18px; aspect-ratio: 16 / 9; background: #fff; border-bottom: 1px solid var(--line); overflow: hidden; }
  .cg-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .catalog-group:hover .cg-media img { transform: scale(1.04); }
  .cg-head { display: flex; gap: 14px; align-items: center; color: inherit; text-decoration: none !important; margin-bottom: 14px; }
  .cg-head:hover h2 { color: var(--accent); }
  .cg-head h2 { font-size: 1.1rem; margin: 0; }
  .cg-head .muted { font-size: 0.85rem; }
  .cg-icon {
    flex: none; width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center; color: var(--accent);
    background: var(--accent-soft); border: 1px solid rgba(10, 108, 255, 0.18);
  }
  .cg-cats { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .cg-cats a {
    display: inline-flex; gap: 6px; padding: 6px 12px; border-radius: 999px; font-size: 0.86rem;
    border: 1px solid var(--line); color: var(--text-2); text-decoration: none;
  }
  .cg-cats a:hover { border-color: var(--accent); color: var(--text); background: var(--accent-soft); }
  @media (max-width: 420px) { .catalog-list { grid-template-columns: 1fr; } }
</style>
