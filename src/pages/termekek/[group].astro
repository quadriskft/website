---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import { groups, GROUP_META, productsIn, groupImage, sidebarImage, CATEGORY_LOGOS, GROUP_LOGOS, codeHiddenInGroup } from '../../lib/catalog.js';
import { absPage } from '../../lib/site.js';

export function getStaticPaths() {
  return groups.map((group) => ({ params: { group: group.slug }, props: { group } }));
}

const { group } = Astro.props;
const meta = GROUP_META[group.slug] ?? {};
const sections = group.categories.map((c) => ({ ...c, items: productsIn(group.slug, c.slug) }));
const single = sections.length === 1;
const sideImg = sidebarImage(group.slug);
// alkategória címe melletti rövid megjegyzés (a Quadris kérése)
const CATEGORY_NOTES = {
  'aluminium-alvaz-profilok/hossztartok': 'Ötvözött alumíniumból.',
  'aluminium-alvaz-profilok/kereszttartok': 'Ötvözött alumíniumból.',
  'aluminium-alvaz-profilok/keret-profilok': 'Ötvözött alumíniumból.',
};
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [['Főoldal', '/'], ['Termékkatalógus', '/termekek'], [group.name, `/termekek/${group.slug}`]]
      .map(([name, url], i) => ({ '@type': 'ListItem', position: i + 1, name, item: absPage(url) })),
  },
  {
    '@type': 'CollectionPage',
    name: group.name,
    url: absPage(`/termekek/${group.slug}`),
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: group.count,
      itemListElement: sections.flatMap((sec) => sec.items).map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: absPage(`/termek/${p.slug}`), name: p.name })),
    },
  },
];
---
<Base crumbs={[['Főoldal', '/'], ['Termékkatalógus', '/termekek'], [group.name, `/termekek/${group.slug}`]]} back={{ href: '/termekek', label: 'Termékkatalógus' }} title={group.name} description={`${group.name}: ${meta.text ?? ''} ${group.count} termék – kérjen ajánlatot online a Quadristól.`} image={groupImage(group.slug) ?? undefined} jsonLd={jsonLd}>
  <section class="page-head">
    <div class="container">
      <div class="gh">
        <div>
          <h1>{group.name}</h1>
          <p class="lead">{meta.text}</p>
        </div>
        {GROUP_LOGOS[group.slug] && <img class="group-logo" src={GROUP_LOGOS[group.slug].src} alt={GROUP_LOGOS[group.slug].alt} />}
      </div>
    </div>
  </section>

  <div class="container layout">
    {!single && (
      <aside class="sidebar">
        <nav aria-label="Kategóriák">
          <h2 class="side-title">Kategóriák</h2>
          <ul>
            {sections.map((c) => <li><a href={`#${c.slug}`}>{CATEGORY_LOGOS[c.slug] && <img class="cat-logo-sm" src={CATEGORY_LOGOS[c.slug].src} alt="" />}{c.name}<span>{c.count}</span></a></li>)}
          </ul>
        {sideImg && <img class="side-img" src={sideImg} alt={group.name} loading="lazy" />}
        </nav>
      </aside>
    )}
    <div class="content">
      {sections.map((c) => (
        <section class="cat-section" id={c.slug} data-cat data-cat-name={c.name}>
          {!single && (
            <h2 class="cat-title">
              {CATEGORY_LOGOS[c.slug] && <img class="cat-logo" src={CATEGORY_LOGOS[c.slug].src} alt={CATEGORY_LOGOS[c.slug].alt} />}
              {(!CATEGORY_LOGOS[c.slug] || CATEGORY_LOGOS[c.slug].text) && <span>{c.name}</span>}
              <span class="muted">{c.count}</span>
              {CATEGORY_NOTES[`${group.slug}/${c.slug}`] && <span class="cat-note muted">{CATEGORY_NOTES[`${group.slug}/${c.slug}`]}</span>}
            </h2>
          )}
          <div class="grid grid-products">
            {c.items.map((p) => <ProductCard product={p} hideCode={codeHiddenInGroup(group.slug)} />)}
          </div>
        </section>
      ))}
    </div>
  </div>
</Base>

<script>
  // --- Morzsamenü: az éppen látható alkategória, és a „Vissza” gomb célja ---
  const catSections = [...document.querySelectorAll('[data-cat]')];
  const subCrumb = document.querySelector('[data-sub-crumb]');
  const subSep = document.querySelector('[data-sub-sep]');
  const groupCrumb = document.querySelector('[data-crumb="last"]');
  const back = document.querySelector('[data-back]');
  const home = { href: back.getAttribute('href'), label: back.getAttribute('aria-label') };
  const groupUrl = groupCrumb.getAttribute('href');
  const setActive = (sec) => {
    const on = !!sec && catSections.length > 1;
    subSep.hidden = subCrumb.hidden = !on;
    groupCrumb.classList.toggle('current', !on);
    if (on) {
      subCrumb.textContent = sec.dataset.catName;
      subCrumb.href = `#${sec.id}`;
      back.href = groupUrl;
      back.setAttribute('aria-label', `Vissza: ${groupCrumb.textContent}`);
      back.title = back.getAttribute('aria-label');
    } else {
      back.href = home.href;
      back.setAttribute('aria-label', home.label);
      back.title = home.label;
    }
  };
  const updateActive = () => {
    const line = window.innerHeight * 0.3;
    let current = null;
    for (const sec of catSections) {
      if (sec.hidden) continue;
      if (sec.getBoundingClientRect().top <= line) current = sec;
    }
    setActive(current);
  };
  window.addEventListener('scroll', updateActive, { passive: true });
  updateActive();
  back.addEventListener('click', (e) => {
    if (back.getAttribute('href') === groupUrl) {  // alkategóriából a főkategória tetejére
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
      history.replaceState(null, '', groupUrl);
    }
  });

</script>

<style>
  .gh { display: flex; gap: 20px; align-items: flex-start; }
  .gh h1 { margin-bottom: 8px; }
  .gh .lead { margin: 0; }
  .layout { display: flex; gap: 36px; padding-top: 32px; padding-bottom: 40px; align-items: flex-start; }
  /* alkategóriánként 4 termék egy sorban (kisebb kijelzőn 3, mobilon 2) */
  .layout :global(.grid-products) { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 1200px) { .layout :global(.grid-products) { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 720px) { .layout :global(.grid-products) { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } }
  .sidebar { flex: 0 0 250px; position: sticky; top: calc(var(--header-h) + 68px); max-height: calc(100vh - var(--header-h) - 88px); overflow-y: auto; }
  .side-title { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); margin-bottom: 10px; }
  .sidebar ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .side-img { display: block; width: 100%; height: auto; margin-top: 18px; border-radius: var(--radius); }
  .sidebar a { display: flex; justify-content: space-between; gap: 10px; padding: 8px 12px; border-radius: var(--radius-btn); color: var(--text-2); font-size: 0.93rem; text-decoration: none; }
  .sidebar a span { color: var(--muted); font-size: 0.85rem; }
  .sidebar a:hover { background: var(--accent-soft); color: var(--navy); }
  .content { flex: 1; min-width: 0; }
  .cat-section { margin-bottom: 44px; }
  .cat-section h2 { font-size: 1.35rem; font-weight: 700; letter-spacing: -0.01em; display: flex; align-items: baseline; gap: 10px; padding-bottom: 12px; margin-bottom: 18px; border-bottom: 1px solid var(--line); }
  .cat-section h2 .muted { font-size: 0.95rem; font-weight: 500; }
  .cat-section h2.cat-title { align-items: center; }
  .cat-note { font-size: 1.05rem; font-weight: 400; letter-spacing: 0; margin-left: 6px; }
  .group-logo { height: 72px; width: auto; flex: none; margin-left: auto; }
  .cat-logo { height: 44px; width: auto; display: block; background: #fff; border-radius: 4px; }
  .cat-logo-sm { height: 16px; width: auto; vertical-align: -3px; margin-right: 6px; background: #fff; border-radius: 2px; }
  @media (max-width: 960px) {
    .side-img { display: none; }
    .layout { flex-direction: column; gap: 16px; }
    .sidebar { position: static; flex: none; width: 100%; max-height: none; }
    /* vízszintesen görgethető chip-sor: jobb oldali fade jelzi a folytatást, a padding miatt a legutolsó chip is teljesen látszik a végén */
    .sidebar ul { display: flex; gap: 8px; overflow-x: auto; padding: 0 32px 6px 0; scroll-padding: 16px; -webkit-overflow-scrolling: touch; scrollbar-width: none; -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 32px), transparent); mask-image: linear-gradient(90deg, #000 calc(100% - 32px), transparent); }
    .sidebar ul::-webkit-scrollbar { display: none; }
    .sidebar li { flex: none; }
    .sidebar a { white-space: nowrap; border: 1px solid var(--line-strong); border-radius: var(--radius-btn); padding: 6px 12px; }
    .side-title { display: none; }
  }
</style>
