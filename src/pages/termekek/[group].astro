---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import { groups, GROUP_META, productsIn } from '../../lib/catalog.js';

export function getStaticPaths() {
  return groups.map((group) => ({ params: { group: group.slug }, props: { group } }));
}

const { group } = Astro.props;
const meta = GROUP_META[group.slug] ?? {};
const sections = group.categories.map((c) => ({ ...c, items: productsIn(group.slug, c.slug) }));
const single = sections.length === 1;
---
<Base title={group.name} description={`${group.name}: ${meta.text ?? ''} ${group.count} termék – kérjen ajánlatot online a Quadristól.`}>
  <section class="page-head">
    <div class="container">
      <nav class="breadcrumb" aria-label="Morzsamenü"><a href="/">Főoldal</a> / <a href="/termekek">Termékek</a> / <span>{group.name}</span></nav>
      <div class="gh">
        <span class="gh-icon"><Icon name={meta.icon} size={30} /></span>
        <div>
          <h1>{group.name}</h1>
          <p class="lead">{meta.text} <span class="muted">{group.count} termék.</span></p>
        </div>
      </div>
    </div>
  </section>

  <div class="container layout">
    {!single && (
      <aside class="sidebar">
        <nav aria-label="Kategóriák">
          <h2 class="side-title">Kategóriák</h2>
          <ul>
            {sections.map((c) => <li><a href={`#${c.slug}`}>{c.name}<span>{c.count}</span></a></li>)}
          </ul>
        </nav>
      </aside>
    )}
    <div class="content">
      <div class="filter">
        <Icon name="ListFilter" size={18} />
        <input type="search" class="filter-input" placeholder={`Szűrés ebben a csoportban (${group.count} termék)…`} aria-label="Szűrés a csoporton belül" />
        <span class="filter-count muted" aria-live="polite"></span>
      </div>
      {sections.map((c) => (
        <section class="cat-section" id={c.slug} data-cat>
          {!single && <h2>{c.name} <span class="muted">{c.count}</span></h2>}
          <div class="grid grid-products">
            {c.items.map((p) => <ProductCard product={p} />)}
          </div>
        </section>
      ))}
      <p class="no-hit" hidden>Nincs a szűrésnek megfelelő termék ebben a csoportban. <a href="/ajanlatkeres#egyedi">Kérje egyedi tételként →</a></p>
    </div>
  </div>
</Base>

<script>
  const norm = (s) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  const input = document.querySelector('.filter-input');
  const cards = [...document.querySelectorAll('.product-card')].map((el) => ({ el, text: norm(el.dataset.name ?? '') }));
  const sections = [...document.querySelectorAll('[data-cat]')];
  const count = document.querySelector('.filter-count');
  const noHit = document.querySelector('.no-hit');
  input.addEventListener('input', () => {
    const terms = norm(input.value).split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const c of cards) {
      const ok = terms.every((t) => c.text.includes(t));
      c.el.hidden = !ok;
      if (ok) shown++;
    }
    sections.forEach((s) => (s.hidden = !s.querySelector('.product-card:not([hidden])')));
    count.textContent = terms.length ? `${shown} találat` : '';
    noHit.hidden = shown > 0;
  });
</script>

<style>
  .gh { display: flex; gap: 20px; align-items: flex-start; }
  .gh h1 { margin-bottom: 8px; }
  .gh .lead { margin: 0; }
  .gh-icon {
    flex: none; width: 64px; height: 64px; border-radius: 18px; display: grid; place-items: center; color: var(--accent);
    background: linear-gradient(145deg, rgba(62, 224, 255, 0.16), rgba(47, 107, 255, 0.08)); border: 1px solid rgba(62, 224, 255, 0.25);
  }
  .layout { display: flex; gap: 36px; padding-top: 32px; padding-bottom: 40px; align-items: flex-start; }
  .sidebar { flex: 0 0 250px; position: sticky; top: calc(var(--header-h) + 20px); max-height: calc(100vh - var(--header-h) - 40px); overflow-y: auto; }
  .side-title { font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
  .sidebar ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .sidebar a { display: flex; justify-content: space-between; gap: 10px; padding: 8px 12px; border-radius: 10px; color: var(--text-2); font-size: 0.93rem; text-decoration: none; }
  .sidebar a span { color: var(--muted); font-size: 0.85rem; }
  .sidebar a:hover { background: var(--accent-soft); color: var(--text); }
  .content { flex: 1; min-width: 0; }
  .filter { position: relative; display: flex; align-items: center; gap: 10px; margin-bottom: 28px; padding: 0 16px; border: 1px solid var(--line-strong); border-radius: 999px; background: rgba(255, 255, 255, 0.03); max-width: 560px; }
  .filter:focus-within { border-color: var(--accent); }
  .filter > :global(svg) { color: var(--muted); flex: none; }
  .filter input { flex: 1; min-width: 0; height: 44px; border: 0; background: transparent; outline: none; }
  .filter-count { font-size: 0.85rem; white-space: nowrap; }
  .cat-section { margin-bottom: 44px; }
  .cat-section h2 { font-size: 1.35rem; display: flex; align-items: baseline; gap: 10px; padding-bottom: 12px; margin-bottom: 18px; border-bottom: 1px solid var(--line); }
  .cat-section h2 .muted { font-size: 0.95rem; font-weight: 500; }
  .no-hit { padding: 24px; border: 1px dashed var(--line-strong); border-radius: var(--radius); }
  @media (max-width: 960px) {
    .layout { flex-direction: column; gap: 16px; }
    .sidebar { position: static; flex: none; width: 100%; max-height: none; }
    .sidebar ul { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 6px; }
    .sidebar a { white-space: nowrap; border: 1px solid var(--line); border-radius: 999px; padding: 6px 12px; }
    .side-title { display: none; }
  }
  @media (max-width: 640px) {
    .gh-icon { display: none; }
  }
</style>
