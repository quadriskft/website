---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HorseIcon from '../components/HorseIcon.astro';
import HeroAssembly from '../components/HeroAssembly.astro';
import { groups, GROUP_META, stats, roundedCount } from '../lib/catalog.js';

const popular = ['alu lemez', 'rakonca', 'zsanér', 'istálló szőnyeg', 'sárvédő'];
---
<Base>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Alkatrész-beszállító felépítménygyártóknak</span>
        <h1>Minden alkatrész a felépítményhez – <span class="gradient-text">egy helyről.</span></h1>
        <p class="lead">
          Alváz- és padlóprofilok, ponyvarendszerek, zárak, zsanérok, sárvédők és rakományrögzítés
          jármű- és lószállító felépítmény gyártóknak. Állítsa össze a listáját, és elkészítjük az ajánlatát.
        </p>
        <form class="hero-search" action="/kereses" method="get" role="search">
          <Icon name="Search" size={20} />
          <input type="search" name="q" placeholder="Keressen terméknévre vagy cikkszámra…" aria-label="Termékkeresés" />
          <button class="btn btn-primary" type="submit">Keresés</button>
        </form>
        <div class="hero-popular">
          <span class="muted">Népszerű:</span>
          {popular.map((q) => <a href={`/kereses?q=${encodeURIComponent(q)}`}>{q}</a>)}
        </div>
        <div class="hero-ctas">
          <a href="/termekek" class="btn btn-primary">Termékkatalógus <Icon name="ArrowRight" /></a>
          <a href="/ajanlatkeres" class="btn btn-ghost"><Icon name="ClipboardList" /> Ajánlatkérés</a>
        </div>
      </div>
      <div class="hero-visual">
        <HeroAssembly />
      </div>
    </div>
    <div class="container">
      <dl class="stats">
        <div><dt>Termék</dt><dd>{roundedCount(stats.products)}</dd></div>
        <div><dt>Termékcsoport</dt><dd>{stats.groups}</dd></div>
        <div><dt>Gyártó partner</dt><dd>{roundedCount(stats.suppliers, 25)}</dd></div>
        <div><dt>Ajánlatkérés</dt><dd>Online</dd></div>
      </dl>
    </div>
  </section>

  <section class="section-sm">
    <div class="container segments">
      <a href="/termekek" class="card segment">
        <div class="segment-icon"><Icon name="Truck" size={30} /></div>
        <div>
          <h2>Jármű felépítmény gyártóknak</h2>
          <p class="muted">Platós, ponyvás, dobozos, hűtős és billencs felépítmények teljes alkatrész-kínálata – profiloktól a zárakig.</p>
          <span class="link-arrow">Teljes katalógus <Icon name="ArrowRight" size={18} /></span>
        </div>
      </a>
      <a href="/loszallito-felepitmenyek" class="card segment horse">
        <div class="segment-icon"><HorseIcon size={30} /></div>
        <div>
          <h2>Lószállító felépítmény gyártóknak</h2>
          <p class="muted">Istálló- és rámpaszőnyegek, rámpaprofilok, csúszásmentes padlók, zárak és zsanérok – válogatva a lószállítók igényeire.</p>
          <span class="link-arrow">Lószállító kínálat <Icon name="ArrowRight" size={18} /></span>
        </div>
      </a>
    </div>
  </section>

  <section class="section" id="termekcsoportok">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Termékkatalógus</span>
          <h2>{stats.groups} termékcsoport, {stats.categories} kategória</h2>
        </div>
        <a href="/termekek" class="btn btn-ghost">Összes termék <Icon name="ArrowRight" /></a>
      </div>
      <div class="grid grid-groups">
        {groups.map((g) => (
          <a href={`/termekek/${g.slug}`} class="card group-card">
            <div class="group-icon"><Icon name={GROUP_META[g.slug]?.icon} size={24} /></div>
            <h3>{g.name}</h3>
            <p class="muted">{GROUP_META[g.slug]?.text}</p>
            <span class="group-count">{g.count} termék <Icon name="ArrowRight" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section steps-section">
    <div class="container">
      <span class="eyebrow">Így működik</span>
      <h2>Ajánlat három lépésben</h2>
      <ol class="steps">
        <li class="card">
          <span class="step-no">01</span>
          <Icon name="Search" size={26} />
          <h3>Válogasson</h3>
          <p class="muted">Keressen név vagy cikkszám alapján, vagy böngésszen a termékcsoportok között.</p>
        </li>
        <li class="card">
          <span class="step-no">02</span>
          <Icon name="ClipboardList" size={26} />
          <h3>Tegye az ajánlatkérőbe</h3>
          <p class="muted">Adja meg a mennyiségeket. Ha valamit nem talál, egyedi tételként is felveheti.</p>
        </li>
        <li class="card">
          <span class="step-no">03</span>
          <Icon name="Send" size={26} />
          <h3>Küldje el</h3>
          <p class="muted">Egy kattintással elküldi a listát, kollégáink pedig személyre szabott ajánlattal jelentkeznek.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container why">
      <div>
        <span class="eyebrow">Miért a Quadris?</span>
        <h2>Egy partner a teljes felépítményhez</h2>
        <p class="lead">Nem kell tucatnyi gyártóval külön tárgyalnia: összegyűjtjük, egyeztetjük és egyben szállítjuk, amire a gyártósorának szüksége van.</p>
      </div>
      <ul class="benefits">
        <li><Icon name="Boxes" size={22} /><div><h3>Széles választék</h3><p class="muted">{roundedCount(stats.products)} termék {roundedCount(stats.suppliers, 25)} gyártótól, egyetlen kapcsolattartóval.</p></div></li>
        <li><Icon name="Handshake" size={22} /><div><h3>Szakmai tanácsadás</h3><p class="muted">Segítünk kiválasztani a megfelelő profilt, zárat vagy rendszert az adott felépítményhez.</p></div></li>
        <li><Icon name="Timer" size={22} /><div><h3>Gyors ajánlat</h3><p class="muted">Online összeállított lista, gyors és átlátható árajánlat.</p></div></li>
        <li><Icon name="Sparkles" size={22} /><div><h3>Egyedi igények</h3><p class="muted">Nem szerepel a katalógusban? Írja meg, és beszerezzük.</p></div></li>
      </ul>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <div class="cta-band">
        <div>
          <h2>Nem találja, amit keres?</h2>
          <p class="muted">Vegye fel egyedi tételként az ajánlatkérőbe – írja le, mire van szüksége, és megkeressük.</p>
        </div>
        <a href="/ajanlatkeres#egyedi" class="btn btn-primary">Egyedi tétel kérése <Icon name="ArrowRight" /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; padding: 40px 0 36px; min-height: calc(92vh - var(--header-h)); display: flex; flex-direction: column; justify-content: center; }
  .hero-bg {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(900px 520px at 72% 42%, rgba(10, 108, 255, 0.14), transparent 70%),
      linear-gradient(rgba(10, 108, 255, 0.05) 1px, transparent 1px) 0 0 / 44px 44px,
      linear-gradient(90deg, rgba(10, 108, 255, 0.05) 1px, transparent 1px) 0 0 / 44px 44px,
      linear-gradient(180deg, #f7faff 0%, #eaf2fd 100%);
  }
  .hero-inner { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr); gap: 32px; align-items: center; }
  .hero-copy h1 { margin: 16px 0 20px; color: var(--navy); }
  .hero-search {
    display: flex; align-items: center; gap: 10px; margin: 28px 0 12px; padding: 6px 6px 6px 18px; max-width: 580px;
    border: 1px solid var(--line-strong); border-radius: 999px; background: #fff; box-shadow: var(--shadow-sm);
  }
  .hero-search:focus-within { border-color: var(--accent); box-shadow: 0 0 0 4px rgba(10, 108, 255, 0.12); }
  .hero-search > :global(svg) { color: var(--muted); flex: none; }
  .hero-search input { flex: 1; min-width: 0; border: 0; background: transparent; height: 44px; font-size: 1rem; outline: none; }
  .hero-popular { display: flex; flex-wrap: wrap; gap: 8px 12px; font-size: 0.88rem; }
  .hero-popular a { color: var(--text-2); border-bottom: 1px dashed var(--line-strong); text-decoration: none; }
  .hero-popular a:hover { color: var(--accent); border-color: var(--accent); }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .hero-visual { position: relative; }
  .stats {
    display: grid; grid-template-columns: repeat(4, 1fr); margin: 36px 0 0; padding: 0;
    border: 1px solid var(--line); border-radius: var(--radius); background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(8px); box-shadow: var(--shadow-sm);
  }
  .stats div { padding: 20px 26px; border-left: 1px solid var(--line); }
  .stats div:first-child { border-left: 0; }
  .stats dt { font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .stats dd { margin: 4px 0 0; font-family: var(--font-head); font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 700; color: var(--navy); }

  .segments { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .segment { display: flex !important; gap: 22px; padding: 32px; overflow: hidden; }
  .segment::after {
    content: ''; position: absolute; right: -80px; top: -80px; width: 260px; height: 260px; border-radius: 50%;
    background: radial-gradient(circle, rgba(10, 108, 255, 0.1), transparent 70%); pointer-events: none;
  }
  .segment h2 { font-size: 1.45rem; }
  .segment-icon, .group-icon {
    flex: none; width: 60px; height: 60px; border-radius: 16px; display: grid; place-items: center; color: var(--accent);
    background: var(--accent-soft); border: 1px solid rgba(10, 108, 255, 0.18);
  }
  .link-arrow { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); font-weight: 600; }

  .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 32px; flex-wrap: wrap; }
  .section-head h2 { margin: 10px 0 0; }
  .group-card { padding: 24px; display: flex !important; flex-direction: column; }
  .group-icon { width: 48px; height: 48px; border-radius: 13px; margin-bottom: 18px; }
  .group-card h3 { font-size: 1.06rem; }
  .group-card p { font-size: 0.9rem; flex: 1; }
  .group-count { display: inline-flex; align-items: center; gap: 6px; font-size: 0.86rem; font-weight: 600; color: var(--accent); }

  .steps-section { background: var(--bg-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .steps { list-style: none; padding: 0; margin: 32px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .steps li { padding: 30px; }
  .steps li > :global(svg) { color: var(--accent); margin-bottom: 16px; }
  .step-no { position: absolute; right: 24px; top: 18px; font-family: var(--font-head); font-size: 2.6rem; font-weight: 700; color: rgba(10, 108, 255, 0.1); }

  .why { display: grid; grid-template-columns: 1fr 1.1fr; gap: 56px; align-items: start; }
  .why h2 { margin-top: 12px; }
  .benefits { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .benefits li { display: flex; gap: 14px; }
  .benefits li > :global(svg) { flex: none; color: var(--accent); margin-top: 2px; }
  .benefits h3 { margin-bottom: 4px; }
  .benefits p { font-size: 0.93rem; margin: 0; }

  .cta-band {
    display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;
    padding: 44px; border-radius: 22px; color: #fff;
    background: radial-gradient(600px 240px at 100% 0%, rgba(90, 162, 255, 0.55), transparent 70%), linear-gradient(135deg, #0b3a8c, #0a6cff);
  }
  .cta-band h2 { margin-bottom: 6px; color: #fff; }
  .cta-band p { margin: 0; color: #d7e6ff; }
  .cta-band .btn-primary { background: #fff; color: var(--accent-2); }

  @media (max-width: 960px) {
    .hero { min-height: 0; }
    .hero-inner { grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .hero-visual { order: -1; max-width: 640px; margin: 0 auto; width: 100%; }
    .segments, .why { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr; }
    .why { gap: 32px; }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 12px; }
    .stats { grid-template-columns: 1fr 1fr; }
    .stats div:nth-child(3) { border-left: 0; }
    .stats div:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .stats div { padding: 16px 18px; }
    .segment { flex-direction: column; padding: 24px; }
    .benefits { grid-template-columns: 1fr; }
    .cta-band { padding: 28px 22px; }
    .hero-search .btn { padding: 10px 16px; }
  }
</style>
