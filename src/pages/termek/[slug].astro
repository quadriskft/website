---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductVisual from '../../components/ProductVisual.astro';
import { products, getGroup, getCategory, productsIn, publicProduct, isProfile, familyOf } from '../../lib/catalog.js';
import { SITE, abs, absPage } from '../../lib/site.js';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const group = getGroup(product.group);
const category = getCategory(product.group, product.category);
// termékcsaládnál a hossz a választóból jön, a műszaki adatok között nem szerepel
const specs = Object.entries(product.specs ?? {}).filter(([k]) => !(familyOf(product.slug) && /^(hossz|szálhossz)/i.test(k)));
const gallery = product.images?.length > 1 ? product.images : [];
const related = productsIn(product.group, product.category).filter((p) => p.slug !== product.slug).slice(0, 8);
const showCategory = category && category.name !== group.name;
// termékcsalád (azonos profil több gyári hosszban): hosszválasztó, darabra rendelhető – nem méretre vágva
const family = familyOf(product.slug);
const familyMembers = family ? family.members.map((m) => ({ ...m, product: products.find((p) => p.slug === m.slug) })).filter((m) => m.product) : [];
const profile = !family && isProfile(product);
// gyári szálhossz (ha ismert) – tájékoztató a méretsorok mellé
const stockLength = profile
  ? (specs.find(([k]) => /szálhossz|gyártási hossz|^hossz/i.test(k))?.[1] ?? product.name.match(/(\d{1,2} ?\d{3})\s*mm\b(?!.*mm)/)?.[1])
  : null;
const description = product.description || `${product.name}${product.code ? ` (cikkszám: ${product.code})` : ''} – ${group.name}. Kérjen ajánlatot online a ${SITE.name}-tól.`;
const crumbs = [
  ['Főoldal', '/'], ['Termékkatalógus', '/termekek'], [group.name, `/termekek/${group.slug}`],
  ...(showCategory ? [[category.name, `/termekek/${group.slug}#${category.slug}`]] : []),
  [product.name, `/termek/${product.slug}`],
];
// látható morzsamenü: Főoldal › Termékkatalógus › Főkategória › Alkategória › termék; „Vissza” = egy szinttel feljebb
const navCrumbs = crumbs;
const backTo = showCategory
  ? { href: `/termekek/${group.slug}#${category.slug}`, label: category.name }
  : { href: `/termekek/${group.slug}`, label: group.name };
const jsonLd = [
  {
    '@type': 'Product',
    name: product.name,
    ...(product.code && { sku: product.code, mpn: product.code }),
    description,
    url: absPage(`/termek/${product.slug}`),
    category: showCategory ? `${group.name} > ${category.name}` : group.name,
    brand: { '@type': 'Brand', name: SITE.shortName },
    ...(product.images?.length && { image: product.images.map((i) => abs(i)) }),
    ...(specs.length && { additionalProperty: specs.map(([k, v]) => ({ '@type': 'PropertyValue', name: k, value: String(v) })) }),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map(([name, url], i) => ({ '@type': 'ListItem', position: i + 1, name, item: absPage(url) })),
  },
];
---
<Base crumbs={navCrumbs} back={backTo} title={product.code ? `${product.name} (${product.code})` : product.name} description={description} image={product.images?.[0]} type="product" jsonLd={jsonLd}>
  <div class="container">

    <div class="product">
      <div class="media">
        <ProductVisual product={product} eager />
        {gallery.length > 0 && (
          <div class="gallery">
            {gallery.map((src, i) => (
              <button type="button" class:list={['thumb-btn', { active: i === 0 }]} data-src={src} aria-label={`${i + 1}. kép megjelenítése`}>
                <img src={src} alt="" loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="info">
        <span class="eyebrow">{showCategory ? category.name : group.name}</span>
        <h1 class="product-title">{family ? family.name : product.name}</h1>
        {product.code && (
          <p class="code-line">{product.codeLabel ?? 'Cikkszám'}: <strong>{product.code}</strong>
            <button type="button" class="copy" data-copy={product.code} aria-label="Cikkszám másolása"><Icon name="Copy" size={15} /></button>
          </p>
        )}

        {family ? (
          <div class="order card variant-order" id="rendeles">
            <h2 class="cut-title"><Icon name="Ruler" size={20} /> Rendelhető méretek</h2>
            <p class="muted small">Gyári hosszban, darabra rendelhető – ezt a terméket nem vágjuk méretre.</p>
            <label class="variant-label" for="variant">{family.label}</label>
            <select id="variant" class="input variant-select" data-variant>
              {familyMembers.map((m) => (
                <option value={m.slug} selected={m.slug === product.slug} data-product={JSON.stringify({ ...publicProduct({ ...m.product, family: true }), name: `${family.name} – ${m.value}` })}>{m.value}</option>
              ))}
            </select>
            <div class="order-row">
              <div class="qty" data-qty>
                <button type="button" data-step="-1" aria-label="Kevesebb"><Icon name="Minus" /></button>
                <input type="number" id="qty" min="1" max="99999" value="1" inputmode="numeric" aria-label="Darab" />
                <button type="button" data-step="1" aria-label="Több"><Icon name="Plus" /></button>
              </div>
              <button type="button" class="btn btn-primary add-main" data-variant-add data-add-to-quote={JSON.stringify({ ...publicProduct({ ...product, family: true }), name: `${family.name} – ${familyMembers.find((m) => m.slug === product.slug)?.value}` })} data-qty-from="#qty">
                <Icon name="ClipboardList" /> <span class="label">Ajánlatkérőbe</span>
              </button>
            </div>
            <p class="muted small">Árat nem tüntetünk fel – tegye az ajánlatkérőbe, és személyre szabott ajánlatot küldünk mennyiség és szállítási igény alapján.</p>
          </div>
        ) : profile ? (
          <div class="order card cut-order" id="meretre" data-cut-order data-product={JSON.stringify(publicProduct(product))}>
            <h2 class="cut-title"><Icon name="Ruler" size={20} /> Kért méretek</h2>
            <p class="muted small">Adja meg, milyen hosszúságú szálakból hány darabra van szüksége – méretre vágást is vállalunk.{stockLength && <> Gyári szálhossz: <strong>{stockLength}{/\d$/.test(String(stockLength)) ? ' mm' : ''}</strong>.</>}</p>
            <div class="cut-head" aria-hidden="true"><span>Hossz [mm]</span><span>Darab</span><span></span></div>
            <div class="cut-rows" data-cut-rows></div>
            <button type="button" class="add-row" data-add-row><Icon name="Plus" size={18} /> Másik méret hozzáadása</button>
            <label class="cut-note-label" for="cut-note">Megjegyzés</label>
            <textarea id="cut-note" class="input cut-note" rows="2" maxlength="300" placeholder="pl. felületkezelés, vágási tűrés, szállítási határidő…" data-cut-note></textarea>
            <p class="cut-error" data-cut-error hidden>Adjon meg legalább egy hosszt (mm).</p>
            <div class="cut-actions">
              <span class="muted small" data-cut-total></span>
              <button type="button" class="btn btn-primary" data-add-cuts><Icon name="ClipboardList" /> <span>Ajánlatkérőbe</span></button>
            </div>
            <p class="muted small">Árat nem tüntetünk fel – személyre szabott ajánlatot küldünk mennyiség, méret és szállítási igény alapján.</p>
          </div>
        ) : (
          <div class="order card">
            <div class="order-row">
              <div class="qty" data-qty>
                <button type="button" data-step="-1" aria-label="Kevesebb"><Icon name="Minus" /></button>
                <input type="number" id="qty" min="1" max="99999" value="1" inputmode="numeric" aria-label="Mennyiség" />
                <button type="button" data-step="1" aria-label="Több"><Icon name="Plus" /></button>
              </div>
              <button type="button" class="btn btn-primary add-main" data-add-to-quote={JSON.stringify(publicProduct(product))} data-qty-from="#qty">
                <Icon name="ClipboardList" /> <span class="label">Ajánlatkérőbe</span>
              </button>
            </div>
            <p class="muted small">Árat nem tüntetünk fel – tegye az ajánlatkérőbe, és személyre szabott ajánlatot küldünk mennyiség és szállítási igény alapján.</p>
          </div>
        )}

        <ul class="assurances">
          <li><Icon name="BadgeCheck" size={18} /> Szakmai segítség a kiválasztáshoz</li>
          <li><Icon name="Boxes" size={18} /> Több tétel egy ajánlatban</li>
          {SITE.phone && <li><Icon name="Phone" size={18} /> <a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a></li>}
        </ul>
      </div>
    </div>

    {(product.description || specs.length > 0 || product.documents?.length > 0) && (
      <div class="details">
        {product.description && (
          <section class="card detail">
            <h2>Leírás</h2>
            <p>{product.description}</p>
          </section>
        )}
        {specs.length > 0 && (
          <section class="card detail">
            <h2>Műszaki adatok</h2>
            <table class="specs">
              <tbody>
                {specs.map(([key, value]) => <tr><th scope="row">{key}</th><td>{value}</td></tr>)}
              </tbody>
            </table>
          </section>
        )}
        {product.documents?.length > 0 && (
          <section class="card detail">
            <h2>Dokumentumok</h2>
            <ul class="docs">
              {product.documents.map((d) => <li><a href={d.url} target="_blank" rel="noopener"><Icon name="FileText" size={18} /> {d.title}</a></li>)}
            </ul>
          </section>
        )}
      </div>
    )}

    {related.length > 0 && (
      <section class="related">
        <div class="related-head">
          <h2>További termékek: {showCategory ? category.name : group.name}</h2>
          <a href={`/termekek/${group.slug}${showCategory ? `#${category.slug}` : ''}`} class="btn btn-ghost btn-sm">Mind <Icon name="ArrowRight" /></a>
        </div>
        <div class="grid grid-products">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </section>
    )}
  </div>
</Base>

<script>
  import { quote, clampQty, clampLen, normalizeCuts, totalPcs } from '../../scripts/quote.js';

  // termékcsalád: a választott hossz kerül az ajánlatkérőbe (a cím és az URL is követi)
  const variant = document.querySelector('[data-variant]');
  if (variant) {
    const addBtn = document.querySelector('[data-variant-add]');
    variant.addEventListener('change', () => {
      const opt = variant.selectedOptions[0];
      addBtn.dataset.addToQuote = opt.dataset.product;
      history.replaceState(null, '', `/termek/${opt.value}${location.hash}`);
      window.dispatchEvent(new CustomEvent('quote:change'));
    });
  }

  const input = document.querySelector('#qty');
  if (input) {
    document.querySelectorAll('[data-qty] [data-step]').forEach((btn) =>
      btn.addEventListener('click', () => {
        input.value = String(clampQty(Number(input.value) + Number(btn.dataset.step)));
      }),
    );
    input.addEventListener('change', () => (input.value = String(clampQty(input.value))));
  }

  // Galéria: a bélyegképre kattintva az a kép jelenik meg nagyban
  const mainImg = document.querySelector('.media .product-visual img');
  document.querySelectorAll('.gallery .thumb-btn').forEach((btn) =>
    btn.addEventListener('click', () => {
      if (!mainImg) return;
      mainImg.src = btn.dataset.src;
      document.querySelectorAll('.gallery .thumb-btn').forEach((b) => b.classList.toggle('active', b === btn));
    }),
  );

  // Profilok: hossz × darab méretsorok (mint egy vágási lista), + gombbal új sor
  const order = document.querySelector('[data-cut-order]');
  if (order) {
    const product = JSON.parse(order.dataset.product);
    const rows = order.querySelector('[data-cut-rows]');
    const note = order.querySelector('[data-cut-note]');
    const totalEl = order.querySelector('[data-cut-total]');
    const errorEl = order.querySelector('[data-cut-error]');
    const x = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';
    const addRow = (len = '', pcs = 1, focus = false) => {
      const row = document.createElement('div');
      row.className = 'cut-row';
      row.innerHTML = `<input class="input" type="number" min="1" max="30000" step="1" inputmode="numeric" placeholder="pl. 6000" aria-label="Hossz (mm)" data-len value="${len}">
        <input class="input" type="number" min="1" max="99999" step="1" inputmode="numeric" aria-label="Darab" data-pcs value="${pcs}">
        <button type="button" class="row-remove" aria-label="Sor törlése" data-remove-row>${x}</button>`;
      rows.append(row);
      if (focus) row.querySelector('[data-len]').focus();
      update();
    };
    const read = () => [...rows.querySelectorAll('.cut-row')].map((r) => ({ len: r.querySelector('[data-len]').value, pcs: r.querySelector('[data-pcs]').value }));
    const update = () => {
      const cuts = normalizeCuts(read());
      const m = cuts.reduce((n, c) => n + c.len * c.pcs, 0) / 1000;
      totalEl.textContent = cuts.length ? `Összesen ${totalPcs(cuts)} db, ${m.toLocaleString('hu-HU', { maximumFractionDigits: 2 })} fm` : '';
      rows.querySelectorAll('[data-remove-row]').forEach((b) => (b.hidden = rows.children.length < 2));
    };
    order.querySelector('[data-add-row]').addEventListener('click', () => addRow('', 1, true));
    rows.addEventListener('input', () => {
      errorEl.hidden = true;
      update();
    });
    rows.addEventListener('change', (e) => {
      if (e.target.matches('[data-pcs]')) e.target.value = String(clampQty(e.target.value));
      if (e.target.matches('[data-len]') && e.target.value) e.target.value = String(clampLen(e.target.value) || '');
      update();
    });
    rows.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-remove-row]');
      if (btn && rows.children.length > 1) {
        btn.closest('.cut-row').remove();
        update();
      }
    });
    rows.addEventListener('keydown', (e) => {
      // Enter az utolsó sorban: új sor
      if (e.key === 'Enter') {
        e.preventDefault();
        if (e.target.closest('.cut-row') === rows.lastElementChild) addRow('', 1, true);
      }
    });
    order.querySelector('[data-add-cuts]').addEventListener('click', () => {
      const cuts = normalizeCuts(read());
      if (!cuts.length) {
        errorEl.hidden = false;
        rows.querySelector('[data-len]')?.focus();
        return;
      }
      quote.addCuts(product, cuts, note.value);
      rows.innerHTML = '';
      note.value = '';
      addRow();
      window.dispatchEvent(new CustomEvent('quote:toast', { detail: `Hozzáadva az ajánlatkérőhöz: ${product.name} (${totalPcs(cuts)} db)` }));
    });
    addRow();
  }

  document.querySelectorAll('[data-copy]').forEach((btn) =>
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy);
        btn.classList.add('done');
        setTimeout(() => btn.classList.remove('done'), 1500);
      } catch {}
    }),
  );
</script>

<style>
  .product { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 48px; align-items: start; padding-top: 28px; }
  .media { position: sticky; top: calc(var(--header-h) + 20px); }
  /* fémes keret a termékképen */
  .media :global(.product-visual) {
    border-radius: var(--radius); border: 3px solid transparent;
    background: linear-gradient(#fff, #fff) padding-box, var(--metal-frame) border-box; box-shadow: var(--shadow-sm), var(--metal-bevel);
  }
  .media :global(.product-visual.placeholder svg) { width: 26%; height: 26%; }
  .gallery { display: flex; gap: 10px; margin-top: 12px; flex-wrap: wrap; }
  .thumb-btn { padding: 0; border: 2px solid transparent; border-radius: 10px; background: none; cursor: pointer; transition: border-color 0.2s; }
  .thumb-btn:hover { border-color: rgba(10, 108, 255, 0.4); }
  .thumb-btn.active { border-color: var(--accent); }
  .gallery img { display: block; width: 88px; height: 66px; object-fit: contain; background: #fff; border-radius: 8px; padding: 4px; }
  .info h1 { font-size: clamp(1.7rem, 3.2vw, 2.5rem); margin: 12px 0 12px; }
  .code-line { display: flex; align-items: center; gap: 8px; color: var(--text-2); }
  .copy { border: 1px solid var(--line); background: transparent; border-radius: 8px; width: 30px; height: 30px; display: grid; place-items: center; cursor: pointer; color: var(--muted); }
  .copy:hover { color: var(--accent); border-color: var(--accent); }
  .copy:global(.done) { color: var(--ok); border-color: var(--ok); }
  .order { padding: 22px; margin: 26px 0 20px; }
  .cut-title { display: flex; align-items: center; gap: 8px; font-size: 1.08rem; margin: 0 0 6px; }
  .cut-title :global(svg) { color: var(--accent); }
  .cut-head, .cut-order :global(.cut-row) { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) 36px; gap: 10px; align-items: center; }
  .cut-head { margin: 16px 0 6px; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }
  .cut-rows { display: grid; gap: 8px; }
  .cut-order :global(.cut-row .input) { width: 100%; padding: 10px 12px; }
  .cut-order :global(.row-remove) { width: 36px; height: 36px; border-radius: 10px; border: 1px solid var(--line); background: transparent; color: var(--muted); display: grid; place-items: center; cursor: pointer; }
  .cut-order :global(.row-remove:hover) { color: #d63a3a; border-color: #d63a3a; }
  .add-row { margin-top: 10px; display: inline-flex; align-items: center; gap: 6px; border: 1px dashed var(--accent); color: var(--accent); background: var(--accent-soft); border-radius: 10px; padding: 8px 14px; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer; }
  .add-row:hover { background: rgba(10, 108, 255, 0.14); }
  .cut-note-label { display: block; margin: 16px 0 6px; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }
  .cut-note { width: 100%; resize: vertical; min-height: 64px; }
  .cut-error { color: #d63a3a; font-size: 0.88rem; margin: 8px 0 0; }
  .cut-actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin: 16px 0 10px; }
  .order-row { display: flex; gap: 12px; flex-wrap: wrap; }
  .variant-order { display: grid; gap: 10px; }
  .variant-label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .variant-select { font-size: 1rem; padding: 12px 14px; }
  .add-main { flex: 1; min-width: 200px; }
  .add-main:global(.in-quote) { background: linear-gradient(135deg, #17b978, #0e8a58); }
  .small { font-size: 0.86rem; margin: 14px 0 0; }
  .assurances { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; color: var(--text-2); font-size: 0.93rem; }
  .assurances li { display: flex; align-items: center; gap: 10px; }
  .assurances :global(svg) { color: var(--accent); }
  .details { display: grid; gap: 20px; margin-top: 48px; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }
  .detail { padding: 26px; }
  .detail h2 { font-size: 1.2rem; }
  .specs { width: 100%; border-collapse: collapse; }
  .specs th, .specs td { text-align: left; padding: 10px 0; border-bottom: 1px solid var(--line); vertical-align: top; font-size: 0.94rem; }
  .specs th { width: 45%; color: var(--muted); font-weight: 500; padding-right: 16px; }
  .docs { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .docs a { display: inline-flex; gap: 8px; align-items: center; }
  .related { margin-top: 64px; }
  .related-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 20px; }
  .related-head h2 { font-size: 1.4rem; margin: 0; }
  @media (max-width: 860px) {
    .product { grid-template-columns: 1fr; gap: 24px; }
    .media { position: static; }
  }
</style>
