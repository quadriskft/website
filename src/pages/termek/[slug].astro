---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductVisual from '../../components/ProductVisual.astro';
import { products, getGroup, getCategory, productsIn, publicProduct, isProfile, familyOf } from '../../lib/catalog.js';
import { SITE, abs, absPage } from '../../lib/site.js';
import orderForms from '../../../data/rendelesi_adatlapok.json';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const group = getGroup(product.group);
const category = getCategory(product.group, product.category);
// termékcsaládnál a hossz a választóból jön, a műszaki adatok között nem szerepel
const specs = Object.entries(product.specs ?? {}).filter(([k]) => !(familyOf(product.slug) && /^(hossz|szálhossz|gyári hossz)/i.test(k)));
const gallery = product.images?.length > 1 ? product.images : [];
// folyamatosan ismétlődő, hang nélküli diavetítés-videó (pl. gyártói képek „videószerűen”): a fő kép helyén
const heroVideo = product.videos?.find((v) => v.loop);
// rendelési adatlap (konfigurátor, data/rendelesi_adatlapok.json)
const orderForm = orderForms[product.slug];
const videos = (product.videos ?? []).filter((v) => v !== heroVideo);
const related = productsIn(product.group, product.category).filter((p) => p.slug !== product.slug).slice(0, 8);
const showCategory = category && category.name !== group.name;
// termékcsalád (azonos profil több gyári hosszban): hosszválasztó, darabra rendelhető – nem méretre vágva
const family = familyOf(product.slug);
const familyMembers = family ? family.members.map((m) => ({ ...m, product: products.find((p) => p.slug === m.slug) })).filter((m) => m.product) : [];
const profile = !family && isProfile(product);
// sok oszlopos típustáblázat / rendelési adatlap: kisebb fő kép, szélesebb rendelési rész (a „Kiválaszt” is látszik)
const wideOrder = (family?.table?.length ?? 0) >= 4 || !!orderForm;
// gyári szálhossz (ha ismert) – tájékoztató a méretsorok mellé
const stockLength = profile
  ? (specs.find(([k]) => /szálhossz|gyártási hossz|^hossz/i.test(k))?.[1] ?? product.name.match(/(\d{1,2} ?\d{3})\s*mm\b(?!.*mm)/)?.[1])
  : null;
const description = product.description || `${product.name}${product.code ? ` (cikkszám: ${product.code})` : ''} – ${group.name}. Kérjen ajánlatot online a ${SITE.name}-tól.`;
const crumbs = [
  ['Főoldal', '/'], ['Termékkatalógus', '/termekek'], [group.name, `/termekek/${group.slug}`],
  ...(showCategory ? [[category.name, `/termekek/${group.slug}#${category.slug}`]] : []),
  [product.name, `/termek/${product.slug}`],
];
// látható morzsamenü: Főoldal › Termékkatalógus › Főkategória › Alkategória › termék; „Vissza” = egy szinttel feljebb
const navCrumbs = crumbs;
const backTo = showCategory
  ? { href: `/termekek/${group.slug}#${category.slug}`, label: category.name }
  : { href: `/termekek/${group.slug}`, label: group.name };
const jsonLd = [
  {
    '@type': 'Product',
    name: product.name,
    ...(product.code && { sku: product.code, mpn: product.code }),
    description,
    url: absPage(`/termek/${product.slug}`),
    category: showCategory ? `${group.name} > ${category.name}` : group.name,
    brand: { '@type': 'Brand', name: SITE.shortName },
    ...(product.images?.length && { image: product.images.map((i) => abs(i)) }),
    ...(specs.length && { additionalProperty: specs.map(([k, v]) => ({ '@type': 'PropertyValue', name: k, value: String(v) })) }),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map(([name, url], i) => ({ '@type': 'ListItem', position: i + 1, name, item: absPage(url) })),
  },
];
---
<Base crumbs={navCrumbs} back={backTo} title={product.code ? `${product.name} (${product.code})` : product.name} description={description} image={product.images?.[0]} type="product" jsonLd={jsonLd}>
  <div class="container">

    <div class:list={['product', { 'wide-order': wideOrder }]}>
      <div class="media">
        {heroVideo
          ? <div class="hero-video"><video autoplay muted loop playsinline preload="auto" poster={heroVideo.poster} src={heroVideo.url} aria-label={heroVideo.title}></video></div>
          : <ProductVisual product={product} eager />}
        {gallery.length > 0 && (
          <div class="gallery">
            {gallery.map((src, i) => (
              <button type="button" class:list={['thumb-btn', { active: i === 0 }]} data-src={src} aria-label={`${i + 1}. kép megjelenítése`}>
                <img src={src} alt="" loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="info">
        <span class="eyebrow">{showCategory ? category.name : group.name}</span>
        <h1 class="product-title">{family ? family.name : product.name}</h1>
        {product.stock && <p class="stock-line"><Icon name="BadgeCheck" size={18} /> Raktárról rendelhető</p>}
        {product.code && (
          <p class="code-line">{product.codeLabel ?? 'Cikkszám'}: <strong>{product.code}</strong>
            <button type="button" class="copy" data-copy={product.code} aria-label="Cikkszám másolása"><Icon name="Copy" size={15} /></button>
          </p>
        )}

        {family ? (
          <div class="order card variant-order" id="rendeles">
            <h2 class="cut-title"><Icon name="Ruler" size={20} /> {family.title ?? 'Rendelhető méretek'}</h2>
            <p class="muted small">{family.note ?? 'Gyári hosszban, darabra rendelhető – ezt a terméket nem vágjuk méretre.'}</p>
            {family.table && (
              <div class="variant-table-wrap"><table class="variant-table">
                <thead><tr>{family.table.map((k) => <th scope="col">{k}</th>)}<th></th></tr></thead>
                <tbody>
                  {familyMembers.map((m) => (
                    <tr class:list={[{ current: m.slug === product.slug }]}>
                      {family.rows?.[m.slug]
                        ? family.rows[m.slug].map((c) => <td>{c}</td>)
                        : family.table.map((k) => <td>{m.product.specs?.[k] ?? (k === family.label ? m.value : '–')}</td>)}
                      <td>{m.slug === product.slug ? <span class="muted">kiválasztva</span> : <a href={`/termek/${m.slug}#rendeles`}>Kiválaszt</a>}</td>
                    </tr>
                  ))}
                </tbody>
              </table></div>
            )}
            <label class="variant-label" for="variant">{family.label}</label>
            <select id="variant" class="input variant-select" data-variant data-variant-navigate={family.navigate ? '' : undefined}>
              {familyMembers.map((m) => (
                <option value={m.slug} selected={m.slug === product.slug} data-product={JSON.stringify({ ...publicProduct({ ...m.product, family: true }), name: `${family.name} – ${m.value}` })}>{m.value}</option>
              ))}
            </select>
            {family.input && (
              <div class="note-field" data-note-field>
                <label class="variant-label" for="kert-meret">{family.input.label}</label>
                <input id="kert-meret" class="input" type="number" min="1" max="99999" step="1" inputmode="numeric" placeholder={family.input.placeholder}
                  data-note-prefix={family.input.prefix} data-note-suffix={family.input.suffix} />
                <p class="field-error">Adja meg a kért méretet.</p>
              </div>
            )}
            {family.lengths ? (
              <div class="cut-order family-lengths" data-cut-order
                data-product={JSON.stringify({ ...publicProduct({ ...product, family: true }), name: `${family.name} – ${familyMembers.find((m) => m.slug === product.slug)?.value}` })}
                data-lengths={family.lengths.options ? JSON.stringify(family.lengths.options) : undefined}
                data-min={family.lengths.min} data-max={family.lengths.max}>
                <p class="variant-label lengths-title">Rendelt hosszak és darabszámok</p>
                <p class="muted small lengths-hint">{family.lengths.hint}</p>
                <div class="cut-head" aria-hidden="true"><span>Hossz [mm]</span><span>Darab</span><span></span></div>
                <div class="cut-rows" data-cut-rows></div>
                <button type="button" class="add-row" data-add-row><Icon name="Plus" size={18} /> Másik hossz hozzáadása</button>
                <label class="cut-note-label" for="cut-note">Megjegyzés</label>
                <textarea id="cut-note" class="input cut-note" rows="2" maxlength="300" placeholder="pl. felületkezelés, szállítási határidő…" data-cut-note></textarea>
                <p class="cut-error" data-cut-error hidden>{family.lengths.options ? 'Válasszon hosszt és adja meg a darabszámot.' : `Adjon meg legalább egy hosszt (${family.lengths.min}–${family.lengths.max} mm).`}</p>
                <div class="cut-actions">
                  <span class="muted small" data-cut-total></span>
                  <button type="button" class="btn btn-primary" data-add-cuts><Icon name="ClipboardList" /> <span>Ajánlatkérőbe</span></button>
                </div>
              </div>
            ) : (
            <div class="order-row">
                <div class="qty" data-qty>
                  <button type="button" data-step="-1" aria-label="Kevesebb"><Icon name="Minus" /></button>
                  <input type="number" id="qty" min="1" max="99999" value="1" inputmode="numeric" aria-label="Darab" />
                  <button type="button" data-step="1" aria-label="Több"><Icon name="Plus" /></button>
                </div>
                {product.unit && <span class="qty-unit">{product.unit}</span>}
                <button type="button" class="btn btn-primary add-main" data-variant-add data-add-to-quote={JSON.stringify({ ...publicProduct({ ...product, family: true }), name: `${family.name} – ${familyMembers.find((m) => m.slug === product.slug)?.value}` })} data-qty-from="#qty" data-note-from={family.input ? '#kert-meret' : undefined}>
                  <Icon name="ClipboardList" /> <span class="label">Ajánlatkérőbe</span>
                </button>
              </div>
            )}
            {product.orderNote && <p class="order-note"><Icon name="Ruler" size={16} /> {product.orderNote}</p>}
            <p class="muted small">Árat nem tüntetünk fel – tegye az ajánlatkérőbe, és személyre szabott ajánlatot küldünk mennyiség és szállítási igény alapján.</p>
          </div>
        ) : profile ? (
          <div class="order card cut-order" id="meretre" data-cut-order data-product={JSON.stringify(publicProduct(product))}>
            <h2 class="cut-title"><Icon name="Ruler" size={20} /> Kért méretek</h2>
            <p class="muted small">Adja meg, milyen hosszúságú szálakból hány darabra van szüksége – méretre vágást is vállalunk.{stockLength && <> Gyári szálhossz: <strong>{stockLength}{/\d$/.test(String(stockLength)) ? ' mm' : ''}</strong>.</>}</p>
            <div class="cut-head" aria-hidden="true"><span>Hossz [mm]</span><span>Darab</span><span></span></div>
            <div class="cut-rows" data-cut-rows></div>
            <button type="button" class="add-row" data-add-row><Icon name="Plus" size={18} /> Másik méret hozzáadása</button>
            <label class="cut-note-label" for="cut-note">Megjegyzés</label>
            <textarea id="cut-note" class="input cut-note" rows="2" maxlength="300" placeholder="pl. felületkezelés, vágási tűrés, szállítási határidő…" data-cut-note></textarea>
            <p class="cut-error" data-cut-error hidden>Adjon meg legalább egy hosszt (mm).</p>
            <div class="cut-actions">
              <span class="muted small" data-cut-total></span>
              <button type="button" class="btn btn-primary" data-add-cuts><Icon name="ClipboardList" /> <span>Ajánlatkérőbe</span></button>
            </div>
            <p class="muted small">Árat nem tüntetünk fel – személyre szabott ajánlatot küldünk mennyiség, méret és szállítási igény alapján.</p>
          </div>
        ) : orderForm ? (
          <form class="order card config-order" id="rendeles" data-config-form data-product={JSON.stringify(publicProduct(product))} novalidate>
            <h2 class="cut-title"><Icon name="ClipboardList" size={20} /> {orderForm.title}</h2>
            <p class="muted small">{orderForm.intro}</p>
            <div class="config-grid">
              {orderForm.fields.map((f) => (
                <div class="config-field" data-field={f.id} data-label={f.label} data-unit={f.unit} data-required={f.required ? '' : undefined}>
                  <label for={`cf-${f.id}`}>{f.label}{f.required && ' *'}{f.unit && <span class="muted"> [{f.unit}]</span>}</label>
                  {f.type === 'select' ? (
                    <select id={`cf-${f.id}`} class="input" data-value>
                      {f.required && <option value="">– válasszon –</option>}
                      {f.options.map((o) => <option value={o}>{o}</option>)}
                      {f.egyeb && <option value="__egyeb">Egyéb…</option>}
                    </select>
                  ) : (
                    <input id={`cf-${f.id}`} class="input" data-value type={f.type === 'number' ? 'number' : 'text'} min={f.min} max={f.max}
                      inputmode={f.type === 'number' ? 'numeric' : undefined} placeholder={f.placeholder} maxlength="80" />
                  )}
                  {f.egyeb && <input class="input config-other" data-other type={f.egyebUnit ? 'number' : 'text'} min={f.egyebMin} max={f.egyebMax} data-unit={f.egyebUnit}
                    inputmode={f.egyebUnit ? 'numeric' : undefined} maxlength="80" placeholder={f.egyebUnit ? `Méret (${f.egyebUnit})` : 'Adja meg'} hidden />}
                  {f.hint && <small class="muted">{f.hint}</small>}
                </div>
              ))}
            </div>
            <label class="cut-note-label" for="cf-note">Megjegyzés</label>
            <textarea id="cf-note" class="input cut-note" rows="2" maxlength="300" placeholder="Egyéb kérés, eltérés a fentiektől…" data-config-note></textarea>
            <p class="cut-error" data-config-error hidden>Töltse ki a *-gal jelölt mezőket.</p>
            <div class="order-row">
              <div class="qty" data-qty>
                <button type="button" data-step="-1" aria-label="Kevesebb"><Icon name="Minus" /></button>
                <input type="number" id="qty" min="1" max="99999" value="1" inputmode="numeric" aria-label="Darab (ajtó)" />
                <button type="button" data-step="1" aria-label="Több"><Icon name="Plus" /></button>
              </div>
              <button type="submit" class="btn btn-primary add-main"><Icon name="ClipboardList" /> <span class="label">Ajánlatkérőbe</span></button>
            </div>
            <p class="muted small">Árat nem tüntetünk fel – a megadott adatok alapján személyre szabott ajánlatot küldünk.</p>
          </form>
        ) : (
          <div class="order card">
            <div class="order-row">
              <div class="qty" data-qty>
                <button type="button" data-step="-1" aria-label="Kevesebb"><Icon name="Minus" /></button>
                <input type="number" id="qty" min="1" max="99999" value="1" inputmode="numeric" aria-label={product.unit ? `Mennyiség (${product.unit})` : 'Mennyiség'} />
                <button type="button" data-step="1" aria-label="Több"><Icon name="Plus" /></button>
              </div>
              {product.unit && <span class="qty-unit">{product.unit}</span>}
              <button type="button" class="btn btn-primary add-main" data-add-to-quote={JSON.stringify(publicProduct(product))} data-qty-from="#qty">
                <Icon name="ClipboardList" /> <span class="label">Ajánlatkérőbe</span>
              </button>
            </div>
            {product.orderNote && <p class="order-note"><Icon name="Ruler" size={16} /> {product.orderNote}</p>}
            <p class="muted small">Árat nem tüntetünk fel – tegye az ajánlatkérőbe, és személyre szabott ajánlatot küldünk mennyiség és szállítási igény alapján.</p>
          </div>
        )}

        <ul class="assurances">
          <li><Icon name="BadgeCheck" size={18} /> Szakmai segítség a kiválasztáshoz</li>
          <li><Icon name="Boxes" size={18} /> Több tétel egy ajánlatban</li>
          {SITE.phone && <li><Icon name="Phone" size={18} /> <a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a></li>}
        </ul>
      </div>
    </div>

    {(product.description || specs.length > 0 || product.documents?.length > 0 || videos.length > 0) && (
      <div class="details">
        {product.description && (
          <section class="card detail">
            <h2>Leírás</h2>
            <p>{product.description}</p>
          </section>
        )}
        {specs.length > 0 && (
          <section class="card detail">
            <h2>Műszaki adatok</h2>
            <table class="specs">
              <tbody>
                {specs.map(([key, value]) => <tr><th scope="row">{key}</th><td>{value}</td></tr>)}
              </tbody>
            </table>
          </section>
        )}
        {videos.length > 0 && (
          <section class="card detail">
            <h2>Videó</h2>
            {videos.map((v) => (
              <figure class="video">
                {v.loop
                  ? <video autoplay muted loop playsinline preload="metadata" poster={v.poster} src={v.url} aria-label={v.title}></video>
                  : <video controls preload="none" playsinline poster={v.poster} src={v.url} aria-label={v.title}></video>}
                <figcaption class="muted small">{v.title}</figcaption>
              </figure>
            ))}
          </section>
        )}
        {product.documents?.length > 0 && (
          <section class="card detail">
            <h2>Dokumentumok</h2>
            <ul class="docs">
              {product.documents.map((d) => <li><a href={d.url} target="_blank" rel="noopener"><Icon name="FileText" size={18} /> {d.title}</a></li>)}
            </ul>
          </section>
        )}
      </div>
    )}

    {related.length > 0 && (
      <section class="related">
        <div class="related-head">
          <h2>További termékek: {showCategory ? category.name : group.name}</h2>
          <a href={`/termekek/${group.slug}${showCategory ? `#${category.slug}` : ''}`} class="btn btn-ghost btn-sm">Mind <Icon name="ArrowRight" /></a>
        </div>
        <div class="grid grid-products">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </section>
    )}
  </div>
</Base>

<script>
  import { quote, clampQty, clampLen, normalizeCuts, totalPcs } from '../../scripts/quote.js';

  // rendelési adatlap: a kitöltött adatok (config) külön ajánlatkérő-tételként – több eltérő ajtó is kérhető
  const cform = document.querySelector('[data-config-form]');
  if (cform) {
    cform.querySelectorAll('select[data-value]').forEach((sel) =>
      sel.addEventListener('change', () => {
        const other = sel.parentElement.querySelector('[data-other]');
        if (other) other.hidden = sel.value !== '__egyeb';
      }),
    );
    cform.addEventListener('submit', (e) => {
      e.preventDefault();
      const config = [];
      let bad = null;
      cform.querySelectorAll('[data-field]').forEach((f) => {
        const input = f.querySelector('[data-value]');
        let el = input;
        let v = input.value.trim();
        if (v === '__egyeb') {
          el = f.querySelector('[data-other]');
          v = el.value.trim();
        }
        const num = el.type === 'number';
        const unit = el.dataset.unit ?? f.dataset.unit;
        const invalid = ('required' in f.dataset && !v) || (num && v && (!(Number(v) > 0) || (el.min && Number(v) < Number(el.min)) || (el.max && Number(v) > Number(el.max))));
        f.classList.toggle('invalid', !!invalid);
        if (invalid && !bad) bad = el;
        if (v) config.push({ label: f.dataset.label, value: num && unit ? `${v} ${unit}` : v });
      });
      cform.querySelector('[data-config-error]').hidden = !bad;
      if (bad) {
        bad.focus();
        return;
      }
      const base = JSON.parse(cform.dataset.product);
      const note = cform.querySelector('[data-config-note]').value.trim();
      const height = config.find((c) => /magasság/i.test(c.label))?.value;
      const width = config.find((c) => /szélesség/i.test(c.label))?.value;
      quote.add({ ...base, slug: `${base.slug}~${Date.now()}`, page: base.slug, config,
        name: `${base.name}${height || width ? ` – ${[width && `szél. ${width}`, height && `belső mag. ${height}`].filter(Boolean).join(', ')}` : ''}` },
        Number(document.querySelector('#qty').value) || 1, note);
      window.dispatchEvent(new CustomEvent('quote:toast', { detail: `Hozzáadva az ajánlatkérőhöz: ${base.name}` }));
    });
  }

  // termékcsalád: a választott hossz kerül az ajánlatkérőbe (a cím és az URL is követi)
  const variant = document.querySelector('[data-variant]');
  if (variant) {
    const addBtn = document.querySelector('[data-variant-add]');
    variant.addEventListener('change', () => {
      const opt = variant.selectedOptions[0];
      // kivitelenként saját képek (pl. bal / jobb): a választott kivitel oldala töltődik be
      if ('variantNavigate' in variant.dataset) {
        location.href = `/termek/${opt.value}#rendeles`;
        return;
      }
      addBtn.dataset.addToQuote = opt.dataset.product;
      history.replaceState(null, '', `/termek/${opt.value}${location.hash}`);
      window.dispatchEvent(new CustomEvent('quote:change'));
    });
  }

  const input = document.querySelector('#qty');
  if (input) {
    document.querySelectorAll('[data-qty] [data-step]').forEach((btn) =>
      btn.addEventListener('click', () => {
        input.value = String(clampQty(Number(input.value) + Number(btn.dataset.step)));
      }),
    );
    input.addEventListener('change', () => (input.value = String(clampQty(input.value))));
  }

  // Galéria: a bélyegképre kattintva az a kép jelenik meg nagyban
  const mainImg = document.querySelector('.media .product-visual img');
  document.querySelectorAll('.gallery .thumb-btn').forEach((btn) =>
    btn.addEventListener('click', () => {
      if (!mainImg) return;
      mainImg.src = btn.dataset.src;
      document.querySelectorAll('.gallery .thumb-btn').forEach((b) => b.classList.toggle('active', b === btn));
    }),
  );

  // Profilok: hossz × darab méretsorok (mint egy vágási lista), + gombbal új sor
  const order = document.querySelector('[data-cut-order]');
  if (order) {
    const product = JSON.parse(order.dataset.product);
    // termékcsalád gyártói hosszakkal (választólista) vagy hossztartománnyal (pl. acél oldalfalak)
    const options = order.dataset.lengths ? JSON.parse(order.dataset.lengths) : null;
    const minLen = Number(order.dataset.min) || 1;
    const maxLen = Number(order.dataset.max) || 30000;
    const rows = order.querySelector('[data-cut-rows]');
    const note = order.querySelector('[data-cut-note]');
    const totalEl = order.querySelector('[data-cut-total]');
    const errorEl = order.querySelector('[data-cut-error]');
    const x = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';
    const addRow = (len = '', pcs = 1, focus = false) => {
      const row = document.createElement('div');
      row.className = 'cut-row';
      const lenField = options
        ? `<select class="input" aria-label="Hossz (mm)" data-len><option value="">– hossz –</option>${options.map((o) => `<option value="${o}"${String(o) === String(len) ? ' selected' : ''}>${o} mm</option>`).join('')}</select>`
        : `<input class="input" type="number" min="${minLen}" max="${maxLen}" step="1" inputmode="numeric" placeholder="pl. 6000" aria-label="Hossz (mm)" data-len value="${len}">`;
      row.innerHTML = `${lenField}
        <input class="input" type="number" min="1" max="99999" step="1" inputmode="numeric" aria-label="Darab" data-pcs value="${pcs}">
        <button type="button" class="row-remove" aria-label="Sor törlése" data-remove-row>${x}</button>`;
      rows.append(row);
      if (focus) row.querySelector('[data-len]').focus();
      update();
    };
    const read = () => [...rows.querySelectorAll('.cut-row')].map((r) => ({ len: r.querySelector('[data-len]').value, pcs: r.querySelector('[data-pcs]').value }));
    const update = () => {
      const cuts = normalizeCuts(read());
      const m = cuts.reduce((n, c) => n + c.len * c.pcs, 0) / 1000;
      totalEl.textContent = cuts.length ? `Összesen ${totalPcs(cuts)} db, ${m.toLocaleString('hu-HU', { maximumFractionDigits: 2 })} fm` : '';
      rows.querySelectorAll('[data-remove-row]').forEach((b) => (b.hidden = rows.children.length < 2));
    };
    order.querySelector('[data-add-row]').addEventListener('click', () => addRow('', 1, true));
    rows.addEventListener('input', () => {
      errorEl.hidden = true;
      update();
    });
    rows.addEventListener('change', (e) => {
      if (e.target.matches('[data-pcs]')) e.target.value = String(clampQty(e.target.value));
      if (e.target.matches('[data-len]') && e.target.value) e.target.value = String(clampLen(e.target.value) || '');
      update();
    });
    rows.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-remove-row]');
      if (btn && rows.children.length > 1) {
        btn.closest('.cut-row').remove();
        update();
      }
    });
    rows.addEventListener('keydown', (e) => {
      // Enter az utolsó sorban: új sor
      if (e.key === 'Enter') {
        e.preventDefault();
        if (e.target.closest('.cut-row') === rows.lastElementChild) addRow('', 1, true);
      }
    });
    order.querySelector('[data-add-cuts]').addEventListener('click', () => {
      const cuts = normalizeCuts(read());
      if (!cuts.length || cuts.some((c) => c.len < minLen || c.len > maxLen)) {
        errorEl.hidden = false;
        rows.querySelector('[data-len]')?.focus();
        return;
      }
      quote.addCuts(product, cuts, note.value);
      rows.innerHTML = '';
      note.value = '';
      addRow();
      window.dispatchEvent(new CustomEvent('quote:toast', { detail: `Hozzáadva az ajánlatkérőhöz: ${product.name} (${totalPcs(cuts)} db)` }));
    });
    addRow();
  }

  document.querySelectorAll('[data-copy]').forEach((btn) =>
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy);
        btn.classList.add('done');
        setTimeout(() => btn.classList.remove('done'), 1500);
      } catch {}
    }),
  );
</script>

